         return _read_json(self.state / "phase-gate-state.json")
 
     def read_channels(self) -> dict:
-        return _read_json(self.state / "channel-status.json")
+        d = _read_json(self.state / "channel-status.json")
+        # P1 راست‌گویی (2026-07-15): این snapshot نویسندهٔ زنده ندارد — متادیتای تازگی همیشه
+        # ضمیمه می‌شود تا هیچ خواننده‌ای آن را «زنده» رندر نکند (کلیدهای additive، خواننده‌ها .get).
+        try:
+            import os as _os, time as _t
