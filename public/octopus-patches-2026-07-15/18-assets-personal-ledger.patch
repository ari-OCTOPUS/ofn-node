+#!/usr/bin/env python3
+"""personal_ledger.py — دفترِ شخصی/مشترکِ من+همکار (propose-only، 2026-07-16).
+
+رصد + پیشنهادِ تسویه، هرگز حرکتِ مالی. حسابِ سه‌طرفه (me/coworker/joint) را می‌خواند و
+«کی به کی چقدر بدهکار است» را حساب می‌کند → یک پیشنهادِ تسویه که مالک دستی تأیید/انجام
+می‌کند. اختاپوس هرگز پول جابه‌جا نمی‌کند و رمزِ بانک وارد نمی‌کند.
+
+مرزِ PII (سخت): مقادیرِ تک‌تکِ تراکنش‌ها هرگز برگردانده/echo نمی‌شوند — فقط ترازِ خلاصه
+(سهمِ هرکس از مشترک + خالصِ بدهی، گِرد به ۲ رقم). دادهٔ همکار شخصِ ثالثِ بارضایت است
+(CONSENT.md). فایلِ واقعیِ ledger.json در gitignore + محلی.
+
+منبع: 03 - Projects/Accounting/personal/ledger.json (نبود → propose «قالب را پر کن»).
+$0 · stdlib + opslib · fail-soft.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(_HERE.parent / "budget"))
+import opslib  # noqa: E402
+
+
+def _ledger_path() -> Path:
+    """مسیرِ دفترِ واقعی (نه example). از ORG_ROOT تا تستِ ایزوله کار کند."""
+    return (opslib.ORG_ROOT / "03 - Projects" / "Accounting" / "personal" / "ledger.json")
+
+
+def _load(path: Path | None = None) -> dict | None:
+    p = path or _ledger_path()
+    try:
+        d = json.loads(p.read_text("utf-8")) if p.exists() else None
+        return d if isinstance(d, dict) else None
+    except (OSError, ValueError):
+        return None
+
+
+def _num(x) -> float:
+    try:
+        return float(x)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def compute(ledger: dict) -> dict:
+    """ترازِ سه‌طرفه از entries. خروجی فقط تراز/سهم/خالص — نه هیچ تراکنشِ منفرد.
+
+    منطق: برای هر entryِ joint، هزینه بینِ me/coworker طبقِ split تقسیم می‌شود؛ هرکس که
+    paid_by بوده کل را پرداخته، پس طرفِ مقابل سهمش را بدهکار است. جمعِ خالص = کی به کی.
+    entryهای me/coworker (شخصی) فقط در جمعِ شخصی می‌آیند، در تسویهٔ مشترک نه.
+    """
+    entries = ledger.get("entries") or []
+    dflt = ledger.get("default_split") or {"me": 50, "coworker": 50}
+    joint_total = 0.0
+    personal = {"me": 0.0, "coworker": 0.0}
+    # net_owed_to_me مثبت = همکار به من بدهکار؛ منفی = من به همکار
+    net_owed_to_me = 0.0
+    n_joint = n_personal = 0
+    for e in entries:
+        if not isinstance(e, dict):
+            continue
+        amt = _num(e.get("amount"))
+        owner = str(e.get("owner", "")).lower()
+        if owner == "joint":
+            n_joint += 1
+            joint_total += amt
+            split = e.get("split") or dflt
+            my_share = amt * _num(split.get("me", 50)) / 100.0
+            co_share = amt * _num(split.get("coworker", 50)) / 100.0
+            payer = str(e.get("paid_by", "me")).lower()
+            if payer == "me":
+                # من کل را دادم؛ همکار سهمش را به من بدهکار
+                net_owed_to_me += co_share
+            elif payer == "coworker":
+                net_owed_to_me -= my_share
+        elif owner in ("me", "coworker"):
+            n_personal += 1
+            personal[owner] = personal.get(owner, 0.0) + amt
+    net = round(net_owed_to_me, 2)
+    return {
+        "joint_total": round(joint_total, 2),
+        "my_personal_total": round(personal.get("me", 0.0), 2),
+        "coworker_personal_total": round(personal.get("coworker", 0.0), 2),
+        "net_owed_to_me": net,          # مثبت = همکار به من؛ منفی = من به همکار
+        "n_joint": n_joint, "n_personal": n_personal,
+        "currency": ledger.get("currency", "AUD"),
+    }
+
+
+def settlement_proposal(bal: dict) -> str:
+    """پیشنهادِ تسویه (فارسی، خلاصه — نه دستور). مالک دستی انجام می‌دهد."""
+    net = bal.get("net_owed_to_me", 0.0)
+    cur = bal.get("currency", "AUD")
+    if abs(net) < 0.01:
+        return "حسابِ مشترک تسویه است — کسی به کسی بدهکار نیست."
+    if net > 0:
+        return (f"پیشنهاد (تأییدِ خودت لازم): همکار حدودِ {net:.2f} {cur} به تو بدهکار است. "
+                f"وقتی تسویه شد، دستی در دفتر ثبت کن. اختاپوس پول جابه‌جا نمی‌کند.")
+    return (f"پیشنهاد (تأییدِ خودت لازم): تو حدودِ {abs(net):.2f} {cur} به همکار بدهکاری. "
+            f"اختاپوس فقط یادآوری می‌کند؛ پرداخت دستِ خودت.")
+
+
+def personal_status(path: Path | None = None) -> dict:
+    """وضعیتِ propose-only برای کابین/بیت. قراردادِ status پاها: {leg, live, signal, note}.
+    نبودِ ledger.json → live=False + پیشنهادِ «قالب را پر کن». هرگز مقدارِ تراکنشِ منفرد."""
+    d = _load(path)
+    if d is None:
+        return {"leg": "personal-ledger", "live": False, "signal": "ledger نیست",
+                "note": "ledger.json پیدا نشد — از ledger.example.json کپی و پر کن (propose-only)."}
+    bal = compute(d)
+    return {
+        "leg": "personal-ledger", "live": True,
+        "signal": f"entries={bal['n_joint']+bal['n_personal']}",
+        "balance": bal,                      # فقط تراز/سهم/خالص — نه تراکنشِ منفرد
+        "proposal": settlement_proposal(bal),
+        "note": "رصد + پیشنهادِ تسویه؛ اختاپوس هرگز پول جابه‌جا نمی‌کند (CONSENT.md).",
+    }
+
+
+if __name__ == "__main__":
+    print(json.dumps(personal_status(), ensure_ascii=False, indent=2))
