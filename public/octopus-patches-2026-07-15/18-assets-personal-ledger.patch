+#!/usr/bin/env python3
+"""تستِ دفترِ شخصی/مشترک (2026-07-16): تراز سه‌طرفه + پیشنهادِ تسویه، propose-only.
+
+اثبات:
+  (الف) ledger نبود → live=False + propose «قالب را پر کن» (fail-soft).
+  (ب) ترازِ سه‌طرفه درست: joint با split، paid_by تعیین‌کنندهٔ بدهی؛ شخصی جدا.
+  (پ) خروجی هرگز تراکنشِ منفرد ندارد — فقط تراز/سهم/خالص (مرزِ PII).
+  (ت) پیشنهاد فقط مشاوره است (شاملِ «تأیید»)، نه دستور؛ صفر حرکتِ مالی.
+$0 آفلاین، stdlib، fixture محلی.
+"""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import harness  # noqa: E402
+ENV = harness.setup("personal-ledger")
+
+_LEGS = harness.REAL_VAULT / "_ops" / "legs"
+if str(_LEGS) not in sys.path:
+    sys.path.insert(0, str(_LEGS))
+import personal_ledger as pl  # noqa: E402
+
+
+def _write_ledger(entries):
+    import opslib
+    p = opslib.ORG_ROOT / "03 - Projects" / "Accounting" / "personal" / "ledger.json"
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(json.dumps({"_schema": "personal-shared-ledger.v1", "currency": "AUD",
+                             "default_split": {"me": 50, "coworker": 50},
+                             "entries": entries}, ensure_ascii=False), "utf-8")
+    return p
+
+
+def t_a_no_ledger_proposes_template():
+    st = pl.personal_status(path=Path("F:/does-not-exist/ledger.json"))
+    assert st["live"] is False and "پر کن" in st["note"], st
+
+
+def t_b_joint_split_and_debt():
+    """۱۰۰ مشترک ۵۰/۵۰ که من دادم → همکار ۵۰ به من بدهکار."""
+    p = _write_ledger([{"date": "2026-07-01", "desc": "x", "amount": 100,
+                        "owner": "joint", "paid_by": "me",
+                        "split": {"me": 50, "coworker": 50}}])
+    st = pl.personal_status(p)
+    b = st["balance"]
+    assert b["joint_total"] == 100.0 and b["net_owed_to_me"] == 50.0, b
+    assert "بدهکار است" in st["proposal"] and "تأیید" in st["proposal"], st["proposal"]
+
+
+def t_c_coworker_paid_flips_sign():
+    """قبضِ مشترکِ ۸۰ که همکار داد → من ۴۰ به همکار بدهکار (خالص منفی)."""
+    p = _write_ledger([{"date": "2026-07-02", "desc": "y", "amount": 80,
+                        "owner": "joint", "paid_by": "coworker",
+                        "split": {"me": 50, "coworker": 50}}])
+    b = pl.personal_status(p)["balance"]
+    assert b["net_owed_to_me"] == -40.0, b
+
+
+def t_d_personal_entries_separate():
+    """خرجِ شخصی در تسویهٔ مشترک نمی‌آید."""
+    p = _write_ledger([{"date": "2026-07-03", "desc": "z", "amount": 30, "owner": "me", "paid_by": "me"},
+                       {"date": "2026-07-03", "desc": "w", "amount": 20, "owner": "coworker", "paid_by": "coworker"}])
+    b = pl.personal_status(p)["balance"]
+    assert b["my_personal_total"] == 30.0 and b["coworker_personal_total"] == 20.0
+    assert b["net_owed_to_me"] == 0.0, b   # هیچ مشترکی → تسویه صفر
+
+
+def t_e_no_descriptions_or_raw_entries_leaked():
+    """مرزِ PII: خروجی نه descِ تراکنش‌ها را دارد، نه لیستِ خامِ entries — فقط ترازِ تجمیعی
+    (که خودِ مالک می‌خواهد ببیند). با ۳ تراکنشِ متمایز آزموده می‌شود تا مجموع ≠ تک‌تک باشد."""
+    p = _write_ledger([{"date": "2026-07-01", "desc": "رازِ-خصوصیِ-یک", "amount": 111, "owner": "joint", "paid_by": "me"},
+                       {"date": "2026-07-02", "desc": "رازِ-خصوصیِ-دو", "amount": 222, "owner": "me", "paid_by": "me"},
+                       {"date": "2026-07-03", "desc": "رازِ-خصوصیِ-سه", "amount": 333, "owner": "coworker", "paid_by": "coworker"}])
+    st = pl.personal_status(p)
+    blob = json.dumps(st, ensure_ascii=False)
+    for secret in ("رازِ-خصوصیِ-یک", "رازِ-خصوصیِ-دو", "رازِ-خصوصیِ-سه"):
+        assert secret not in blob, f"descِ تراکنش نباید در خروجی باشد: {secret}"
+    assert "entries" not in st, "لیستِ خامِ تراکنش‌ها نباید در خروجی باشد"
+    # ترازِ تجمیعی مجاز است (چیزی که مالک می‌خواهد): joint_total=111، شخصی‌ها جدا
+    assert st["balance"]["joint_total"] == 111.0 and st["balance"]["my_personal_total"] == 222.0
+
+
+def t_f_settled_when_balanced():
+    p = _write_ledger([{"date": "d", "desc": "a", "amount": 100, "owner": "joint", "paid_by": "me"},
+                       {"date": "d", "desc": "b", "amount": 100, "owner": "joint", "paid_by": "coworker"}])
+    st = pl.personal_status(p)
+    assert st["balance"]["net_owed_to_me"] == 0.0
+    assert "تسویه" in st["proposal"], st["proposal"]
+
+
+if __name__ == "__main__":
+    for f in (t_a_no_ledger_proposes_template, t_b_joint_split_and_debt, t_c_coworker_paid_flips_sign,
+              t_d_personal_entries_separate, t_e_no_descriptions_or_raw_entries_leaked, t_f_settled_when_balanced):
+        f()
+        print("ok", f.__name__)
+    print("PASS test_personal_ledger")
