 from cortex import code_autonomy as CA  # noqa: E402
 
+# رفرنسِ تابعِ واقعی، پیش از این‌که تست‌ها CA.heart_mood را با fake جایگزین کنند
+_REAL_HEART_MOOD = CA.heart_mood
+
 
 class _C:
