+def _content_hash(t: dict) -> str:
+    """کلیدِ dedupِ محتوایی (روش ۳) — بینِ API و فایل که idهاشان فرق دارد. date|cents|desc کوتاه."""
+    import hashlib
+    key = f"{t.get('date')}|{t.get('amount_cents')}|{str(t.get('desc', ''))[:20].lower()}"
+    return hashlib.sha1(key.encode("utf-8")).hexdigest()
+
