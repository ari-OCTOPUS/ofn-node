+"""test_baseline_money_fingerprint.py — P2 (2026-07-15, DUP-01): fingerprintِ پول
+enforcerِ واقعیِ ریشه را می‌بندد و فایلِ غایب را بلند می‌کند (نه رد ساکت)."""
+import hashlib
+import sys
+import tempfile
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(_HERE.parent))
+
+import baseline  # noqa: E402
+
+
+def _mk(root: Path):
+    ops = root / "_ops"
+    (ops / "budget").mkdir(parents=True)
+    for f in ("money_gate", "capability_gate", "organ_gate", "fitness"):
+        (ops / "budget" / f"{f}.py").write_text(f"# {f}\n", "utf-8")
+    scripts = root / "04 - Architect System" / "scripts"
+    scripts.mkdir(parents=True)
+    (scripts / "budget_gate.py").write_text("# real enforcer\n", "utf-8")
+    return ops
+
+
+def t_a_root_enforcer_included():
+    """تغییرِ enforcerِ واقعیِ ریشه باید fingerprint را عوض کند (قبلاً کور بود)."""
+    with tempfile.TemporaryDirectory() as td:
+        ops = _mk(Path(td))
+        fp1 = baseline._fingerprint_money_sources(ops)
+        (Path(td) / "04 - Architect System" / "scripts" / "budget_gate.py").write_text("# TAMPERED\n", "utf-8")
+        fp2 = baseline._fingerprint_money_sources(ops)
+        assert fp1 != fp2, "دستکاریِ enforcerِ ریشه باید fingerprint را تغییر دهد"
+
+
+def t_b_missing_is_loud_not_silent():
+    """حذفِ یک منبعِ پولی باید fingerprint را تغییر دهد (رد ساکت ممنوع)."""
+    with tempfile.TemporaryDirectory() as td:
+        ops = _mk(Path(td))
+        fp_full = baseline._fingerprint_money_sources(ops)
+        (ops / "budget" / "money_gate.py").unlink()
+        fp_missing = baseline._fingerprint_money_sources(ops)
+        assert fp_full != fp_missing, "فایلِ غایب باید در fingerprint اثر بگذارد"
+
+
+def t_c_no_phantom_ops_budget_gate():
+    """مسیرِ ناموجودِ قدیمی دیگر در لیستِ ops-relative نیست."""
+    assert "budget/budget_gate.py" not in baseline.MONEY_SOURCE_FILES
+    assert "04 - Architect System/scripts/budget_gate.py" in baseline.MONEY_SOURCE_ROOT_FILES
+
+
+if __name__ == "__main__":
+    for f in (t_a_root_enforcer_included, t_b_missing_is_loud_not_silent, t_c_no_phantom_ops_budget_gate):
+        f()
+        print("ok", f.__name__)
+    print("PASS test_baseline_money_fingerprint")
