++            "nonce": state.get("nonce"), "next_index": state.get("next_index"),
++            "next_expected": SEQUENCE[int(state.get("next_index") or 0)]
++            if state.get("open") else None,
++            "seen": state.get("seen") or [], "completed": bool(state.get("completed"))}
