++               "stuck_intents", "memory_mutations", "paid_calls", "heartbeat_spam"}
++    COUNT_OK = {"acknowledgments", "results_committed", "delivery_receipts_ok",
++                "readbacks_confirmed"}
++    failed = []
++    for k, v in checks.items():
++        if v is True:
++            continue
