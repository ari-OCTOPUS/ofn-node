++    assert r["decision"] == "OUT_OF_ORDER" and r["row"]["expected"] == "CANARY-01"
++    st = cw.window_status()
++    assert st["next_index"] == 0
++
++
++def t_e_unlabelled_text_is_unknown_no_advance():
++    cw, root = _fresh()
