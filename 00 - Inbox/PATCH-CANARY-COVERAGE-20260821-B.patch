+        except Exception as exc:  # noqa: BLE001
+            _append_receipt({"ts": time.time(), "kind": "restart_failed",
+                             "error": type(exc).__name__})
+    print(json.dumps(rep, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
