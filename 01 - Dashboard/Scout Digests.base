filters:
  and:
    - file.inFolder("00 - Inbox/scout-digests")
    - type == "research"
properties:
  project:
    displayName: پروژه
  status:
    displayName: وضعیت
  tags:
    displayName: موضوع
  created:
    displayName: تاریخ
views:
  - type: table
    name: همه دیجست‌ها
    order:
      - file.name
      - project
      - tags
      - created
  - type: table
    name: به تفکیک پروژه
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - tags
      - created
  - type: cards
    name: کارت‌ها
    order:
      - file.name
      - created
