filters:
  and:
    - type == "project"
properties:
  status:
    displayName: وضعیت
  kind:
    displayName: نوع
  updated:
    displayName: به‌روزرسانی
views:
  - type: table
    name: فعال
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - kind
      - status
      - updated
  - type: table
    name: همه بر اساس وضعیت
    order:
      - file.name
      - kind
      - status
      - updated
