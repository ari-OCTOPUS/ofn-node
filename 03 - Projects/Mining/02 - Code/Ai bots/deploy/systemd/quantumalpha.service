[Unit]
Description=QuantumAlphaBot — Coin Hunter (scheduled every 6h)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/ai-bots/QuantumAlphaBot
EnvironmentFile=/home/pi/ai-bots/QuantumAlphaBot/.env
ExecStart=/home/pi/ai-bots/.venv/bin/python main.py --once
StandardOutput=append:/var/log/quantumalpha.log
StandardError=append:/var/log/quantumalpha.log
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
