[Unit]
Description=Fleet Watchdog (RPi3B backup monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ai-bots
EnvironmentFile=/etc/watchdog-agent.env
ExecStart=/home/pi/ai-bots/.venv/bin/python -m fleet.watchdog
Restart=always
RestartSec=30
StandardOutput=append:/var/log/fleet-watchdog.log
StandardError=append:/var/log/fleet-watchdog.log

[Install]
WantedBy=multi-user.target
