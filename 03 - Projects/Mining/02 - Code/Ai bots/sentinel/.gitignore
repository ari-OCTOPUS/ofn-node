# SENTINEL — .gitignore
# Secrets & generated files — NEVER commit these
# فایل‌های سری و تولیدشده — هرگز اینها را کامیت نکن

# Secrets / اسرار
.env
*.key
*.pem

# Database / پایگاه داده
state.db
*.db-wal
*.db-shm

# Python / پایتون
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/

# Logs / لاگ
sentinel.log
*.log.*

# Backtest cache (large files)
backtest_cache/

# IDE / ابزارهای توسعه
.vscode/
.idea/
*.swp
.DS_Store

# Test cache / کش تست
.pytest_cache/
.coverage
