{
  "name": "wlos",
  "version": "0.1.1",
  "private": true,
  "description": "Weight Loss OS (WLOS-Sydney-1) — private, Telegram-connected, Persian/English adaptive weight-management system",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/telegram-bot"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false || tsc --noEmit",
    "bot": "tsx apps/telegram-bot/src/main.ts",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/telegram-bot/src/worker.ts",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.80.9",
    "fastify": "^5.10.0",
    "grammy": "^1.45.1",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
