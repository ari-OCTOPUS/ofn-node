// WLOS-Sydney-1 core schema. PostgreSQL 15+. All timestamps timestamptz (Prisma default).
// Daily boundaries are ALWAYS Sydney local midnight — dayKey columns store the
// precomputed local calendar day (YYYY-MM-DD) alongside UTC instants.
//
// NOTE (documented deviation): the spec's eight twin tables
// (sleep/mood/hunger/craving/stress/energy/focus/motivation_logs) are one
// StateLog table with a `kind` enum — identical shape, one indexed table.
// See docs/assumptions.md #D3.

generator client {
  provider = "prisma-client"
  output   = "../packages/memory/src/generated"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & preferences ────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? // soft delete; hard purge via DeletionRequest job
  displayName   String
  locale        String    @default("fa-AU") // Persian UI, Australian region
  timezone      String    @default("Australia/Sydney")
  crisisModeUntil DateTime? // ordinary coaching suppressed until this passes

  profile          UserProfile?
  telegramAccounts TelegramAccount[]
  notificationPref NotificationPreference?
  consents         Consent[]
  consentEvents    ConsentEvent[]
  weights          Weight[]
  measurements     BodyMeasurement[]
  meals            Meal[]
  nutritionDays    NutritionDailySummary[]
  nutritionTargets NutritionTarget[]
  workouts         Workout[]
  stateLogs        StateLog[]
  stepsDays        StepsDailySummary[]
  cannabisEvents   CannabisEvent[]
  checkins         CheckinInstance[]
  observations     BehavioralObservation[]
  formulations     BehavioralFormulation[]
  barriers         Barrier[]
  strategies       Strategy[]
  experiments      Experiment[]
  patterns         Pattern[]
  memories         Memory[]
  agentRuns        AgentRun[]
  llmCalls         LlmCall[]
  safetyEvents     SafetyEvent[]
  escalations      Escalation[]
  reports          Report[]
  exportJobs       DataExportJob[]
  deletionRequests DeletionRequest[]
  auditLogs        AuditLog[]
  outbound         OutboundMessage[]
  selfModProposals SelfModProposal[]
  coachNotes       CoachNote[]
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex           String? // 'male' | 'female' (BMR math); free-text gender welcome in displayName
  birthYear     Int?
  heightCm      Float?
  goalWeightKg  Float?
  goalNote      String?
  activityLevel String   @default("light") // sedentary|light|moderate|active|very_active
  onboardingStep String  @default("welcome") // FSM cursor; 'done' when complete
  hideCalories  Boolean  @default(false) // ED-safeguard display option
  updatedAt     DateTime @updatedAt
}

model TelegramAccount {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId     BigInt   @unique
  username   String?
  isOwner    Boolean  @default(true) // single-user product
  linkedAt   DateTime @default(now())

  @@index([userId])
}

model NotificationPreference {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone           String    @default("Australia/Sydney")
  dailyCap           Int       @default(20)
  targetCheckinsMin  Int       @default(3)
  targetCheckinsMax  Int       @default(6)
  minGapMinutes      Int       @default(120)
  quietStart         String    @default("00:00")
  quietEnd           String    @default("07:00")
  quietSuspended     Boolean   @default(false) // /nosleep
  paused             Boolean   @default(false)
  snoozedUntil       DateTime?
  stopForDayKey      String? // "امروز دیگه نپرس"
  backoffMultiplier  Float     @default(1.0)
  ignoredStreak      Int       @default(0)
  updatedAt          DateTime  @updatedAt
}

// ── Consent (append-only events + current state) ─────────────────────────

model Consent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String // core_health | psychology | cannabis | coach_sharing
  granted   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, scope])
}

model ConsentEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String
  granted    Boolean
  source     String // 'telegram' | 'mini_app'
  occurredAt DateTime @default(now())

  @@index([userId, scope, occurredAt])
}

// ── Health events (provenance convention: occurredAt/recordedAt/source) ──

model Weight {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  recordedAt DateTime  @default(now())
  dayKey     String // Sydney local day
  kg         Float
  source     String    @default("telegram_text")
  confidence String    @default("stated") // stated|estimated
  note       String?
  deletedAt  DateTime?

  @@index([userId, dayKey])
}

model BodyMeasurement {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  dayKey     String
  site       String // waist|hip|chest|arm|thigh|neck
  cm         Float
  source     String   @default("telegram_text")

  @@index([userId, dayKey])
}

model Meal {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt       DateTime
  recordedAt       DateTime  @default(now())
  dayKey           String
  nameRaw          String // exactly as the user typed it
  nameKey          String // normalized search key
  calories         Int
  proteinG         Int?
  carbsG           Int?
  fatG             Int?
  mealSlot         String? // breakfast|lunch|dinner|snack (best-effort)
  source           String    @default("telegram_text") // NO photo sources by design
  confirmedHigh    Boolean   @default(false) // >3000 kcal explicitly confirmed
  deletedAt        DateTime?

  @@index([userId, dayKey])
  @@index([userId, nameKey])
}

model NutritionDailySummary {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey          String
  totalCalories   Int
  totalProteinG   Int?
  mealsLogged     Int
  targetLow       Int?
  targetHigh      Int?
  withinTarget    Boolean?
  computedAt      DateTime @updatedAt

  @@unique([userId, dayKey])
}

model NutritionTarget {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @default(now())
  kcalLow       Int
  kcalHigh      Int
  proteinG      Int
  fiberLow      Int
  fiberHigh     Int
  rationale     String
  floorApplied  Boolean  @default(false)

  @@index([userId, effectiveFrom])
}

// ── Training ─────────────────────────────────────────────────────────────

model Exercise {
  id       String       @id @default(uuid())
  nameEn   String       @unique
  nameFa   String?
  category String // compound|isolation|cardio|mobility
  sets     WorkoutSet[]
}

model Workout {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt  DateTime
  dayKey      String
  kind        String // gym|home|travel|walk|cardio|minimum_dose|recovery
  title       String
  durationMin Int?
  rpe         Int? // 1..10 session RPE
  note        String?
  planned     Boolean      @default(false)
  completed   Boolean      @default(true)
  sets        WorkoutSet[]

  @@index([userId, dayKey])
}

model WorkoutSet {
  id         String   @id @default(uuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  nameRaw    String
  setIndex   Int
  reps       Int?
  weightKg   Float?
  rir        Int? // reps in reserve

  @@index([workoutId])
}

// ── Subjective state (one table, kind enum — see docs/assumptions.md #D3) ─

model StateLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  dayKey     String
  kind       String // sleep_hours|mood|hunger|craving|stress|energy|focus|motivation
  value      Float // 0–10 scales; sleep_hours in hours
  note       String?
  source     String   @default("checkin")
  deletedAt  DateTime?

  @@index([userId, kind, dayKey])
}

model StepsDailySummary {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey String
  steps  Int
  source String @default("telegram_text")

  @@unique([userId, dayKey])
}

// ── Cannabis-aware (consent-gated, soft-deleted, neutral) ────────────────

model CannabisEvent {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt    DateTime
  dayKey        String
  intensity     String? // light|moderate|strong (user's own words mapped)
  hungerBefore  Int? // 0..10
  hungerAfter   Int?
  note          String?
  deletedAt     DateTime?

  @@index([userId, dayKey])
}

// ── Check-ins ────────────────────────────────────────────────────────────

model CheckinInstance {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey        String
  slotKey       String // morning|midday|pre_evening|evening|extra
  topic         String
  questionId    String? // question-bank id (versioned in code)
  scheduledAt   DateTime
  sentAt        DateTime?
  status        String    @default("scheduled") // scheduled|sent|answered|ignored|cancelled|snoozed
  cancelReason  String?
  responses     CheckinResponse[]

  @@index([userId, dayKey, status])
}

model CheckinResponse {
  id         String          @id @default(uuid())
  checkinId  String
  checkin    CheckinInstance @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  answeredAt DateTime        @default(now())
  valueRaw   String // button payload or free text
  valueNum   Float?

  @@index([checkinId])
}

// ── Behavioral layer ─────────────────────────────────────────────────────

model BehavioralObservation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime @default(now())
  domain     String // question-bank domain or 'freeform'
  content    String // structured extraction, NOT raw chat dump
  sourceRef  String? // checkin id / message context
  sensitive  Boolean  @default(false) // requires psychology consent to use

  @@index([userId, domain])
}

// Situation→Trigger→Thought→Emotion→Urge→Behavior→Reward→Consequence→Alternative→Outcome
model BehavioralFormulation {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  situation    String
  trigger      String?
  thought      String?
  emotion      String?
  urge         String?
  behavior     String?
  immediateReward String?
  delayedConsequence String?
  alternativeResponse String?
  experimentOutcome String?
  confidence   String   @default("hypothesis") // hypothesis|low|medium|high
  evidenceCount Int     @default(1)

  @@index([userId])
}

model Barrier {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  description String
  combCapability  String @default("unknown") // sufficient|limited|unknown
  combOpportunity String @default("unknown")
  combMotivation  String @default("unknown")
  status      String   @default("active") // active|resolved|parked
  strategies  Strategy[]

  @@index([userId, status])
}

model Strategy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barrierId   String?
  barrier     Barrier? @relation(fields: [barrierId], references: [id])
  bctCode     String? // Behavior Change Technique taxonomy ref
  description String
  status      String   @default("candidate") // candidate|testing|kept|discarded
  createdAt   DateTime @default(now())

  @@index([userId, status])
}

model Experiment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  hypothesis     String
  baseline       String
  intervention   String
  startDayKey    String
  endDayKey      String
  primaryOutcome String
  secondaryOutcome String?
  stopConditions String
  burdenEstimate String   @default("low") // low|medium|high
  status         String   @default("proposed") // proposed|active|finished|abandoned
  results        ExperimentResult[]

  @@index([userId, status])
}

model ExperimentResult {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  recordedAt   DateTime   @default(now())
  outcome      String
  confidence   String     @default("low")
  decision     String // retain|modify|discard
}

// ── Patterns (hypotheses with evidence, NEVER causal claims) ─────────────

model Pattern {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternType    String   @default("association")
  antecedent     String // e.g. sleep_under_6h
  outcome        String // e.g. evening_craving
  direction      String // positive|negative
  effectSummary  String
  evidenceCount  Int      @default(0)
  counterexampleCount Int @default(0)
  confidence     String   @default("hypothesis") // hypothesis|low|medium|high
  notCausal      Boolean  @default(true)
  userVerdict    String? // confirmed|rejected (user correction wins)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  nextValidationQuestion String?
  sensitive      Boolean  @default(false)
  evidence       PatternEvidence[]
  corrections    PatternUserCorrection[]

  @@unique([userId, antecedent, outcome])
}

model PatternEvidence {
  id        String   @id @default(uuid())
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  dayKey    String
  kind      String // supporting|counterexample
  detail    String
  createdAt DateTime @default(now())

  @@index([patternId, kind])
}

model PatternUserCorrection {
  id        String   @id @default(uuid())
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  verdict   String // confirmed|rejected|nuanced
  note      String?
  createdAt DateTime @default(now())
}

// ── Memory (backend-owned; LLMs never own this) ──────────────────────────

model Memory {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  layer      String // identity|preference|dynamic_state|episodic|pattern|intervention|safety|consent
  key        String
  content    String
  sensitive  Boolean         @default(false)
  provenance String // where this came from
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  expiresAt  DateTime? // retention policy
  versions   MemoryVersion[]

  @@unique([userId, layer, key])
}

model MemoryVersion {
  id        String   @id @default(uuid())
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  content   String
  reason    String // update|user_correction|contradiction
  createdAt DateTime @default(now())
}

// ── Observability, safety, governance ────────────────────────────────────

model AgentRun {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent      String // orchestrator|safety|plateau|...
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    String? // concise rationale summary — NEVER chain-of-thought
  error      String?

  @@index([agent, startedAt])
}

model LlmCall {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider       String
  model          String
  purpose        String
  dataCategories String // csv of categories INCLUDED in packet (audit)
  ok             Boolean
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int      @default(0)
  failureReason  String?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
}

model SafetyEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime @default(now())
  direction  String // inbound|outbound
  level      String // caution|urgent_medical|crisis
  categories String // csv
  action     String // resources_sent|message_blocked|coaching_paused|escalation_suggested
  detail     String? // minimal necessary data only

  @@index([userId, occurredAt])
}

model Escalation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  kind       String // medical|mental_health|eating_disorder|substance
  suggestion String // what human support was suggested
  resolved   Boolean  @default(false)
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // daily|weekly|monthly|coach_ready
  dayKey    String // period end day
  format    String   @default("markdown") // markdown|json
  content   String
  createdAt DateTime @default(now())

  @@index([userId, kind, dayKey])
}

model DataExportJob {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("pending") // pending|done|failed
  format      String    @default("json")
}

model DeletionRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime  @default(now())
  confirmedAt DateTime?
  purgedAt    DateTime?
  status      String    @default("awaiting_confirmation") // awaiting_confirmation|confirmed|purged|cancelled
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor     String // 'user'|'system'|'coach'
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

// ── Message ledger (cap enforcement + duplicate prevention + audit) ──────

model OutboundMessage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey      String // Sydney local day — cap is per local day
  kind        String // safety|checkin|coach|reply|system
  sensitivity String   @default("low")
  preview     String // EXACTLY what could appear on a lock screen
  sentAt      DateTime @default(now())
  bypassedCap Boolean  @default(false) // true only for kind=safety

  @@index([userId, dayKey])
}

model ProcessedUpdate {
  updateId  BigInt   @id // Telegram update_id — idempotency
  processedAt DateTime @default(now())
}

// ── Self-modification (proposals require explicit user approval) ─────────

model SelfModProposal {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  category       String // message_budget|quiet_hours|question_bank|schedule|prompt|parameter|code
  title          String
  hypothesis     String
  evidence       String
  expectedEffect String
  burden         String    @default("low")
  risk           String    @default("low")
  rollbackPlan   String
  status         String    @default("pending") // pending|approved|rejected|applied
  decidedAt      DateTime?
  appliedAt      DateTime?
  decisionNote   String?

  @@index([userId, status])
}

model CoachNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    String // coach identifier (not a WLOS account)
  content   String // treated as CONSTRAINTS by agents, never overridden
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  @@index([userId, active])
}
