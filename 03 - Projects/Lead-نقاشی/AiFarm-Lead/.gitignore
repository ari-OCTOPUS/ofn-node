# ============================================================
# Brushline / AiFarm-Lead -- .gitignore
# CRITICAL: secrets and customer PII (INV-2) must NEVER be committed.
# ============================================================

# --- Secrets (NEVER commit) ---------------------------------
.env
**/.env
.env.local
**/.env.local
*.pem
*.key
*.p12
secrets.*
**/secrets.*

# Keep the template (it has placeholders only)
!.env.example
!**/.env.example

# --- Customer data / PII / databases (INV-2) ----------------
data/
**/data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# --- Governance runtime artefacts ---------------------------
KILL_SWITCH
**/KILL_SWITCH
*.audit
audit_*.log

# --- Python --------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor junk ---------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# --- Logs / temp --------------------------------------------
*.log
logs/
tmp/
*.tmp
