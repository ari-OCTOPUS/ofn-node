# infra-control/.env.example
# Copy to .env and fill in. NEVER commit .env to git.
# Managed via SOPS+age in production (see RUNBOOK.md).

# ── Domain ────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
ACME_EMAIL=your@email.com

# ── Traefik dashboard basic auth ──────────────────────────────────────────
# Generate: htpasswd -nb admin YOUR_PASSWORD
# Example:  admin:$apr1$...
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGEME

# ── DNS provider for Let's Encrypt (Cloudflare) ───────────────────────────
CF_API_TOKEN=

# ── Dozzle log viewer ─────────────────────────────────────────────────────
DOZZLE_USERNAME=admin
DOZZLE_PASSWORD=changeme

# ── Telegram control bot ──────────────────────────────────────────────────
CONTROL_BOT_TOKEN=                  # from BotFather
ALLOWED_CHAT_IDS=                   # your Telegram chat ID (comma-separated if multiple)
