# Brushline — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<ROTATE — redacted 2026-07-04>

# ── Telegram (TG-01) ───────────────────────────────────────────────────────
# Create bot via @BotFather, set token here
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to control Brushline (INV-1)
ALLOWED_OPERATOR_CHAT_IDS=

# ── Business ───────────────────────────────────────────────────────────────
BUSINESS_NAME=
BUSINESS_ABN=

# ── Database (separate from LANGAR — Phase 0 invariant) ───────────────────
# Absolute path on VPS. NEVER point this at LANGAR's database.
BRUSHLINE_DB_PATH=/srv/brushline/data/brushline.db

# ── Governance (INV-3) ────────────────────────────────────────────────────
# AUD caps — set from day 1 (KB-02 §4)
SPEND_CAP_PER_ACTION_AUD=5.00
SPEND_CAP_PER_DAY_AUD=20.00
KILL_SWITCH_FILE=/srv/brushline/data/KILL_SWITCH

# ── Models (CONFIG_parameters §1) ─────────────────────────────────────────
# Cheap-first router (KB-01 §3): Haiku for ~90%, Sonnet for key copy/gate
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_KEY=claude-sonnet-4-6
BATCH_ENABLED=true
CACHE_ENABLED=true

# ── Search (Phase 1 — REQUIRED for Worker A) ──────────────────────────────
# Serper: free tier = 2 500 queries/month. Get key at serper.dev
SERPER_API_KEY=
# DataForSEO: async $0.0006/query, live $0.002/query (reserved Phase 3+)
# DATAFOR_SEO_LOGIN=
# DATAFOR_SEO_PASSWORD=

# ── Integration (Phase 5) ──────────────────────────────────────────────────
# SERVICEM8_API_KEY=
# TRADIFY_API_KEY=
