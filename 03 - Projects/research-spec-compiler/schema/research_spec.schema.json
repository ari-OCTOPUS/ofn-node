{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/research_spec.schema.json",
  "title": "Research Spec (executable)",
  "description": "The 11 canonical fields that turn an idea into an executable, falsifiable research spec.",
  "type": "object",
  "required": [
    "idea", "hypothesis", "prediction", "metric", "experiment",
    "failure_condition", "architecture", "api_contract", "mvp",
    "evaluation", "decision_rule"
  ],
  "additionalProperties": true,
  "properties": {
    "idea": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "prediction": {
      "type": "object",
      "required": ["baseline", "expected"],
      "properties": {
        "statement": { "type": "string" },
        "baseline": { "type": "number" },
        "expected": { "type": "number" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string" },
        "direction": { "type": "string", "enum": ["higher_is_better", "lower_is_better"] },
        "primary": { "type": "boolean" }
      }
    },
    "experiment": {
      "type": "object",
      "required": ["conditions"],
      "properties": {
        "dataset": { "type": "string" },
        "n": { "type": "integer" },
        "conditions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "protocol": { "type": "string" }
      }
    },
    "failure_condition": {
      "type": "object",
      "required": ["metric", "op", "threshold"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "enum": ["<", "<=", ">", ">=", "==", "!="] },
        "threshold": { "type": "number" },
        "note": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "topology": { "type": "string" },
        "tradeoff": { "type": "string" }
      }
    },
    "api_contract": {
      "type": "object",
      "required": ["endpoint", "method", "request", "response"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "request": { "type": "object", "minProperties": 1 },
        "response": { "type": "object", "minProperties": 1 }
      }
    },
    "mvp": {
      "type": "object",
      "required": ["stack", "effort"],
      "properties": {
        "stack": { "type": "string", "minLength": 1 },
        "deps": { "type": "array", "items": { "type": "string" } },
        "effort": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "comparisons": { "type": "array", "items": { "type": "string" } },
        "ablation": { "type": "array", "items": { "type": "string" } },
        "seeds": { "type": "integer", "minimum": 1 }
      }
    },
    "decision_rule": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "primary_metric": { "type": "string" },
        "rules": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["verdict"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "verdict": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
