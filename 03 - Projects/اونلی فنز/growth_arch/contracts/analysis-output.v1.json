{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/growth-archaeologist/analysis-output.v1.json",
  "title": "Growth Archaeologist Analysis Output",
  "type": "object",
  "required": [
    "schema_version",
    "job",
    "summary",
    "top_entities",
    "architecture_cards",
    "experiment_plan",
    "evidence_report"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "job": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "top_entities": {
      "type": "array"
    },
    "architecture_cards": {
      "type": "array"
    },
    "experiment_plan": {
      "type": "array"
    },
    "evidence_report": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}