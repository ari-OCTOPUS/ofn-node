#!/bin/sh
# B10: تورِ ایمنی — بدونِ سوییتِ سبز، commit نکن.
# (Git for Windows این را با sh اجرا می‌کند.)
echo "[pre-commit] running test suite..."
python tests/run_all.py
status=$?
if [ $status -ne 0 ]; then
    echo "[pre-commit] BLOCKED: تست‌ها قرمزند — اول سبز کن، بعد commit."
    exit 1
fi
echo "[pre-commit] suite green — commit allowed."
exit 0
