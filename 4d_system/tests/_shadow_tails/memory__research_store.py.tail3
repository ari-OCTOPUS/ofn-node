    p = SavedPattern(
        name="high-memory-config", rho=0.8, lam=0.6, se=0.1, sz=0.05, sd=0.1,
        delta_self=0.15, e_shadow=0.02, pcai=0.88, sms=0.15,
        detectable=True, note="حافظه‌ی قوی، نشت متوسط", tags="memory,strong"
    )
