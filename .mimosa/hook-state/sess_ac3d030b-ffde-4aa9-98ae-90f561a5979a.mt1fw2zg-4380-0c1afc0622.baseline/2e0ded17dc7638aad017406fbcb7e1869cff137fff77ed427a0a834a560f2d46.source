import sys

from core.models import Project, State
from core.runner import ProcessRunner
from core.secrets import DictSecrets
from tests.helpers import build


def test_env_injected_on_start(tmp_path):
    prov = DictSecrets({"demo-token": "s3cr3t"})
    mgr, safety, runner = build(tmp_path, secrets_map={"DEMO_SECRET": "demo-token"}, provider=prov)
    r = mgr.start("demo")
    assert r.state == State.RUNNING
    assert runner.last_env.get("DEMO_SECRET") == "s3cr3t"


def test_no_provider_means_no_secret_env(tmp_path):
    mgr, safety, runner = build(tmp_path)
    mgr.start("demo")
    assert not (runner.last_env or {})


def test_dict_secrets_lookup_and_has():
    p = Project(id="x", name="x", workdir=".", start=[], secrets={"A": "grp/alpha"})
    prov = DictSecrets({"alpha": "v1"})
    assert prov.env_for(p) == {"A": "v1"}
    assert prov.has("grp/alpha") is True
    assert prov.has("missing") is False


def test_env_reaches_real_child(tmp_path):
    r = ProcessRunner()
    code, out = r.run(
        [sys.executable, "-c", "import os;print(os.environ.get('X_TOKEN',''))"],
        tmp_path,
        env={"X_TOKEN": "abc123"},
    )
    assert code == 0 and out == "abc123"
