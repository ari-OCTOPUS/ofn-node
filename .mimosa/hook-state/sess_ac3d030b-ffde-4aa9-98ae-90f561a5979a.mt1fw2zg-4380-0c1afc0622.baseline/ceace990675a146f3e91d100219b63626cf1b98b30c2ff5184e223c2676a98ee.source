"""
researcher.py — هماهنگ‌کننده‌ی پژوهشگرِ همراه.

مأموریتِ دوسرسود:
  • TARGET_ARMIN → پیشرفتِ انسان: یافته‌ها + پیشنهادِ آزمایشِ N-of-1.
  • TARGET_SELF  → معماریِ سیستم: یافته‌ها + diffِ سطح ۲ (هرگز اجرای خودکار).

هدف‌محور است: اهدافِ فعلی را می‌گیرد و طراحی را به آن‌ها گره می‌زند.
همه‌چیز از gate (Constitution) رد می‌شود و سورس‌دار/تگ‌خورده است.
"""

from __future__ import annotations

import json
from pathlib import Path

from observability import trace

from .search_providers import get_search_provider  # noqa: F401 (برای راحتیِ import بیرونی)
from .synthesizer import synthesize
from . import source_quality

TARGET_ARMIN = "armin"
TARGET_SELF = "self"

_FALLBACK_PROMPT = (
    "تو پژوهشگرِ محتاطِ LANGAR هستی: مهندسِ مولتی‌ایجنت، متخصصِ روانِ انسان، و مهندسِ "
    "این پروژه. سورس‌دار و تگ‌خورده ([E]/[S]/[P]) پاسخ بده. تصمیم نگیر؛ پیشنهاد بده."
)


def _load_prompt() -> str:
    p = Path(__file__).resolve().parent.parent / "RESEARCHER_PROMPT.md"
    try:
        return p.read_text(encoding="utf-8")
    except OSError:
        return _FALLBACK_PROMPT


class Researcher:
    def __init__(self, brain, search, db=None, patch_manager=None, gate=None):
        self.brain = brain
        self.search = search
        self.db = db
        self.patch_manager = patch_manager
        self.gate = gate  # callable(text)->bool ؛ معمولاً constitution.is_compliant
        self.system_prompt = _load_prompt()

    def _gated(self, text: str) -> str:
        if self.gate:
            try:
                if not self.gate(text):
                    return "⚠️ خروجی با قوانین سازگار نبود — طبقِ «در شک: سکوت» حذف شد."
            except Exception:
                pass
        return text

    @trace("tool_call")  # M6/G-08: spanِ ابزار (جستجوی وب + سنتزِ منبع‌دار)
    def research(self, question: str, target: str = TARGET_ARMIN, goals=None) -> dict:
        results = self.search.search(question)
        # منبع‌سنجی: رتبه‌بندی بر اساسِ کیفیت + تخمینِ عدم‌قطعیت
        ranked = source_quality.rank(results, question)
        unc = source_quality.uncertainty(ranked)
        syn = synthesize(self.brain, question, ranked, target)
        brief = self._gated(syn["brief"])
        rec = {"question": question, "target": target, "brief": brief,
               "sources": [r.get("url") for r in ranked if r.get("url")],
               "source_scores": [{"url": r.get("url"), "score": r.get("_score")} for r in ranked[:5]],
               "uncertainty": unc, "tag": syn["tag"], "goals": goals}

        if target == TARGET_SELF and self.patch_manager is not None:
            rec["proposal"] = self.patch_manager.generate_patch(question)  # diff سطح ۲
        else:
            rec["proposal"] = {
                "type": "experiment",
                "text": "گامِ آزمون‌پذیر: با /experiment یک آزمایشِ N-of-1 بساز تا این "
                        "ادعا روی داده‌ی واقعیِ تو سنجیده شود. قضاوت با توست.",
            }

        if self.db is not None:
            try:
                rec["id"] = self.db.save_research(
                    question, target, brief,
                    json.dumps(syn["sources"], ensure_ascii=False), syn["tag"])
            except Exception:
                pass
        return rec

    def propose_architecture(self, goals) -> dict:
        """هدفِ self: بر اساسِ اهداف (و تغییرشان) یک پیشنهادِ معماری می‌دهد."""
        q = f"بهترین معماری/طراحی برای این اهداف: {goals}"
        results = self.search.search(q)
        data = (f"اهدافِ فعلی: {goals}\n\nیافته‌های وب:\n"
                + "\n".join(f"- {r.get('title','')}: {r.get('snippet','')[:120]}"
                            for r in results[:5]))
        try:
            design = self.brain.ask(self.system_prompt,
                                    {"domain": "architecture", "label": "معماری", "data": data})
        except Exception:
            design = ("[S] بدونِ LLM طراحیِ کامل ممکن نیست. اصولِ امن: ماژولار بمان، "
                      "قوانین را نگه دار، تغییرِ کوچک و آزمون‌پذیر.")
        return {"target": TARGET_SELF, "goals": goals, "design": self._gated(design),
                "sources": [r.get("url") for r in results if r.get("url")]}
