"""
behavioral_holdout.py — بستنِ G-04/G-15/G-26 (از GAPS.md): ارزیابِ رفتاریِ held-out
که بهینه‌ساز نمی‌تواند ببیند یا گِیم کند (anti-Goodhart).

ایده (canonِ ژنوم + GAPS G-04/G-26):
  «ارزیاب/متریک در ژنوم فریز است؛ held-out را بهینه‌ساز نمی‌بیند؛ ترفیعِ یک prompt
   فقط با بهبودِ *رفتاری* روی held-out معتبر است، نه با کیواژه‌ی rubric.»

score رفتاری = نسبتِ ادعاهایی که در برابرِ held-outِ فریز، با داوریِ *مکانیکیِ* کرنل
(igk.kernel.Kernel._judge — همان منبعِ واحدِ حقیقت) «ok» می‌گیرند. چون داوری روی
«مقدارِ درست» است نه واژه‌های rubric، keyword-stuffing نمره نمی‌خرد → حلقهٔ
خودارجاع (Goodhart) می‌شکند.

runner تزریق‌پذیر است:
  - LIVE: پایپ‌لاینِ واقعیِ ایجنت (LLM) که یک probe می‌گیرد و متن برمی‌گرداند.
  - TEST/MOCK: تابعِ مصنوعیِ قطعی.
همه‌چیز fail-closed: نبودِ held-out یا شکستِ runner → نمره‌ی صفر، ترفیعِ رد.
"""
from __future__ import annotations
from typing import Callable
import json, os

from igk.kernel import Kernel  # داوریِ مکانیکیِ واحد — بدونِ کپی/واگرایی

Runner = Callable[[str, str, str], str]  # (agent, prompt, probe) -> answer


def load_frozen_holdout(path: str) -> list[dict]:
    """held-outِ فریز را می‌خواند. غایب/بدشکل → لیستِ تهی (بعداً fail-closed)."""
    if not path or not os.path.exists(path):
        return []
    try:
        data = json.load(open(path, encoding="utf-8"))
    except Exception:
        return []
    return data.get("facts", []) if isinstance(data, dict) else list(data)


def make_probes(facts: list[dict]) -> list[tuple[dict, str]]:
    """از هر factِ held-out یک probe می‌سازد (بدونِ فاش‌کردنِ value)."""
    return [(f, f"دربارهٔ «{f.get('subject','')}» تحقیق و گزارش بده.") for f in facts]


def behavioral_score(agent: str, prompt: str, facts: list[dict], runner: Runner) -> dict:
    """
    پایپ‌لاین را روی probeهای held-out اجرا و خروجی را مکانیکی داوری می‌کند.
    خروجی: {score, n, ok, contradicted, unverifiable, detail}
      score = ok/n در بازه‌ی 0..1. fail-closed: facts خالی → n=0, score=0.0.
    """
    probes = make_probes(facts)
    if not probes:
        return {"score": 0.0, "n": 0, "ok": 0, "contradicted": 0,
                "unverifiable": 0, "detail": []}
    ok = contra = unver = 0
    detail = []
    for f, probe in probes:
        try:
            ans = runner(agent, prompt, probe) or ""
        except Exception:
            ans = ""  # شکستِ runner = پاسخِ تهی → unverifiable
        # هر ادعا را فقط در برابرِ همان factِ هدف می‌سنجیم (داوریِ مکانیکیِ کرنل)
        verdict = Kernel._judge([f], ans)["verdict"]
        if verdict == "ok":
            ok += 1
        elif verdict == "contradicted":
            contra += 1
        else:
            unver += 1
        detail.append({"subject": f.get("subject", ""), "verdict": verdict})
    n = len(probes)
    return {"score": round(ok / n, 3), "n": n, "ok": ok,
            "contradicted": contra, "unverifiable": unver, "detail": detail}


def promotion_gate(mode: str, structural_ok: bool,
                   baseline: dict, candidate: dict,
                   min_ratio: float = 0.8) -> dict:
    """
    گیتِ ترفیعِ fail-closed و anti-Goodhart. keep فقط اگر:
      ساختار ok  ∧  score رفتاریِ candidate > baseline  ∧  candidate.score ≥ min_ratio.
    LIVE → keep قطعی؛ MOCK → keep ولی provisional (خودارجاع نیست ولی آفلاین است).
    خروجی: {keep, provisional, reason, baseline, candidate}
    """
    b = float(baseline.get("score", 0.0))
    c = float(candidate.get("score", 0.0))
    out = {"keep": False, "provisional": False, "baseline": b, "candidate": c, "reason": ""}
    if not structural_ok:
        out["reason"] = "گیتِ ساختاری رد کرد"
        return out
    if candidate.get("n", 0) == 0:
        out["reason"] = "held-outِ فریز غایب/خالی → رد (fail-closed)"
        return out
    if not (c > b):
        out["reason"] = f"بهبودِ رفتاری نداشت (baseline={b} → candidate={c})"
        return out
    if c < min_ratio:
        out["reason"] = f"score رفتاری زیرِ آستانه ({c} < {min_ratio})"
        return out
    if mode == "live":
        out.update(keep=True, provisional=False,
                   reason=f"held-outِ رفتاری ok (score={c} ≥ {min_ratio}, بهبود از {b})")
    else:
        out.update(keep=True, provisional=True,
                   reason=f"بهبودِ رفتاریِ آفلاین (score={c}) — provisional تا اجرای LIVE")
    return out
