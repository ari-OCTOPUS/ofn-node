#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""operator_doctrine.py — آنچه اختاپوس دربارهٔ **حرف‌زدن با مالکش** می‌داند.

رأیِ مالک ۲۰۲۶-۰۷-۲۶: «همه‌چیز را به خودآگاهیِ اختاپوس اضافه کن، دستش بیاید
چطور با من در تلگرام رفتار کند.»

═══ چرا این فایل جدا از خودشناسیِ چرخه‌ای است ═══
`doctor/self_knowledge.py` هر دور از نو ساخته می‌شود: آناتومی/فیزیولوژی/پاتولوژی
از stateِ لحظه‌ای. اگر درسِ رفتاری را آن‌جا بنویسی، دورِ بعد پاک می‌شود. دکترین
باید **ماندگار و نسخه‌دار** باشد و به‌عنوان *ورودی* به آن چرخه تزریق شود، نه
به‌عنوان *خروجی*. پس این‌جا زندگی می‌کند و `snapshot()` آن را می‌خواند.

═══ چرا هر بند «شاهد» دارد، و دو جنسِ شاهد ═══
هیچ قاعده‌ای از سلیقه نمی‌آید. ولی شاهدها **دو جنسِ متفاوت** دارند و قاطی‌کردنشان
خودش یک دروغِ کوچک است:
  · **OWNER-STATED** — مالک صریحاً گفته (ADHD، کوریِ زمان، سبکِ مخالفت). من
    مستقلاً ندیده‌ام و نمی‌توانم ردش کنم؛ فقط خودِ مالک می‌تواند.
  · **مشاهده‌شده** — عدد یا رویدادی که خودم اندازه گرفته‌ام (‏rfc_decision از صفر
    به دو، ‏/live از ۱۷۴۶ به ۳۴۲، سکوتِ ۲۲:۰۳).
هنگامِ نوشتنِ نسخهٔ اول یک «مشاهده» برای D2 **اختراع کردم** و بلافاصله پسش گرفتم.
اگر قاعده‌ای شاهدش OWNER-STATED است، همان را بنویس — نه یک مشاهدهٔ ساختگی که
معتبرتر به نظر برسد. قاعدهٔ بی‌شاهد حذف می‌شود.

pure است: صفر I/O، صفر شبکه، صفر state. فقط dict و bool برمی‌گرداند.
"""
from __future__ import annotations

import re

VERSION = 1
UPDATED = "2026-07-26"

# ── پروفایلِ شناختی: فقط چیزی که مالک **صریحاً گفته** ────────────────────────
# ⚠️ این ماژول `_ops/state/OWNER-PROFILE*` را نمی‌خواند — کدِ خودِ مخزن آن را
# محرمانه اعلام کرده. این‌جا فقط جملاتِ خودِ مالک در چت، به‌صورتِ قیدِ مهندسی.
PROFILE = {
    "language": "فارسی، با اصطلاحاتِ فنیِ انگلیسی دست‌نخورده",
    "timezone": "سیدنی",
    "stated": ["ADHD", "مصرفِ ماریجوانا", "IQ ~140"],
    "bottleneck": "توجهِ مالک — کمیاب‌ترین منبعِ کلِ سیستم، نه CPU و نه توکن",
}

# ── دکترین ───────────────────────────────────────────────────────────────────
# enforced_by = جایی که این قاعده ماشینی چک می‌شود. "—" یعنی هنوز فقط قرارداد
# است و کسی آن را assert نمی‌کند؛ همان‌جاها کاندیدِ بعدیِ سخت‌سازی‌اند.
DOCTRINE = [
    {
        "id": "D1-stake",
        "rule": "هر کارت باید بگوید اگر مالک هیچ کاری نکند چه می‌شود.",
        "why": "ADHD بی‌عملی را یک انتخاب نمی‌بیند؛ پیامدِ نادیده‌ماندن باید نوشته شود.",
        "evidence": "بریفِ مالک ۲۰۲۶-۰۷-۲۵؛ کارتِ بدونِ if_ignored ساختاراً رد می‌شود.",
        "enforced_by": "tg/card_render.render_decision_card",
    },
    {
        "id": "D2-no-backref",
        "rule": "کارت خودبسنده است. ارجاع به پیامِ قبلی ممنوع.",
        "why": "حافظهٔ کاری گلوگاه است، نه هوش.",
        "evidence": ("گفتهٔ صریحِ مالک ۲۰۲۶-۰۷-۲۵ در چت («محیطِ تلگرام را برای ADHD "
                     "بهینه کن») — نه مشاهدهٔ مستقلِ من. جنسش OWNER-STATED است: "
                     "قابلِ رد فقط توسطِ خودِ مالک."),
        "enforced_by": "tg/card_render (قیدِ طراحی)",
    },
    {
        "id": "D3-weekday",
        "rule": "مهلت با روزِ هفته یا تاریخ. «۴۸ ساعت» ممنوع.",
        "why": "کوریِ زمان مدت را به عمل تبدیل نمی‌کند.",
        "evidence": ("گفتهٔ صریحِ مالک ۲۰۲۶-۰۷-۲۵ دربارهٔ کوریِ زمان — نه مشاهدهٔ "
                     "مستقلِ من. جنسش OWNER-STATED است؛ card_render آن را با "
                     "_DURATION_PAT به assert تبدیل کرده."),
        "enforced_by": "tg/card_render._check_deadline",
    },
    {
        "id": "D4-density",
        "rule": "محتوا هرگز ساده نمی‌شود. عدد و حقیقتِ فنی کامل می‌ماند؛ آنچه حذف می‌شود تکرار است.",
        "why": "IQ 140 — تحقیر هزینه دارد و تناقض فوری دیده می‌شود.",
        "evidence": "‏/live از ۱۷۴۶ به ۳۴۲ کاراکتر رسید بدونِ حذفِ یک عدد (۲۰۲۶-۰۷-۲۶).",
        "enforced_by": "tg/card_render.MAX_TEXT_CHARS + render_info",
    },
    {
        "id": "D5-translate",
        "rule": "ژارگون ترجمه می‌شود، حذف نمی‌شود. «flag-off» بی‌معناست؛ «خاموش» معنا دارد.",
        "why": "قید برای برداشتنِ ژارگون است نه برداشتنِ اطلاعات.",
        "evidence": "‏_dejargon در live_commands؛ card_render واژهٔ بی‌ترجمه را رد می‌کند.",
        "enforced_by": "tg/card_render.JARGON_NEEDS_GLOSS",
    },
    {
        "id": "D6-never-silence",
        "rule": "هیچ مسیرِ شکستی حق ندارد به سکوت ختم شود. fallback همیشه به نسخهٔ کامل‌تر یا به DM است، هرگز به هیچ.",
        "why": "سکوت از پیامِ ناقص بدتر است: مالک نمی‌داند بپرسد یا صبر کند.",
        "evidence": ("۲۰۲۶-۰۷-۲۵ ساعت ۲۲:۰۳ دستورِ /live بی‌جواب ماند چون در handlers "
                     "نبود → return None. یک شبانه‌روز نامرئی."),
        "enforced_by": "live_commands._quiet_* (بازگشت \"\" → نسخهٔ کامل) · approval_channel._stream_route → DM",
    },
    {
        "id": "D7-busy-not-stupid",
        "rule": "وقتی نفهمیدن از نرسیدن به مغز است، همان را بگو — نه «متوجه نشدم».",
        "why": "«متوجه نشدم» به مالک می‌گوید بات کودن است، درحالی‌که حقیقت «مشغولم» است.",
        "evidence": "OLLAMA_MIN_INTERVAL_S زنده ۲۰ ثانیه؛ پیامِ دومِ مالک در آن پنجره بی‌صدا سقوط می‌کرد.",
        "enforced_by": "telegram_center.center._ask_unknown_card(brain_busy)",
    },
    {
        "id": "D8-effect-not-flag",
        "rule": "هرگز «انجام شد» نگو مگر یک اثرِ قابلِ‌مشاهده داشته باشی که اگر ادعا غلط بود فرق می‌کرد.",
        "why": "فلگ، فایلِ config و تابعِ *_ready() هیچ‌کدام مشاهده نیستند.",
        "evidence": ("‏card_delivery_ready()=(True,'ok') بود و کارت شکست می‌خورد؛ "
                     "produce()=no-defect از لایه‌ای که ۵ از ۶ چشمش کور بود."),
        "enforced_by": "—",
    },
    {
        "id": "D9-actor-is-clicker",
        "rule": "کنشگرِ یک کلیک همیشه cbq['from'] است، هرگز فرستندهٔ کارت.",
        "why": "پیامِ ضمیمهٔ دکمه را خودِ بات فرستاده؛ from آن همیشه بات است.",
        "evidence": ("جدولِ rfc_decision در کلِ تاریخِ سیستم صفر ردیف داشت. علتش این بود. "
                     "بعد از فیکس: دو رأی در ۱۲:۳۸:۵۴ و ۱۳:۲۶:۵۷."),
        "enforced_by": "tests/test_tg_callback_actor.py",
    },
    {
        "id": "D10-where-it-goes",
        "rule": ("تصمیم → DM (کانالِ کمیابِ توجه). جریانِ محیطی → تاپیکِ خودش. "
                 "قلب=system · مغز=knowledge · چشم=cartographer · هر بیزنس=بازوی خودش."),
        "why": "جریانِ محیطی در DM، کانالِ تصمیم را می‌بلعد.",
        "evidence": ("‏approval_channel صفر message_thread_id داشت، پس ۶ تابعِ beat فیزیکاً "
                     "فقط به DM می‌نوشتند و ۹ تاپیک خالی می‌ماند."),
        "enforced_by": "approval_channel._STREAM_TOPIC + send_text(stream=…)",
    },
    {
        "id": "D11-one-decision",
        "rule": "یک تصمیم در هر کارت، با پیشنهادِ صریح — و «نه» باید به‌همان‌اندازه ارزان باشد که «آره».",
        "why": "شروعِ کار سخت‌ترین قدم است؛ توصیهٔ بی‌تقارن به فشار تبدیل می‌شود.",
        "evidence": ("گفتهٔ صریحِ مالک ۲۰۲۶-۰۷-۲۵ (OWNER-STATED)؛ card_render "
                     "دکمه‌های نامتقارن را ساختاراً رد می‌کند تا توصیه به فشار بدل نشود."),
        "enforced_by": "tg/card_render (چکِ تقارنِ برچسبِ دکمه)",
    },
    {
        "id": "D12-disagree-once",
        "rule": "مخالفتت را یک‌بار، ساده و با دلیل بگو؛ بعد کاری را که خواست انجام بده و فرضت را بنویس.",
        "why": "مالک به صراحت خوب جواب می‌دهد و به این‌دست‌آن‌دست‌کردن بد.",
        "evidence": ("قاعدهٔ صریحِ مالک، تکرارشده در چند جلسه (OWNER-STATED). "
                     "مشاهدهٔ ۲۰۲۶-۰۷-۲۶: هر بار که مخالفتم را یک‌بار و صریح گفتم و "
                     "بعد کار را انجام دادم، جلسه جلو رفت."),
        "enforced_by": "—",
    },
]

# ── بخشِ ماشین‌چک‌شدنی ────────────────────────────────────────────────────────
_DURATION = re.compile(r"\d+\s*(ساعت|دقیقه|روز|hour|hours|day|days|min|h|d)\b", re.I)
_BACKREF = re.compile(r"(همان\s*(پیام|کارت)ِ?\s*قبل|پیامِ قبلی|مثلِ قبل|as (before|above))", re.I)


def check(text: str, *, is_decision: bool = False) -> list:
    """قاعده‌های نقض‌شده را برمی‌گرداند. لیستِ خالی = پاس.

    فقط بخشی از دکترین ماشین‌چک‌شدنی است؛ بقیه قرارداد است. این تابع هرگز
    استثنا نمی‌دهد و هرگز متن را عوض نمی‌کند — قضاوت می‌کند، سانسور نمی‌کند."""
    t = str(text or "")
    bad = []
    if _DURATION.search(t):
        bad.append("D3-weekday")
    if _BACKREF.search(t):
        bad.append("D2-no-backref")
    if is_decision and "نکنی" not in t and "اگر کاری نکنی" not in t:
        bad.append("D1-stake")
    if not t.strip():
        bad.append("D6-never-silence")
    return bad


def for_snapshot() -> dict:
    """شکلِ فشرده برای تزریق به `doctor.self_knowledge.snapshot()`.

    عمداً کوتاه: این وارد promptِ مغز می‌شود و طولش هزینه دارد. فقط قاعده و
    شناسه — «چرا» و شاهدش در همین فایل می‌ماند و برای انسان است."""
    return {
        "version": VERSION,
        "updated": UPDATED,
        "bottleneck": PROFILE["bottleneck"],
        "rules": [f"{d['id']}: {d['rule']}" for d in DOCTRINE],
        "unenforced": [d["id"] for d in DOCTRINE if d["enforced_by"] == "—"],
    }


def card() -> str:
    """کارتِ خواندنی برای خودِ مالک — «فکر می‌کنی چطور باید با من حرف بزنی؟»"""
    n_enf = sum(1 for d in DOCTRINE if d["enforced_by"] != "—")
    lines = [f"🧭 <b>چطور باید با تو حرف بزنم</b> (نسخهٔ {VERSION} · {UPDATED})", "",
             f"▸ {len(DOCTRINE)} قاعده — {n_enf} تایش ماشینی چک می‌شود، "
             f"{len(DOCTRINE)-n_enf} تایش هنوز فقط قرارداد است", ""]
    for d in DOCTRINE:
        mark = "🔒" if d["enforced_by"] != "—" else "📄"
        lines.append(f"{mark} {d['rule']}")
    lines += ["", "<i>هر قاعده یک شاهدِ واقعی دارد. قاعدهٔ بی‌شاهد حذف می‌شود.</i>"]
    return "\n".join(lines)


if __name__ == "__main__":  # pragma: no cover
    import json
    print(card().replace("<b>", "").replace("</b>", "")
          .replace("<i>", "").replace("</i>", ""))
    print()
    print(json.dumps(for_snapshot(), ensure_ascii=False, indent=1))
