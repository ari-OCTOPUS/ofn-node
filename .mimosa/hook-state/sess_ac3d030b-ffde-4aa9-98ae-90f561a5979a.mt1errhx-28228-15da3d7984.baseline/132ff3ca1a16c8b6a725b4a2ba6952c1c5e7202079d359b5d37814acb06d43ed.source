# .github/workflows/ci-brushline.yml
# CI/CD pipeline for Brushline — place this file in the brushline repo at .github/workflows/ci.yml
#
# Trigger: push to main branch
# Pipeline: test → gitleaks → build → push to GHCR → SSH deploy → health-check → rollback
#
# Required GitHub Secrets (repo Settings → Secrets → Actions):
#   ANTHROPIC_API_KEY   — for integration tests (use a test-budget key)
#   DEPLOY_SSH_KEY      — private SSH key for deploy@vps
#   DEPLOY_HOST         — VPS IP or hostname
#   DEPLOY_USER         — deploy (or your user)
#   GHCR_TOKEN          — GitHub PAT with packages:read + packages:write

name: CI/CD — Brushline

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository_owner }}/brushline

jobs:
  # ── Job 1: Test ──────────────────────────────────────────────────────────
  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run tests (offline — no real API calls)
        run: |
          python -m pytest tests/ -v \
            --tb=short \
            -k "not integration" \
            --timeout=60
        env:
          # Offline tests mock the API; these placeholders prevent config.validate() from failing
          ANTHROPIC_API_KEY: "sk-test-offline"
          TELEGRAM_BOT_TOKEN: "0000000000:placeholder"
          ALLOWED_OPERATOR_CHAT_IDS: "123456789"
          SERPER_API_KEY: "test-key"

      - name: AST syntax check
        run: python -m py_compile main.py src/*.py

  # ── Job 2: Secret scan ───────────────────────────────────────────────────
  secret-scan:
    name: Secret scan (gitleaks)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # full history for gitleaks

      - name: Run gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}  # required for org repos; omit for personal

  # ── Job 3: Build + Push image ────────────────────────────────────────────
  build:
    name: Build & push image
    needs: [test, secret-scan]
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'   # only build on main push, not PRs
    outputs:
      image_tag: ${{ steps.meta.outputs.tags }}
      image_digest: ${{ steps.build.outputs.digest }}

    steps:
      - uses: actions/checkout@v4

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GHCR_TOKEN }}

      - name: Extract metadata (tags, labels)
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=sha,prefix=sha-
            type=raw,value=latest

      - name: Build and push
        id: build
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ── Job 4: Deploy ────────────────────────────────────────────────────────
  deploy:
    name: Deploy to VPS
    needs: [build]
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'

    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          script: |
            set -e

            # Ensure stackctl is available
            STACKCTL="/opt/infra-control/stackctl"
            if [ ! -f "$STACKCTL" ]; then
              echo "ERROR: stackctl not found at $STACKCTL"
              exit 1
            fi

            # Update the brushline repo (pull latest code for local builds / env file)
            cd /opt/projects/brushline
            git fetch origin main
            git reset --hard origin/main

            # Log in to GHCR to pull the new image
            echo "${{ secrets.GHCR_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin

            # Deploy (pull image → up → health-check → rollback if unhealthy)
            python3 "$STACKCTL" deploy brushline

      - name: Notify Telegram on success
        if: success()
        uses: appleboy/telegram-action@v0.1.1
        with:
          to: ${{ secrets.TELEGRAM_CHAT_ID }}
          token: ${{ secrets.CONTROL_BOT_TOKEN }}
          message: |
            ✅ Brushline deployed successfully
            Commit: ${{ github.sha }}
            By: ${{ github.actor }}

      - name: Notify Telegram on failure
        if: failure()
        uses: appleboy/telegram-action@v0.1.1
        with:
          to: ${{ secrets.TELEGRAM_CHAT_ID }}
          token: ${{ secrets.CONTROL_BOT_TOKEN }}
          message: |
            ❌ Brushline deploy FAILED — rolled back
            Commit: ${{ github.sha }}
            By: ${{ github.actor }}
            Check: https://github.com/${{ github.repository }}/actions
