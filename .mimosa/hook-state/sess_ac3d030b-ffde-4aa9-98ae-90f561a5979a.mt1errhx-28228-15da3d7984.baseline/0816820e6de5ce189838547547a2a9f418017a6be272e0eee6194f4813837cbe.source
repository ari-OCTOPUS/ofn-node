#!/usr/bin/env bash
# ============================================================================
# deploy.sh — راه‌اندازیِ LANGAR روی سرور (یا لپ‌تاپ) + تست‌های دود (smoke)
# اجرا:  bash deploy.sh
# پیش‌نیاز: Docker + Docker Compose نصب و روشن باشند.
# امن: هیچ کلیدِ واقعی چاپ نمی‌کند؛ قبل از کارِ مخرب چیزی پاک نمی‌کند.
# ============================================================================
set -euo pipefail

COMPOSE_FILE="docker-compose.unified.yml"
cd "$(dirname "$0")"

echo "── مرحله ۰: بررسی ───────────────────────────────"
command -v docker >/dev/null || { echo "❌ Docker نصب نیست. اول نصبش کن."; exit 1; }
docker compose version >/dev/null 2>&1 || { echo "❌ Docker Compose نیست."; exit 1; }
docker version >/dev/null 2>&1 || { echo "❌ Docker engine روشن نیست. Docker Desktop را باز کن."; exit 1; }
[ -f "$COMPOSE_FILE" ] || { echo "❌ $COMPOSE_FILE پیدا نشد."; exit 1; }
echo "✅ Docker آماده است."

echo "── مرحله ۱: .env ────────────────────────────────"
if [ ! -f .env ]; then
  cp .env.example .env
  echo "⚠️  .env ساخته شد. حالا این خط‌ها را پر کن، بعد دوباره اجرا کن:"
  echo "    BOT_TOKEN, OWNER_ID, POSTGRES_PASSWORD (و همان رمز در DATABASE_URL)"
  exit 0
fi
# گاردریلِ ساده: مطمئن شو placeholderها عوض شده‌اند (بدونِ چاپِ مقدار)
if grep -qE '^(BOT_TOKEN|OWNER_ID|POSTGRES_PASSWORD)=(توکن|آیدی|یک_رمز|$)' .env; then
  echo "❌ هنوز بعضی مقادیرِ .env پیش‌فرض‌اند. اول پرشان کن."
  exit 1
fi
echo "✅ .env آماده است."

echo "── مرحله ۲: بالا آوردنِ استک ─────────────────────"
docker compose -f "$COMPOSE_FILE" up -d --build

echo "── مرحله ۳: انتظار برای سلامتِ سرویس‌ها ───────────"
ok=0
for i in $(seq 1 30); do
  if curl -fsS http://localhost:8000/health >/dev/null 2>&1; then ok=1; break; fi
  sleep 2
done

echo "── مرحله ۴: تست‌های دود ──────────────────────────"
up=$(docker compose -f "$COMPOSE_FILE" ps --services --filter "status=running" | wc -l)
echo "سرویس‌های در حالِ اجرا: $up/4"
docker compose -f "$COMPOSE_FILE" ps
if [ "$ok" = "1" ]; then
  echo "✅ /health = ok"
else
  # P2 fail-closed (G-02 fix): سلامتِ ناموفق = شکستِ deploy، نه warning.
  echo "❌ /health بعد از ۶۰ ثانیه جواب نداد → deploy ناموفق. استک پایین می‌آید."
  echo "   لاگ: docker compose -f $COMPOSE_FILE logs api"
  docker compose -f "$COMPOSE_FILE" down
  exit 1
fi

echo
echo "تستِ دستی در تلگرام:  /start · /menu · /halt → /resume · /research · /ailab"
echo "توقفِ فوریِ همه‌چیز:   docker compose -f $COMPOSE_FILE down"
