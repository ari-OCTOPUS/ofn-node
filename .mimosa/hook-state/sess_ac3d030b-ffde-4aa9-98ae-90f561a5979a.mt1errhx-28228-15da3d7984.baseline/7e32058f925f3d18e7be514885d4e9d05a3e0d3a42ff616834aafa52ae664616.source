"""
spine/pipeline.py -- Spine.run(event): the end-to-end river.

    INPUT -> PERCEIVE -> ROUTE(tier) -> GATE(kill*budget*permit) ->
    BRAIN.ask -> GROUND(held-out) -> GUARD(policy*panel) ->
    RECORD(ledger append + hash-chain) -> OWNER-GATE -> OUTPUT

Every stage is a small Spine method decorated with @trace_span("name")
(mirrors the `@trace("reasoning")` pattern applied to BrainRouter.route in
AI-sume/langar/brain/brain_router.py, which imports `trace` from
`observability`): entry and exit are ALWAYS appended to the ledger as one
record each, so the ledger IS the trace -- there is no separate log file.

A stage that must stop the river raises the internal `_Halt` control-flow
exception. `Spine.run()` is the ONLY place that catches it (and, as a
safety net, any other exception) and turns it into
`{"status": "halted", ...}`. That is the fail-closed contract this module
exists to prove: kill/budget/permit/ground/guard/owner failures always come
back as a halted *result*, never as an exception escaping run().

GATE(kill*budget*permit) and GUARD(policy*panel) are each split into their
named sub-checks (gate.kill / gate.budget / gate.permit and guard.policy /
guard.panel) so each seam gets its own ledger span, per the build spec's
own "(kill*budget*permit)" / "(policy*panel)" breakdown -- this does not
reorder the river, it just makes the composite stages individually
traceable.

OWNER-GATE is only consulted for actions the triggering Event marks
`external=True` in its payload; purely internal actions skip it (see
gates.FakeOwnerGate.approve).
"""
from __future__ import annotations

import functools
import time
from dataclasses import dataclass, field
from typing import Any, Callable

from .events import Event
from .gates import (
    Brain,
    BudgetExceeded,
    BudgetGate,
    FakeBrain,
    FakeBudgetGate,
    FakeGrounder,
    FakeGuard,
    FakeKillGate,
    FakeOwnerGate,
    FakePermitGate,
    FakeRouter,
    Grounder,
    Guard,
    KillGate,
    KillTripped,
    OwnerGate,
    PermitGate,
    Router,
)
from .ledger import Ledger

STATUS_FINALIZED = "finalized"
STATUS_HALTED = "halted"


class _Halt(Exception):
    """Internal control-flow signal: 'stop the river here.' Always caught
    inside Spine.run(); never leaks past the public API."""

    def __init__(self, stage: str, reason: str):
        super().__init__(reason)
        self.stage = stage
        self.reason = reason


def trace_span(name: str) -> Callable:
    """Stage decorator -- mirrors brain_router.py's `@trace("reasoning")`
    (`from observability import trace`). Wraps a Spine stage method so ONE
    ledger record is appended on entry and ONE on exit (success, halt, or
    error), with whatever small dict the stage method returns folded into
    the exit record for observability."""

    def deco(fn: Callable) -> Callable:
        @functools.wraps(fn)
        def wrapper(self: "Spine", ctx: dict, *a: Any, **kw: Any) -> Any:
            actor = ctx["event"].actor
            t0 = time.time()
            self._span(f"stage:{name}", actor, {"stage": name, "phase": "enter"})
            ctx["trace"].append({"stage": name, "phase": "enter"})
            status = "ok"
            extra: dict = {}
            try:
                result = fn(self, ctx, *a, **kw)
                if isinstance(result, dict):
                    extra = result
                return result
            except _Halt as h:
                status = f"halt:{h.reason}"
                raise
            except Exception as e:  # re-raised after recording -- see run()
                status = f"error:{e}"
                raise
            finally:
                ms = round((time.time() - t0) * 1000, 3)
                exit_rec = {"stage": name, "phase": "exit", "status": status, "ms": ms, **extra}
                self._span(f"stage:{name}", actor, exit_rec)
                ctx["trace"].append(exit_rec)

        return wrapper

    return deco


@dataclass
class Spine:
    """Composes one adapter per seam (see gates.py) into the river. Every
    field is a Protocol from gates.py; swapping a Fake* for a real
    kernel/killswitch/budget/provider/panel adapter later means changing
    the constructor call, not this class."""

    ledger: Ledger
    kill: KillGate
    budget: BudgetGate
    permit: PermitGate
    brain: Brain
    grounder: Grounder
    guard: Guard
    owner: OwnerGate
    router: Router = field(default_factory=FakeRouter)

    @staticmethod
    def wire_fakes(ledger_path: Any, **overrides: Any) -> "Spine":
        """Convenience constructor: every seam backed by its deterministic,
        fail-closed fake. `overrides` lets a caller (typically a test) swap
        any single seam -- e.g. a pre-tripped kill gate, a zero-budget
        gate, a grounder seeded with specific held-out facts -- without
        hand-wiring the other seven."""
        defaults: dict = dict(
            ledger=Ledger(ledger_path),
            kill=FakeKillGate(),
            budget=FakeBudgetGate(),
            permit=FakePermitGate(),
            brain=FakeBrain(),
            grounder=FakeGrounder(),
            guard=FakeGuard(),
            owner=FakeOwnerGate(),
            router=FakeRouter(),
        )
        defaults.update(overrides)
        return Spine(**defaults)

    def _span(self, kind: str, actor: str, data: dict) -> dict:
        return self.ledger.append(kind=kind, actor=actor, data=data)

    # ------------------------------------------------------------------ #
    # River stages -- one method per named stage, in exact river order.
    # ------------------------------------------------------------------ #

    @trace_span("input")
    def _input(self, ctx: dict) -> dict:
        event: Event = ctx["event"]
        ctx["actor"] = event.actor
        ctx["action_name"] = str(event.payload.get("action", event.kind))
        ctx["external"] = bool(event.payload.get("external", False))
        return {"event_id": event.id, "kind": event.kind}

    @trace_span("perceive")
    def _perceive(self, ctx: dict) -> dict:
        event: Event = ctx["event"]
        ctx["task_text"] = str(event.payload.get("task", ""))
        ctx["claims"] = event.payload.get("claims", [])
        return {"task_len": len(ctx["task_text"]), "n_claims": len(ctx["claims"])}

    @trace_span("route")
    def _route(self, ctx: dict) -> dict:
        risk = bool(ctx["event"].payload.get("risk", False))
        route = self.router.route(ctx["task_text"], risk=risk)
        ctx["route"] = route
        ctx["agent_key"] = f"{ctx['actor']}:{route.depth}"
        return {"depth": route.depth, "model_tier": route.model_tier, "downgraded": route.downgraded}

    @trace_span("gate.kill")
    def _gate_kill(self, ctx: dict) -> None:
        try:
            self.kill.check()
        except KillTripped as e:
            raise _Halt("gate.kill", str(e)) from e

    @trace_span("gate.budget")
    def _gate_budget(self, ctx: dict) -> None:
        try:
            self.budget.precheck(ctx["agent_key"])
        except BudgetExceeded as e:
            raise _Halt("gate.budget", str(e)) from e

    @trace_span("gate.permit")
    def _gate_permit(self, ctx: dict) -> None:
        # permit() reserves intent; consume() re-validates right before
        # actuation (replay/expiry/STOP) -- both real Kernel verbs, called
        # back-to-back here because this synchronous river has no separate
        # later moment to defer consume() to.
        res = self.permit.permit(ctx["action_name"], ctx["actor"])
        if not res.get("ok"):
            raise _Halt("gate.permit", res.get("reason", "permit denied"))
        token = res.get("token")
        consumed = self.permit.consume(token)
        if not consumed.get("ok"):
            raise _Halt("gate.permit", consumed.get("reason", "permit consume denied"))
        ctx["permit_token"] = token

    @trace_span("brain.ask")
    def _brain_ask(self, ctx: dict) -> dict:
        event: Event = ctx["event"]
        if not self.brain.is_available():
            raise _Halt("brain.ask", "brain provider unavailable")
        context = {
            "claim_subject": event.payload.get("claim_subject", ""),
            "claim_value": event.payload.get("claim_value", ""),
            "hedge": event.payload.get("hedge", True),
            "task": ctx["task_text"],
        }
        system_prompt = f"depth={ctx['route'].depth} tier={ctx['route'].model_tier}"
        answer = self.brain.ask(system_prompt, context)
        try:
            cost = self.budget.record(ctx["agent_key"],
                                      input_tokens=len(system_prompt.split()),
                                      output_tokens=len(answer.split()))
        except BudgetExceeded as e:
            raise _Halt("brain.ask", f"post-spend budget breach: {e}") from e
        ctx["answer"] = answer
        return {"answer_len": len(answer), "cost_usd": cost}

    @trace_span("ground")
    def _ground(self, ctx: dict) -> dict:
        res = self.grounder.ground(ctx["claims"], ctx["actor"])
        ctx["ground_result"] = res
        if not res.get("ok"):
            raise _Halt("ground", f"ungrounded claim(s): {res.get('bad')}")
        return {"grounding_ratio": res.get("grounding_ratio")}

    @trace_span("guard.policy")
    def _guard_policy(self, ctx: dict) -> dict:
        ok, reason = self.guard.check_output(ctx["answer"])
        if not ok:
            raise _Halt("guard.policy", reason)
        return {"policy_reason": reason}

    @trace_span("guard.panel")
    def _guard_panel(self, ctx: dict) -> dict:
        res = self.guard.review_panel(ctx["answer"])
        ctx["panel_result"] = res
        if not res.get("approved"):
            raise _Halt("guard.panel", f"panel decision={res.get('decision')}")
        return {"decision": res.get("decision"), "yes": res.get("yes"), "total": res.get("total")}

    @trace_span("record")
    def _record(self, ctx: dict) -> dict:
        rec = self._span("finalized_claim", ctx["actor"], {
            "event_id": ctx["event"].id,
            "answer": ctx["answer"],
            "grounding_ratio": ctx["ground_result"].get("grounding_ratio"),
            "panel_decision": ctx["panel_result"].get("decision"),
        })
        ctx["ledger_sig"] = rec["sig"]
        return {"ledger_sig": rec["sig"]}

    @trace_span("owner_gate")
    def _owner_gate(self, ctx: dict) -> dict:
        res = self.owner.approve(ctx["action_name"], ctx["actor"], ctx["external"])
        if not res.get("ok"):
            raise _Halt("owner_gate", res.get("reason", "owner approval denied"))
        return {"external": ctx["external"]}

    @trace_span("output")
    def _output(self, ctx: dict) -> dict:
        return {"status": STATUS_FINALIZED, "output_len": len(ctx["answer"])}

    # ------------------------------------------------------------------ #
    # Public API
    # ------------------------------------------------------------------ #

    def run(self, event: Event) -> dict:
        """Walk the river for one Event. Always returns a dict -- never
        raises. `status` is "finalized" or "halted"."""
        ctx: dict = {"event": event, "trace": []}
        try:
            self._input(ctx)
            self._perceive(ctx)
            self._route(ctx)
            self._gate_kill(ctx)
            self._gate_budget(ctx)
            self._gate_permit(ctx)
            self._brain_ask(ctx)
            self._ground(ctx)
            self._guard_policy(ctx)
            self._guard_panel(ctx)
            self._record(ctx)
            self._owner_gate(ctx)
            self._output(ctx)
        except _Halt as h:
            self._span("halted", ctx.get("actor", event.actor), {"stage": h.stage, "reason": h.reason})
            ctx["trace"].append({"stage": h.stage, "phase": "halt", "reason": h.reason})
            return {"status": STATUS_HALTED, "reason": f"{h.stage}: {h.reason}",
                    "output": None, "trace": ctx["trace"]}
        except Exception as e:  # fail-closed safety net: nothing escapes run()
            self._span("halted", ctx.get("actor", event.actor), {"stage": "internal_error", "reason": str(e)})
            ctx["trace"].append({"stage": "internal_error", "phase": "halt", "reason": str(e)})
            return {"status": STATUS_HALTED, "reason": f"internal_error: {e}",
                    "output": None, "trace": ctx["trace"]}

        return {
            "status": STATUS_FINALIZED,
            "reason": "ok",
            "output": ctx["answer"],
            "trace": ctx["trace"],
        }
