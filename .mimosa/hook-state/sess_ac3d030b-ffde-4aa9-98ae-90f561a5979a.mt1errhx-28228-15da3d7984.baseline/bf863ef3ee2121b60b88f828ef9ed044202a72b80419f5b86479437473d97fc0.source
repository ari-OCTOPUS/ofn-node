# _ops/backup/backup_selftest.py — اثباتِ منطقِ backup/restore بدونِ ویندوز (portable)
import sqlite3, tempfile, os, shutil
d = tempfile.mkdtemp(); src = os.path.join(d, "langar.db")
c = sqlite3.connect(src); c.execute("create table t(x)"); c.execute("insert into t values(42)")
c.commit(); c.execute("PRAGMA wal_checkpoint(TRUNCATE)"); c.close()
bak = os.path.join(d, "backup"); os.makedirs(bak); shutil.copy(src, os.path.join(bak, "langar.db"))
r = os.path.join(d, "restore"); os.makedirs(r); shutil.copy(os.path.join(bak, "langar.db"), os.path.join(r, "langar.db"))
conn = sqlite3.connect(os.path.join(r, "langar.db"))
ok = conn.execute("PRAGMA integrity_check").fetchone()[0]
n = conn.execute("select x from t").fetchone()[0]; conn.close()
assert ok == "ok" and n == 42, (ok, n)
print(f"OK M5 backup/restore self-test: integrity={ok}, value={n}")
