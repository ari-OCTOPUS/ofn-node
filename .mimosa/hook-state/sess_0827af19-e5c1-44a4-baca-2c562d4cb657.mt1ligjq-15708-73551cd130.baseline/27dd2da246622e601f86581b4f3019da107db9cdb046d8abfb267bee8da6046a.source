# tests/test_memory_recall.py — موتورِ حافظه (L3) با نرمال‌سازیِ فارسیِ اصلاح‌شده. Portable.
import os, sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from core.memory import MemorySystem

class FakeDB:
    def recent_reflections(self, n): return [
        {"id":1,"question":"q","answer":"بعد از دویدن آرام‌تر بودم و خوابم بهتر شد","domain":"health","ts":"1"},
        {"id":2,"question":"q","answer":"قهوهٔ بعدازظهر باعث بی‌خوابی شد","domain":"health","ts":"2"},
        {"id":3,"question":"q","answer":"جلسات طولانی تمرکزم را می‌شکنند","domain":"work","ts":"3"}]
    def recent_logs(self, n): return [{"id":10,"note":"استرس بالا قبل از ددلاین","ts":"4"}]

def _hit(q, expect):
    h = MemorySystem(FakeDB()).search_semantic(q, k=1)
    assert h and expect in h[0].text, (q, h)

def test_coffee():  _hit("خواب و قهوه", "قهوه")
def test_focus():   _hit("تمرکز در کار", "تمرکز")
def test_stress():  _hit("استرس ددلاین", "ددلاین")

if __name__ == "__main__":
    for n,f in sorted(globals().items()):
        if n.startswith("test_") and callable(f): f(); print(f"  ✅ {n}")
    print("موتورِ حافظه: همه سبز")
