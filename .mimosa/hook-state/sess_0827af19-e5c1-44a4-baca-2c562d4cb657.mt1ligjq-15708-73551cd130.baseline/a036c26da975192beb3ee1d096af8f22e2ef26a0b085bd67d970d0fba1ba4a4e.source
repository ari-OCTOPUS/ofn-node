"""
constitution.py — ۱۴ قانونِ آهنینِ LANGAR به‌عنوان یک لایه‌ی critique.

خالص و قاعده‌محور (بدونِ LLM، بدونِ db). در pipelineِ HumanCore، خروجیِ هر
سؤال/پیام قبل از ارسال از critique() می‌گذرد. اگر ناقضِ قانون باشد → compliant=False
و بر اساسِ «قانونِ ۱: در شک، سکوت»، HumanCore به سؤالِ امنِ آفلاین برمی‌گردد.

محافظه‌کارانه طراحی شده تا false-positive کم باشد (سؤال‌های عادی نباید بلاک شوند).
"""

from __future__ import annotations

import re
from dataclasses import dataclass, field

PRINCIPLES = [
    "در شک: سکوت",
    "RMSSD شاخصِ قفل‌شده است",
    "verdict برگشت‌ناپذیر است",
    "همبستگی ≠ علیت",
    "ادعاها تگِ قطعیت [E]/[S]/[P] بگیرند",
    "پزشک نیستیم — تشخیص/تجویز ممنوع",
    "تقویتِ نشخوارِ منفی ممنوع",
    "عادی‌سازیِ خودتخریبی ممنوع",
    "صداقتِ N-of-1",
    "حوزه‌ی مهندسی هفتگی",
    "خودبهبود شفاف",
    "تغییرِ خودکار فقط وزن، نه prompt/کد",
    "حفظِ حریمِ خصوصی (owner-only)",
    "تناسبِ ارتباط (کوتاه و به‌جا)",
]

# نرمال‌سازی: حذفِ اعرابِ عربی/فارسی و یکدست‌کردنِ ی/ک تا regex روی متنِ تمیز کار کند
_DIACRITICS = re.compile(r"[ً-ْٰـ]")


def _norm(s: str) -> str:
    s = s.translate({0x064A: 0x06CC, 0x0643: 0x06A9})  # ي→ی ، ك→ک
    return _DIACRITICS.sub("", s)


# الگوهای ناقض — روی متنِ نرمال‌شده، محافظه‌کارانه و فقط مواردِ واضح
_MEDICAL = re.compile(r"(تجویز|تشخیص\s*می|بیماری.{0,12}داری|قرص.{0,8}بخور|دارو.{0,8}بخور|دوز\s*دارو|دوز.{0,8}(زیاد|کم|ببر|بالا|پایین)|قطعِ?\s*دارو)")
_CAUSAL = re.compile(r"(باعث.{1,30}(شد|می‌شود|شده)|علت.{1,20}(است|بود))")
_HEDGE = re.compile(r"(شاید|ممکن|احتمال|نشانه|همبستگی|به\s*نظر|گویا|علیت نیست)")
_RUMINATION = re.compile(r"(چرا همیشه|چرا هیچ\s*وقت|بدترین\s*آدم|همیشه شکست|هیچ\s*وقت موفق)")
_SELF_HARM_OK = re.compile(r"(اشکالی ندارد.{0,15}(آسیب|زخم|گرسنه)|طبیعی است.{0,15}(نخوری|نخوابی))")

# قانون ۵: ادعای قطعی باید تگِ قطعیت [E]/[S]/[P] داشته باشد (محافظه‌کارانه: فقط ادعای صریحِ قطعی)
_CERTAINTY_TAG = re.compile(r"\[[ESP]\]")
_STRONG_CLAIM = re.compile(r"(قطعا|حتما|بدون\s*شک|بی‌شک|صد\s*در\s*صد|۱۰۰\s*درصد|قطعی\s*است|مسلما|بی‌چون\s*و\s*چرا)")
# قانون ۱۴: تناسبِ ارتباط (کوتاه و به‌جا) — سقفِ طولِ محافظه‌کارانه
_MAX_LEN = 1200


@dataclass
class Critique:
    compliant: bool = True
    violations: list[str] = field(default_factory=list)


def critique(text: str, context: dict | None = None) -> Critique:
    """متن را در برابرِ قوانین می‌سنجد."""
    c = Critique()
    if not text or not text.strip():
        c.compliant = False
        c.violations.append("متنِ خالی")
        return c
    t = _norm(text)

    if _MEDICAL.search(t):
        c.violations.append("قانون ۶: ادعای پزشکی")
    # علیت بدونِ احتیاط
    if _CAUSAL.search(t) and not _HEDGE.search(t):
        c.violations.append("قانون ۴: ادعای علیت بدونِ احتیاط")
    if _RUMINATION.search(t):
        c.violations.append("قانون ۷: تقویتِ نشخوارِ منفی")
    if _SELF_HARM_OK.search(t):
        c.violations.append("قانون ۸: عادی‌سازیِ خودتخریبی")
    # قانون ۵: ادعای قطعی بدونِ تگِ قطعیت
    if _STRONG_CLAIM.search(t) and not _CERTAINTY_TAG.search(t):
        c.violations.append("قانون ۵: ادعای قطعی بدونِ تگِ قطعیت [E]/[S]/[P]")
    # قانون ۱۴: تناسبِ ارتباط — خروجیِ بیش از حد بلند
    if len(text.strip()) > _MAX_LEN:
        c.violations.append("قانون ۱۴: نقضِ تناسبِ ارتباط (بیش از حد بلند)")

    c.compliant = not c.violations
    return c


def is_compliant(text: str, context: dict | None = None) -> bool:
    return critique(text, context).compliant
