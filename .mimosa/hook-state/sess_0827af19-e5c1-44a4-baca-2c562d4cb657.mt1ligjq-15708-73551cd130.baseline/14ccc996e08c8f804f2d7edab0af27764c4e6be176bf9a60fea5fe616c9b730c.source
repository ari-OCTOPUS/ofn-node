"""
ai.py — موتورِ سؤالِ روزانه‌ی مغزِ دومِ LANGAR.

دو حالت:
  • با CLAUDE_KEY → سؤالِ پویا از Claude، سوار بر context واقعیِ داده‌ها.
  • بدون کلید → بانکِ سؤالِ آفلاینِ چرخشی (privacy-first، بدونِ هزینه).
هر خطایی در مسیرِ API → سقوطِ نرم به حالتِ آفلاین. بات هرگز به‌خاطرِ AI نمی‌خوابد.
"""

from __future__ import annotations

import datetime as _dt
import statistics

import db

# حوزه‌های کارگاه — کلید: (برچسبِ فارسی، بانکِ سؤالِ آفلاین)
DOMAINS: dict[str, dict] = {
    "body": {
        "label": "بدن / HRV",
        "q": [
            "امروز بدنت کجا بیشترین تنش را نگه داشته، و یک کارِ ۲ دقیقه‌ای برای رهاکردنش چیست؟",
            "اگر فقط یک متغیر را این هفته ثابت می‌کردی (خواب، کافئین، یا زمانِ مصرف) تا اثرش بر RMSSD را ببینی، کدام؟",
            "آخرین باری که صبح واقعاً سرحال بیدار شدی شب قبلش چه فرق داشت؟",
        ],
    },
    "mind": {
        "label": "ذهن / هیجان",
        "q": [
            "یک فکری که امروز بیش از حد ذهنت را گرفت چه بود، و چقدرش واقعیت بود و چقدرش روایت؟",
            "اگر هیجانِ امروزت یک پیام داشت، آن پیام چه می‌خواست به تو بگوید؟",
            "چه چیزی امروز انرژی‌ات را بُرد بی‌آنکه متوجه شوی؟",
        ],
    },
    "relations": {
        "label": "رابطه‌ها / ارتباط",
        "q": [
            "در آخرین گفت‌وگوی مهمت، چه چیزی را نگفتی که باید می‌گفتی؟",
            "امروز با چه کسی می‌توانستی صادق‌تر باشی، و چه چیزی جلویت را گرفت؟",
            "یک نفر که برایت مهم است این هفته چه چیزی از تو لازم دارد که هنوز ندادی؟",
        ],
    },
    "work": {
        "label": "کار / مهندسی",
        "q": [
            "در نحوه‌ی کار کردنت با AI/سیستم، چه چیزی این هفته کند یا مبهم بود و چطور تیزترش می‌کنی؟",
            "کدام کارِ نیمه‌تمام بیشترین انرژیِ ذهنی‌ات را پنهانی مصرف می‌کند؟",
            "اگر فقط یک ساعتِ عمیق امروز داشتی، روی چه چیزی می‌گذاشتی‌اش — و چرا آن را نمی‌گذاری؟",
        ],
    },
    "meaning": {
        "label": "معنا / جهت",
        "q": [
            "این هفته چه کاری کردی که واقعاً «خودت» بود، نه آنچه از تو انتظار می‌رفت؟",
            "اگر شش ماهِ دیگر به امروز نگاه کنی، دلت می‌خواهد چه تصمیمی را گرفته باشی؟",
            "چه چیزی را داری به تعویق می‌اندازی که در عمق می‌دانی مهم است؟",
        ],
    },
    "habits": {
        "label": "عادت‌ها / محیط",
        "q": [
            "کدام عادتِ کوچک امروز بی‌سروصدا به نفعت کار کرد، و چطور تقویتش کنی؟",
            "یک تغییرِ کوچک در محیطت (میز، گوشی، خواب) چه اصطکاکی را کم می‌کند؟",
            "چه چیزی را اگر شب قبل آماده می‌کردی، صبحت ۱۰ دقیقه آرام‌تر می‌شد؟",
        ],
    },
}

_ORDER = list(DOMAINS.keys())

DEFAULT_SYSTEM = (
    "تو تسهیلگرِ یک کارگاهِ خصوصیِ N-of-1 هستی. هر بار فقط یک سؤالِ دقیق، کوتاه و "
    "قابلِ‌پاسخ بپرس که سوار بر داده‌ی کاربر باشد. خروجی فارسی و دقیقاً در این قالب:\n"
    "🧭 حوزه: <حوزه>\n❓ <یک سؤال>\nچرا امروز: <یک جمله>\n"
    "با تعریف شروع نکن. پزشک نیستی؛ تشخیص/تجویز نده. نشخوارِ منفی را تقویت نکن؛ "
    "اگر نشانه‌ی پریشانیِ جدی دیدی، با مهربانی به صحبت با یک انسانِ مورد‌اعتماد دعوت کن."
)


# ----------------------------------------------------------------------
# انتخابِ حوزه — متوازن (کم‌پوشش‌ترین حوزه، با چرخشِ روزانه برای تنوع)
# ----------------------------------------------------------------------

def pick_domain(database=db) -> str:
    counts = database.domain_counts()
    # کم‌ترین پوششِ فعلی
    min_c = min(counts.get(k, 0) for k in _ORDER)
    candidates = [k for k in _ORDER if counts.get(k, 0) == min_c]
    # tie-break با روزِ سال تا هر روز یکی فرق کند
    idx = _dt.date.today().toordinal() % len(candidates)
    return candidates[idx]


# ----------------------------------------------------------------------
# ساختِ context از داده‌ها (همان چیزی که به مغز داده می‌شود)
# ----------------------------------------------------------------------

def build_context(database=db) -> str:
    parts: list[str] = []

    t = database.trend(7)
    if t["count_rmssd"]:
        line = f"RMSSD ۷روزه: میانگین {t['mean_rmssd']:.0f} ms از {t['count_rmssd']} رکورد"
        if t["corr_sleep"] is not None:
            line += f"؛ همبستگی با خواب {t['corr_sleep']:+.2f}"
        if t["corr_used"] is not None:
            line += f"؛ با مصرف {t['corr_used']:+.2f}"
        parts.append(line)
    else:
        parts.append("هنوز داده‌ی RMSSD کافی نیست.")

    today = _dt.date.today().isoformat()
    due = database.insights_due(today)
    if due:
        parts.append(
            "بینش‌های درحال‌داوریِ امروز: "
            + " | ".join(f"[{r['tag']}] {r['content']}" for r in due[:3])
        )

    refs = database.recent_reflections(3)
    if refs:
        parts.append(
            "آخرین بازتاب‌ها: "
            + " || ".join(
                f"({r['domain']}) {(r['answer'] or '')[:80]}" for r in refs
            )
        )

    return "\n".join(parts)


# ----------------------------------------------------------------------
# سؤالِ آفلاین (بدونِ API)
# ----------------------------------------------------------------------

def offline_question(domain: str, database=db) -> str:
    bank = DOMAINS[domain]["q"]
    # چرخش بر اساسِ تعداد کلِ بازتاب‌ها تا تکراری نشود
    total = sum(database.domain_counts().values())
    return bank[total % len(bank)]


def _offline_why(domain: str, database=db) -> str:
    t = database.trend(7)
    if domain == "body" and t["count_rmssd"]:
        return f"میانگینِ RMSSD اخیرت {t['mean_rmssd']:.0f} ms بوده؛ وقتِ یک تنظیمِ کوچک است."
    return "برای اینکه کارگاه یک‌بُعدی نشود، امروز این حوزه نوبتش است."


# ----------------------------------------------------------------------
# سؤالِ پویا از Claude (اختیاری)
# ----------------------------------------------------------------------

def _claude_question(system_prompt, context, domain, label, api_key, model) -> str:
    # importِ تنبل تا اگر کتابخانه نصب نباشد، حالتِ آفلاین آسیب نبیند
    from anthropic import Anthropic

    client = Anthropic(api_key=api_key)
    user = (
        f"حوزه‌ی امروز: {label} ({domain})\n\n"
        f"context داده‌های کاربر:\n{context}\n\n"
        "طبق قالب، فقط یک سؤالِ امروز را بده."
    )
    resp = client.messages.create(
        model=model,
        max_tokens=300,
        system=system_prompt,
        messages=[{"role": "user", "content": user}],
    )
    # جمع‌کردنِ متنِ پاسخ
    out = "".join(
        block.text for block in resp.content if getattr(block, "type", "") == "text"
    ).strip()
    if not out:
        raise RuntimeError("پاسخِ خالی از مدل")
    return out


# ----------------------------------------------------------------------
# نقطه‌ی ورودیِ اصلی
# ----------------------------------------------------------------------

def daily_question(
    database=db,
    api_key: str | None = None,
    model: str | None = None,
    system_prompt: str | None = None,
    budget=None,                       # G-06: BudgetManager اختیاری — متر/enforce خرج
    cheap_model: str | None = None,    # G-05: ردهٔ ارزان (پیش‌فرضِ haiku)
    strong_model: str | None = None,   # G-05: ردهٔ قوی (اختیاری)
    allow_strong: bool = True,
) -> dict:
    """
    خروجی: {domain, label, text, source}
      text  : پیامِ آماده برای ارسال به کاربر
      source: 'claude' یا 'offline'
    G-06: اگر budget داده شود، پیش از خرج سقفِ سراسری enforce و پس از خرج مصرف ثبت می‌شود.
    G-05: اگر model صریح نباشد، ردهٔ مدل با BrainRouter انتخاب می‌شود (نه استاتیک).
    """
    domain = pick_domain(database)
    label = DOMAINS[domain]["label"]

    if api_key:
        try:
            # G-06: fail-closed سراسری — اگر سقفِ ماهانه پر باشد یا بودجه نباشد → آفلاین
            if budget is not None:
                budget.enforce("daily_question")          # BudgetHalted → except → آفلاین
                if not budget.can_spend():
                    raise RuntimeError("budget: سقفِ روزانه/ماهانه پر — degrade به آفلاین")
            context = build_context(database)
            # G-05: انتخابِ ردهٔ مدل با BrainRouter (نه رشتهٔ ثابت)
            chosen = model
            if chosen is None:
                from brain.brain_router import pick_model
                chosen, _route = pick_model(
                    f"{label}: {context}",
                    cheap_model=cheap_model or "claude-haiku-4-5-20251001",
                    strong_model=strong_model, budget=budget, allow_strong=allow_strong)
            text = _claude_question(
                system_prompt or DEFAULT_SYSTEM, context, domain, label, api_key, chosen,
            )
            # G-06: ثبتِ مصرف پس از خرج (پوششِ حسابداریِ مسیرِ سؤالِ روزانه)
            if budget is not None:
                budget.record_text(chosen, (system_prompt or DEFAULT_SYSTEM) + "\n" + context,
                                   text, "daily_question")
            return {"domain": domain, "label": label, "text": text, "source": "claude"}
        except Exception:
            pass  # سقوطِ نرم به آفلاین

    q = offline_question(domain, database)
    text = f"🧭 حوزه: {label}\n❓ {q}\nچرا امروز: {_offline_why(domain, database)}"
    return {"domain": domain, "label": label, "text": text, "source": "offline"}
