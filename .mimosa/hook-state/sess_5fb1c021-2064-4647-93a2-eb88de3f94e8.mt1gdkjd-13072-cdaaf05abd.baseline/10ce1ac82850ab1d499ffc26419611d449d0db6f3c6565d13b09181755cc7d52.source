from pathlib import Path
import hashlib

p = Path(r"F:\backup\_ops\OCTOPUS-flags.cmd")
raw = p.read_bytes()
text = raw.decode("utf-8", errors="replace")
# Normalize to CRLF only
text = text.replace("\r\n", "\n").replace("\r", "\n").replace("\n", "\r\n")
p.write_bytes(text.encode("utf-8"))
new = p.read_bytes()
print({
    "len": len(new),
    "has_crlf": b"\r\n" in new,
    "lone_lf": b"\n" in new.replace(b"\r\n", b""),
    "sha": hashlib.sha256(new).hexdigest(),
})
