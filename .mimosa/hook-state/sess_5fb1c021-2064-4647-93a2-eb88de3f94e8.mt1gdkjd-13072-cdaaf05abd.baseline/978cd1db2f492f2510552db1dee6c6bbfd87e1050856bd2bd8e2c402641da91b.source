"""پروژهٔ نمونه — یک کارگرِ کوچک که فقط زنده می‌ماند، تا خودِ مغزِ کنترل را
بدون نیاز به هیچ پروژهٔ واقعی یا رمز تلگرام بتوانی تست کنی."""
import sys
import time

print("پروژهٔ نمونه روشن شد.", flush=True)
try:
    while True:
        time.sleep(2)
except KeyboardInterrupt:
    print("پروژهٔ نمونه خاموش شد.", flush=True)
    sys.exit(0)
