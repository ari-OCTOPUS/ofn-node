      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "Write(**/.git/**)",
      "Edit(**/.git/**)",
      "Write(**/_code/**)",
      "Edit(**/_code/**)",
      "Write(_Archive/**)",
      "Edit(_Archive/**)",
      "Edit(_Duplicates/**)",
      "Read(**/.env)",
      "Read(**/*wallet*)",
      "Read(**/*seed*)",
      "Read(**/*secret*)"
    ]
  }
