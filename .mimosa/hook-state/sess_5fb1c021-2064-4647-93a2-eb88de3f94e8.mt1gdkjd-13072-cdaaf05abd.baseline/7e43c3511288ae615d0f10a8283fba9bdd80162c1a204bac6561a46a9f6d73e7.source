"""
hitl.py — چک‌لیست #۲ و #۶: انسان در حلقه (Human-In-The-Loop approval gate).

قبل از هر اقدام «حساس» (config.HITL_REQUIRED_FOR)، سیستم مکث می‌کند و از انسان
تأیید می‌خواهد. انسان همیشه بالاتر از تصمیمِ ایجنت است (override / escalation).

برای تست خودکار می‌توان یک تابع approver تزریق کرد (مثلاً همیشه «نه» بگوید)
بدون نیاز به ورودی دستی.
"""
from __future__ import annotations
from typing import Callable

import config


class HITLGate:
    def __init__(self, approver: Callable[[str, dict], bool] | None = None, audit=None):
        # approver پیش‌فرض = پرسش واقعی از انسان روی کنسول
        self.approver = approver or self._console_approver
        self.audit = audit

    def requires_approval(self, action: str) -> bool:
        return action in config.HITL_REQUIRED_FOR

    def request(self, action: str, context: dict) -> bool:
        """دروازه‌ی تأیید. True یعنی انسان اجازه داد."""
        if self.audit:
            self.audit.log("hitl_request", "human-gate", action=action, **context)
        approved = self.approver(action, context)
        if self.audit:
            self.audit.log("hitl_decision", "human-gate", action=action, approved=approved)
        return approved

    @staticmethod
    def _console_approver(action: str, context: dict) -> bool:
        import sys as _sys
        # فیکس (canon human_above + fail-closed): اگر ترمینالِ تعاملی نیست،
        # به‌جای بلاک‌شدن/کرشِ input() اقدامِ حساس را «رد» کن.
        if not getattr(_sys, "stdin", None) or not _sys.stdin.isatty():
            print(f"\u26d4 HITL بدونِ ترمینالِ تعاملی برای «{action}» → رد (fail-closed)")
            return False
        print("\n" + "=" * 60)
        print(f"⏸️  مکث برای تأیید انسانی — اقدام حساس: «{action}»")
        for k, v in context.items():
            v = str(v)
            print(f"     {k}: {v if len(v) <= 200 else v[:200] + '…'}")
        print("=" * 60)
        ans = input("  تأیید می‌کنی؟ [y = بله / هر چیز دیگر = نه]: ").strip().lower()
        return ans in {"y", "yes", "بله", "آره"}
