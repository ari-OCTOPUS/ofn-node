"""
spine/ledger.py -- append-only JSONL ledger with a SHA-256 hash chain.

Mirrors the tamper-evidence contract of
07 - Knowledge/genome-system/ledger/ledger.py: every record stores the hash
of the previous record ("prev") plus a hash of its own canonical body
("sig"); verify() recomputes the chain from scratch and returns False the
instant either the chain link or a record's own hash no longer matches --
which is exactly what a silent edit to history would break.

Deliberately simpler than genome's ledger.py: no age_tick/heart-arrow, no
cross-process O_EXCL lock, no EVENT_TYPES allowlist -- this is a minimal,
self-contained mirror of the *hashing contract*, not a fork of the genome
ledger (which is never imported or modified here; this file has zero
dependency on it). A real backing store can later replace this class as
long as it keeps append()/verify()'s shape.

Pure stdlib, deterministic, offline.
"""
from __future__ import annotations

import hashlib
import json
import os
import threading
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterator

GENESIS = "0" * 64  # same sentinel value as genome's ledger.py


def _canonical(obj: dict) -> bytes:
    """Deterministic JSON encoding -- same recipe as genome's ledger.py
    `_canonical()`: sorted keys, compact separators, no ASCII-escaping, so
    the exact same body always hashes to the exact same digest."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


@dataclass
class Ledger:
    """Append-only, tamper-evident event ledger (JSONL + SHA-256 hash
    chain). This is the ONLY place spine/pipeline.py durably records what
    happened; every stage of the river appends exactly one record here."""

    path: Path
    _lock: threading.Lock = field(default_factory=threading.Lock, init=False, repr=False)
    _last_hash: str = field(default=GENESIS, init=False, repr=False)

    def __post_init__(self) -> None:
        self.path = Path(self.path)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self._last_hash = self._tail_hash()

    def _tail_hash(self) -> str:
        """Re-derive the true chain head from disk (cheap for the small,
        offline ledgers this module targets)."""
        last = GENESIS
        if not self.path.exists():
            return last
        with open(self.path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue  # tolerate a torn last line, same as genome's reader
                last = rec.get("sig", last)
        return last

    def append(self, kind: str, actor: str, data: dict) -> dict:
        """Append one record. Returns the full stored record (including its
        own `sig`), matching Kernel.audit()'s "hand back proof of the
        write" shape."""
        with self._lock:
            prev = self._tail_hash()  # re-read true tail under the lock
            body = {
                "id": uuid.uuid4().hex,
                "ts": time.time(),
                "kind": kind,
                "actor": actor,
                "data": data,
                "prev": prev,
            }
            sig = hashlib.sha256(_canonical(body)).hexdigest()
            record = {**body, "sig": sig}
            with open(self.path, "a", encoding="utf-8") as fh:
                fh.write(json.dumps(record, ensure_ascii=False) + "\n")
                fh.flush()
                os.fsync(fh.fileno())
            self._last_hash = sig
            return record

    def iter_records(self) -> Iterator[dict]:
        if not self.path.exists():
            return
        with open(self.path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue  # tolerate a torn last line rather than crash readers

    def tail(self, n: int = 20) -> list:
        return list(self.iter_records())[-n:]

    def verify(self) -> tuple:
        """Recompute the chain from GENESIS.

        Returns (True, "ok (<n> records)") if every record's `prev` matches
        the previous record's `sig` AND every record's `sig` matches its
        own recomputed hash. Returns (False, <reason>) at the FIRST record
        that fails either check -- exactly the shape genome's
        ledger.verify() uses to detect a silent edit to history.
        """
        prev = GENESIS
        n = 0
        for i, rec in enumerate(self.iter_records(), 1):
            body = {k: rec[k] for k in ("id", "ts", "kind", "actor", "data", "prev") if k in rec}
            recomputed = hashlib.sha256(_canonical(body)).hexdigest()
            if rec.get("prev") != prev:
                return False, f"chain break at record {i}: prev mismatch"
            if rec.get("sig") != recomputed:
                return False, f"tamper detected at record {i}: sig mismatch"
            prev = rec["sig"]
            n += 1
        return True, f"ok ({n} records)"


if __name__ == "__main__":
    import sys

    p = sys.argv[1] if len(sys.argv) > 1 else "ledger.jsonl"
    lg = Ledger(Path(p))
    ok, msg = lg.verify()
    print(("OK: " if ok else "FAIL: ") + msg)
    sys.exit(0 if ok else 1)
