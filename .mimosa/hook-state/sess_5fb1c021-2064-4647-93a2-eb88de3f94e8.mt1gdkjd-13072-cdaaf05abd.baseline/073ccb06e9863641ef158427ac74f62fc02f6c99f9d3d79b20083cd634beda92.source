"""test_llm_permit.py — G-10(2): callِ واقعیِ LLM باید از permitِ کرنل عبور کند."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from src.llm import LLMClient, LLMResult
from igk.client import PermitDenied

results = []
def check(n, c): results.append((n, c)); print(f"  {'✅' if c else '❌'} {n}")

class GateAllow:
    def act(self, action, fn, *a, **k):
        assert action == "llm_call"; return fn(*a, **k)
class GateDeny:
    def act(self, action, fn, *a, **k): raise PermitDenied("بدونِ permit")
class Boom:
    def act(self, *a, **k): raise AssertionError("gate نباید در MOCK صدا شود")

class _Msg:
    class _U: input_tokens = 5; output_tokens = 7
    def __init__(self):
        self.content = [type("B", (), {"type": "text", "text": "سلام"})()]
        self.usage = _Msg._U()
class _Anthropic:
    class messages:
        @staticmethod
        def create(**k): return _Msg()

def live(gate):
    c = LLMClient(gate=gate); c.mock = False; c._client = _Anthropic(); return c

r = live(GateAllow()).complete("Researcher", "x")
check("۱: callِ واقعیِ LLM با permit عبور می‌کند", isinstance(r, LLMResult) and r.text == "سلام")

blocked = False
try: live(GateDeny()).complete("Researcher", "x")
except PermitDenied: blocked = True
check("۲: callِ واقعیِ LLM بدونِ permit رد می‌شود (fail-closed)", blocked)

rm = LLMClient(gate=Boom()).complete("Researcher", "x")  # no key → mock
check("۳: در MOCK مسیرِ permit دور زده می‌شود (بدونِ هزینه)", rm.mock is True)

print("\n" + "=" * 50); ok = sum(1 for _, c in results if c)
print(f"نتیجه: {ok}/{len(results)} سبز"); sys.exit(0 if ok == len(results) else 1)
