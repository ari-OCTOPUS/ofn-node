"""
brain_router.py — انتخابِ عمقِ استدلال و ردهٔ مدل (BrainRouter).

طبقِ چشم‌اندازِ Unified Agent Prompt (بخش ۳): «کِی نَب، کِی عمیق».
کارِ ساده را با مدلِ ارزان و بدونِ حلقه انجام بده؛ هزینه را الکی نسوزان.

  • simple      → پاسخِ مستقیم، مدلِ ارزان، بدونِ حلقه.
  • react       → کارِ ابزارمحور/چندمرحله‌ای (reason↔act↔observe).
  • plan        → کارِ بلند با وابستگی (اول plan، بعد اجرا، با امکانِ replan).
  • deliberate  → تصمیمِ پرریسک/فضای راه‌حلِ بزرگ → مدلِ قوی، جستجوی عمیق.

خالص و قاعده‌محور (بدونِ LLM، تست‌پذیر). budget تزریق‌پذیر است تا وقتی بودجه کم است،
به‌صورتِ امن downgrade کند (fail-degraded، نه fail-closed). هیچ side-effectی ندارد.
"""

from __future__ import annotations

import re
from dataclasses import dataclass

from observability import trace

# ردهٔ عمق به ترتیبِ هزینه (برای downgrade)
DEPTHS = ["simple", "react", "plan", "deliberate"]

# نشانه‌های زبانی (فارسی/انگلیسی) برای هر رده — محافظه‌کارانه
_TOOL = re.compile(r"(جستجو|سرچ|search|منبع|source|پژوهش|research|web|لینک|url|قیمت|اخبار)", re.I)
_PLAN = re.compile(r"(چند\s*مرحله|قدم\s*به\s*قدم|پروژه|بساز|پیاده|implement|build|plan|طراحی|refactor|migrat)", re.I)
_DELIB = re.compile(r"(تصمیم|سرمایه|ریسک|خرید|بفروش|trade|invest|استراتژی|strategy|مقایسه.*گزینه|trade-?off|architecture)", re.I)
_HARD = re.compile(r"(چرا|تحلیل کن|اثبات|prove|why|deep|عمیق|دقیق بررسی)", re.I)


@dataclass
class Route:
    depth: str            # simple | react | plan | deliberate
    model_tier: str       # cheap | strong
    use_loop: bool        # آیا حلقه‌ی استدلال لازم است
    reason: str           # توضیحِ شفاف (برای audit/observability)
    downgraded: bool = False


def classify_depth(task: str, risk: bool = False) -> str:
    """رده‌ی عمق را از متنِ task استنتاج می‌کند."""
    t = task or ""
    if risk or _DELIB.search(t):
        return "deliberate"
    if _PLAN.search(t) or len(t) > 600:
        return "plan"
    if _TOOL.search(t):
        return "react"
    if _HARD.search(t) and len(t) > 120:
        return "react"
    return "simple"


class BrainRouter:
    def __init__(self, budget=None, allow_strong: bool = True):
        """
        budget: شیئی با can_spend()->bool (مثلِ BudgetManager). اگر None، بودجه نامحدود فرض می‌شود.
        allow_strong: اگر False، هرگز ردهٔ strong انتخاب نمی‌شود (مثلِ حالتِ کاملاً آفلاین).
        """
        self.budget = budget
        self.allow_strong = allow_strong

    def _budget_ok(self) -> bool:
        if self.budget is None:
            return True
        try:
            return bool(self.budget.can_spend())
        except Exception:
            return True  # observability/بودجه هرگز جریانِ اصلی را نمی‌شکند

    @trace("reasoning")  # M6/G-08: spanِ انتخابِ عمقِ استدلال
    def route(self, task: str, risk: bool = False) -> Route:
        depth = classify_depth(task, risk=risk)
        wants_strong = depth in ("plan", "deliberate")
        downgraded = False
        reason = f"depth={depth} از روی نشانه‌های task"

        # downgrade امن وقتی بودجه کم است یا مدلِ قوی مجاز نیست
        if wants_strong and (not self._budget_ok() or not self.allow_strong):
            old = depth
            depth = "react" if depth == "plan" else "plan"
            wants_strong = depth in ("plan", "deliberate") and self.allow_strong and self._budget_ok()
            downgraded = True
            reason += f" → downgrade {old}→{depth} (بودجه/آفلاین)"

        tier = "strong" if (wants_strong and self.allow_strong and self._budget_ok()) else "cheap"
        use_loop = depth != "simple"
        return Route(depth=depth, model_tier=tier, use_loop=use_loop,
                     reason=reason, downgraded=downgraded)

def pick_model(task, *, cheap_model, strong_model=None, budget=None,
               allow_strong=True, risk=False):
    """G-05: نگاشتِ tier→modelِ بودجه‌آگاه با BrainRouter. خالص و بدونِ side-effect.
    خروجی: (model_name, Route). اگر strong_model نباشد یا بودجه کم باشد → مدلِ ارزان."""
    r = BrainRouter(budget=budget,
                    allow_strong=allow_strong and bool(strong_model)).route(task, risk=risk)
    model = strong_model if (r.model_tier == "strong" and strong_model) else cheap_model
    return model, r
