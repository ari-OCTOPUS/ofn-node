# repo name های کاملاً generic
GENERIC_REPO_NAMES: set[str] = {
    "test", "demo", "example", "sample", "template", "boilerplate",
    "readme", "profile", "config",
}

# COIN_POSITIVE_SIGNALS — اگه description این کلمات رو داشت، احتمالاً کوینه
# این برای جلوگیری از false positive در فیلتر ابزار استفاده می‌شه
COIN_SIGNALS: list[str] = [
    "cryptocurrency", "proof-of-work", "pow coin", "blockchain network",
    "genesis block", "mainnet launch", "fair launch", "no premine",
    "block reward", "mining reward", "coin supply",
    "quantum resistant", "post-quantum",
]


def is_blocklisted(algorithm: str) -> bool:
    """آیا الگوریتم در blocklist (ASIC/GPU only) هست؟"""
    if not algorithm:
        return False
    algo_lower = algorithm.lower().strip()
    return any(bad in algo_lower for bad in BLOCKLIST_KEYWORDS)


def is_tool_not_coin(coin: CandidateCoin) -> bool:
    """
    تشخیص اینکه repo یه ابزار mining یا چیز غیرمرتبطه، نه کوین جدید.

    سه لایه چک:
      1. اگه NAME ریپو حاوی کلمات ابزار بود → رد
      2. اگه DESCRIPTION حاوی توضیحات ابزار بود → رد (مگه coin signal داشته باشه)
      3. اگه description خالی و stars=0 → رد (spam/empty repo)
    """
    desc = (coin.extra.get("description") or "").lower()
    name_lower = coin.coin_name.lower()

    # لایه ۱: چک NAME — مستقیم‌ترین سیگنال
    for tool_kw in TOOL_NAME_KEYWORDS:
        if tool_kw in name_lower:
            return True

    # لایه ۲: اگه description سیگنال مثبت کوین داره، نگهش دار
    has_coin_signal = any(sig in desc for sig in COIN_SIGNALS)
    if has_coin_signal:
        return False  # احتمالاً یه کوین واقعیه

    # لایه ۲: چک DESCRIPTION برای کلمات ابزار
    for indicator in TOOL_DESC_INDICATORS:
        if indicator in desc:
            return True

    # لایه ۳: repo های generic
    if name_lower in GENERIC_REPO_NAMES:
        return True

    # لایه ۳: description خالی + stars=0 = احتمالاً spam/empty
    stars = coin.extra.get("stars", 0)
    if not desc and isinstance(stars, (int, float)) and stars == 0:
        return True

    return False


def survival_filter(coin: CandidateCoin) -> tuple[bool, str]:
    """
    تصمیم بقا — کوین زنده‌ست یا dead/scam/tool؟
    """
    if not coin.coin_name or coin.coin_name.strip() == "":
        return False, "missing coin_name"
    if not coin.ann_url or not coin.ann_url.startswith(("http://", "https://")):
        return False, "invalid ann_url"
    if is_blocklisted(coin.algorithm):
        return False, f"blocklisted algo: {coin.algorithm}"
    if coin.volume_usd < 0:
        return False, "corrupted volume"
    # فیلتر ابزار (فقط برای GitHub source)
    if coin.source == "github" and is_tool_not_coin(coin):
        return False, "tool/infrastructure repo, not a coin"
    return True, "ok"


# ════════════════════════════════════════════════════════════════════════════
# منبع ۱: GitHub
# ════════════════════════════════════════════════════════════════════════════
def fetch_from_github() -> list[CandidateCoin]:
    """جستجو در GitHub برای repo های mining جدید."""
    results: list[CandidateCoin] = []
    if not GITHUB_TOKEN or GITHUB_TOKEN.startswith("PASTE_"):
        logger.warning("GitHub PAT تنظیم نشده — رد می‌شه")
        return results

    since = (datetime.now(timezone.utc) - timedelta(days=21)).strftime("%Y-%m-%d")

    # ─────────────────────────────────────────────────────────────────────
    # درس از اجرای اول: query های قدیمی (`topic:randomx`) repo های
    # ابزار (xmrig, CorvusMiner) رو می‌آوردن، نه کوین.
    #
    # رویکرد جدید:
    #   - از GitHub operator `-` برای exclude کردن ابزارها استفاده کن
    #   - "cryptocurrency" یا "blockchain" رو اضافه کن تا coin project ها بیان
    #   - پنجره زمانی رو از 14 به 21 روز گسترش دادیم تا بیشتر پیدا کنه
    # ─────────────────────────────────────────────────────────────────────
    queries = [
        # کوین‌های randomx — با exclude کردن miner و proxy
        f"randomx cryptocurrency pushed:>{since} -miner -proxy -stratum -pool",
        # کوین‌های randomx که topic دارن (معمولاً اگه dev حرفه‌ای باشه tag می‌زنه)
        f"topic:randomx topic:cryptocurrency pushed:>{since}",
        # کوین‌های yespower
        f"yespower cryptocurrency pushed:>{since} -miner -proxy",
        # fork های جدید با genesis block (نشانه‌ی واضح یه coin project)
        f"genesis block randomx pushed:>{since} -miner",
        # کوین‌های quantum resistant — niche خوب
        f"quantum-resistant mining randomx pushed:>{since}",
        # ghostrider coins (Raptoreum forks و مشابه)
        f"ghostrider cryptocurrency blockchain pushed:>{since} -miner",
        # کوین‌های جدید با fair launch یا no premine
        f'"fair launch" OR "no premine" randomx pushed:>{since}',
    ]
    headers = {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }

    for q in queries:
        try:
            r = requests.get(
                "https://api.github.com/search/repositories",
                headers=headers,
                params={"q": q, "sort": "updated", "order": "desc", "per_page": 20},
                timeout=REQUEST_TIMEOUT,
            )
            r.raise_for_status()
            for item in r.json().get("items", []):
                name = sanitize_input(item.get("name"))
                if not name:
                    continue

                # حدس الگوریتم از topic ها
                algo = "unknown"
                for topic in (item.get("topics", []) or []):
                    t_lower = str(topic).lower()
                    for known in ALGORITHM_DATABASE:
                        if known in t_lower:
                            algo = known
                            break
                    if algo != "unknown":
                        break

                coin = CandidateCoin(
                    coin_name=name,
                    algorithm=algo,
                    launch_date=sanitize_input(item.get("pushed_at")),
                    ann_url=sanitize_input(item.get("html_url")),
                    regulatory_score=0.5,
                    mineable_on_orangepi=False,
                    source="github",
                    scraped_at=datetime.now(timezone.utc).isoformat(),
                    extra={
                        "stars": int(item.get("stargazers_count", 0) or 0),
                        "description": sanitize_input(item.get("description"), max_length=300),
                        "full_name": sanitize_input(item.get("full_name")),
                    },
                )
                results.append(coin)
            time.sleep(1)
        except requests.RequestException as e:
            logger.error(f"GitHub '{q}' failed: {e}")

    logger.info(f"GitHub: {len(results)} خام")
    return results


# ════════════════════════════════════════════════════════════════════════════
# منبع ۲: CoinGecko
# ════════════════════════════════════════════════════════════════════════════
def fetch_from_coingecko() -> list[CandidateCoin]:
    """
    کوین‌های جدید با proof_type=Proof of Work از CoinGecko.

    چرا تغییر دادیم؟
    - قبلاً از /search/trending استفاده می‌کردیم که Ethereum، Kaspa، Sui
      رو می‌آورد — اینا با CPU ماین نمی‌شن و برای ما بی‌فایده بودن.
    - الان از /coins/markets با فیلتر `proof_type` استفاده می‌کنیم.
      CoinGecko هر کوین رو دسته‌بندی می‌کنه — ما فقط "Proof of Work" می‌خوایم.
    - صفحه دوم و سوم رو هم می‌خونیم تا کوین‌های کوچیک‌تر (small cap)
      که تازه listing شدن رو پیدا کنیم.
    """
    results: list[CandidateCoin] = []
    headers = {}
    if COINGECKO_API_KEY and not COINGECKO_API_KEY.startswith("PASTE_"):
        headers["x-cg-demo-api-key"] = COINGECKO_API_KEY

    # PoW categories در CoinGecko که CPU-relevant هستن
    # ما small-cap ها رو می‌خوایم — page 8-12 از لیست مرتب شده بر اساس market cap
    # (صفحات اول همه BTC, ETH, XMR هستن که mature ان)
    pages_to_check = [8, 9, 10, 11, 12]

    for page in pages_to_check:
        try:
            r = requests.get(
                "https://api.coingecko.com/api/v3/coins/markets",
                headers=headers,
                params={
                    "vs_currency": "usd",
                    "order": "market_cap_asc",   # کوچیک‌ترین‌ها اول — frontier
                    "per_page": 50,
                    "page": page,
                    "sparkline": "false",
                    "price_change_percentage": "7d",
                },
                timeout=REQUEST_TIMEOUT,
            )
            r.raise_for_status()
            coins_list = r.json()
            if not isinstance(coins_list, list):
                break

            for item in coins_list:
                coin_id = sanitize_input(item.get("id"))
                name = sanitize_input(item.get("name"))
                symbol = sanitize_input(item.get("symbol", "")).upper()
                if not coin_id or not name:
                    continue

                # فیلتر اولیه بر اساس market cap — ما small/micro cap می‌خوایم
                mktcap = sanitize_float(item.get("market_cap"))
                if mktcap > 50_000_000:    # بالای ۵۰ میلیون دلار → mature → برای ما نه
                    continue
                if mktcap > 0 and mktcap < 1_000:  # زیر ۱۰۰۰ دلار → احتمالاً dead
                    continue

                # 7d price change بالا → احتمالاً تازه pump شده (frontier signal)
                price_change_7d = sanitize_float(item.get("price_change_percentage_7d_in_currency"))

                coin = CandidateCoin(
                    coin_name=name,
                    algorithm="unknown",   # CoinGecko الگوریتم نمی‌ده — Classifier پر می‌کنه
                    launch_date=datetime.now(timezone.utc).date().isoformat(),
                    ann_url=f"https://www.coingecko.com/en/coins/{coin_id}",
                    regulatory_score=0.55,  # CoinGecko listing = حداقل validation شده
                    mineable_on_orangepi=False,
                    source="coingecko_smallcap",
                    scraped_at=datetime.now(timezone.utc).isoformat(),
                    market_cap_usd=mktcap,
                    extra={
                        "symbol": symbol,
                        "market_cap_usd": mktcap,
                        "price_change_7d_pct": price_change_7d,
                        "current_price_usd": sanitize_float(item.get("current_price")),
                    },
                )
                results.append(coin)

            time.sleep(1.5)  # rate limit — free tier CoinGecko 10-30 req/min
        except requests.RequestException as e:
            logger.error(f"CoinGecko page {page} failed: {e}")
            break

    logger.info(f"CoinGecko small-cap PoW candidates: {len(results)} خام")
    return results


# ════════════════════════════════════════════════════════════════════════════
# منبع ۳: DexScreener
# ════════════════════════════════════════════════════════════════════════════
def fetch_from_dexscreener() -> list[CandidateCoin]:
    """token profiles تازه از DEX."""
    results: list[CandidateCoin] = []
    try:
        r = requests.get(
            "https://api.dexscreener.com/token-profiles/latest/v1",
            timeout=REQUEST_TIMEOUT,
        )
        r.raise_for_status()
        data = r.json()
        items = data if isinstance(data, list) else data.get("profiles", [])

        for item in items:
            if not isinstance(item, dict):
                continue
            token_addr = sanitize_input(item.get("tokenAddress"))
            url_link = sanitize_input(item.get("url"))
            chain_id = sanitize_input(item.get("chainId"))
            if not token_addr:
                continue

            coin = CandidateCoin(
                coin_name=(token_addr[:16] + "...") if len(token_addr) > 16 else token_addr,
                algorithm="unknown",
                launch_date=datetime.now(timezone.utc).date().isoformat(),
                ann_url=url_link or f"https://dexscreener.com/{chain_id}/{token_addr}",
                regulatory_score=0.3,
                mineable_on_orangepi=False,
                source="dexscreener",
                scraped_at=datetime.now(timezone.utc).isoformat(),
                extra={
                    "chain": chain_id,
                    "token_address": token_addr,
                    "description": sanitize_input(item.get("description"), max_length=200),
                },
            )
            results.append(coin)
    except requests.RequestException as e:
        logger.error(f"DexScreener failed: {e}")
    except (ValueError, KeyError) as e:
        logger.error(f"DexScreener parse: {e}")

    logger.info(f"DexScreener: {len(results)} خام")
    return results


# ════════════════════════════════════════════════════════════════════════════
# منبع ۴: Bitcointalk ANN
# ════════════════════════════════════════════════════════════════════════════
def fetch_from_bitcointalk() -> list[CandidateCoin]:
    """
    scrape از Bitcointalk Altcoin Announcements.

    Bitcointalk ساختار HTML‌اش گاهی عوض می‌شه، بنابراین چند selector
    مختلف امتحان می‌کنیم تا اگه یکی fail شد بقیه کار کنن.
    """
    results: list[CandidateCoin] = []
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                     "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.5",
    }
    try:
        r = requests.get(
            "https://bitcointalk.org/index.php?board=159.0",
            headers=headers,
            timeout=REQUEST_TIMEOUT,
        )
        r.raise_for_status()
        soup = BeautifulSoup(r.text, "html.parser")

        # چند selector مختلف — به ترتیب اولویت امتحان می‌شن
        anchors: list = []
        for selector in [
            "td.subject span.middletext a",   # selector قدیمی
            "td.subject a[href*='topic']",     # link های topic
            "td[id^='msg'] a",                 # message cell links
            "span.middletext a",               # middletext fallback
            "a[href*='topic=']",               # هر link با topic= در URL
        ]:
            found = soup.select(selector)
            if found:
                anchors = found
                logger.info(f"Bitcointalk selector '{selector}' → {len(found)} آیتم")
                break

        if not anchors:
            # آخرین تلاش: همه <a> ها که href شون به topic اشاره داره
            anchors = [
                a for a in soup.find_all("a", href=True)
                if "topic=" in a.get("href", "")
            ]
            logger.info(f"Bitcointalk fallback: {len(anchors)} topic link")

        keywords = [
            "cpu", "randomx", "yespower", "argon2", "cryptonight",
            "mineable", "launch", "mainnet", "[ann]", " ann ",
            "pow", "ghostrider", "minotaurx", "verus", "proof-of-work",
        ]

        seen_hrefs: set[str] = set()
        for anchor in anchors[:100]:
            title = sanitize_input(anchor.get_text(strip=True), max_length=200)
            href = sanitize_input(anchor.get("href", ""))

            if not title or len(title) < 5:
                continue
            if not href.startswith("http") or href in seen_hrefs:
                continue
            seen_hrefs.add(href)

            title_lower = title.lower()
            if not any(k in title_lower for k in keywords):
                continue

            algo, _ = detect_algorithm_in_text(title)

            coin = CandidateCoin(
                coin_name=title,
                algorithm=algo,
                launch_date=datetime.now(timezone.utc).date().isoformat(),
                ann_url=href,
                regulatory_score=0.4,
                mineable_on_orangepi=False,
                source="bitcointalk_ann",
                scraped_at=datetime.now(timezone.utc).isoformat(),
            )
            results.append(coin)

    except requests.RequestException as e:
        logger.error(f"Bitcointalk failed: {e}")
    except Exception as e:
        logger.error(f"Bitcointalk parse: {e}")

    logger.info(f"Bitcointalk: {len(results)} خام")
    return results


# ════════════════════════════════════════════════════════════════════════════
# منبع ۵: SoChain (network baseline)
# ════════════════════════════════════════════════════════════════════════════
def fetch_from_sochain() -> list[CandidateCoin]:
    """hashrate شبکه‌های اصلی به‌عنوان baseline."""
    results: list[CandidateCoin] = []
    if not SOCHAIN_API_KEY:
        logger.info("SoChain key نیست — رد می‌شه (اختیاری)")
        return results

    headers = {"API-KEY": SOCHAIN_API_KEY}
    for net in ("BTC", "LTC", "DOGE"):
        try:
            r = requests.get(
                f"https://chain.so/api/v3/network_info/{net}",
                headers=headers,
                timeout=REQUEST_TIMEOUT,
            )
            # 401 = key اشتباه یا plan کافی نیست — بی‌صدا skip کن
            if r.status_code == 401:
                logger.info(f"SoChain {net}: key نامعتبر — رد می‌شه")
                break  # بقیه network ها رو هم skip کن
            r.raise_for_status()
            payload = r.json()
            if payload.get("status") != "success":
                continue
            data = payload.get("data", {})

            baseline = CandidateCoin(
                coin_name=f"BASELINE_{net}",
                algorithm="sha256" if net == "BTC" else "scrypt",
                launch_date="2009-01-03" if net == "BTC" else "2011-10-07",
                ann_url=f"https://chain.so/coin/{net.lower()}",
                regulatory_score=1.0,
                mineable_on_orangepi=False,
                source="sochain_baseline",
                scraped_at=datetime.now(timezone.utc).isoformat(),
                extra={
                    "hashrate": sanitize_input(data.get("hashrate")),
                    "block_count": data.get("block_count"),
                    "note": "reference baseline — NOT a mining target",
                },
            )
            results.append(baseline)
            time.sleep(0.5)
        except requests.RequestException as e:
            logger.error(f"SoChain {net}: {e}")

    logger.info(f"SoChain: {len(results)} baseline")
    return results


# ════════════════════════════════════════════════════════════════════════════
# Ranking — محاسبه‌ی score نهایی
# ════════════════════════════════════════════════════════════════════════════
def compute_rank_score(coin: CandidateCoin) -> float:
    """
    محاسبه‌ی نمره نهایی برای sort.

    Heuristic ها:
      - mineable_on_orangepi → بزرگ‌ترین بوست
      - confidence بالا در classifier → اعتماد بیشتر
      - regulatory_score → سازگار = بهتر
      - source-specific weight: github و bitcointalk_ann اولویت دارن
      - stars در GitHub → community traction
    """
    score = 0.0

    # بنیادی: قابل ماین کردن یا نه
    if coin.mineable_on_orangepi:
        score += 50.0

    # confidence
    score += coin.classifier_confidence * 20.0

    # regulatory
    score += coin.regulatory_score * 10.0

    # source weight
    source_weights = {
        "github": 15.0,
        "bitcointalk_ann": 18.0,  # بالاترین signal برای frontier
        "coingecko_trending": 8.0,
        "dexscreener": 5.0,
        "sochain_baseline": 0.0,  # baseline ها rank ندارن
    }
    score += source_weights.get(coin.source, 0.0)

    # GitHub stars boost — فقط برای کوین‌های واقعی (نه همه repo ها)
    # اگه stars خیلی بالا (>1000) احتمالاً یه ابزار معروفه، نه کوین frontier
    stars = coin.extra.get("stars", 0)
    if isinstance(stars, (int, float)) and 0 < stars < 1000:
        score += min(stars / 20.0, 5.0)   # cap at 5 (قبلاً cap at 10 بود — کمتر تأثیر)
    elif isinstance(stars, (int, float)) and stars >= 1000:
        score -= 5.0  # repo خیلی معروف → احتمالاً ابزاره، نه کوین جدید

    # asic_resistance bonus
    asic_res = coin.extra.get("asic_resistance", "")
    if asic_res == "strong":
        score += 5.0
    elif asic_res == "weak":
        score -= 5.0

    return round(score, 2)


# ════════════════════════════════════════════════════════════════════════════
# Pipeline اصلی
# ════════════════════════════════════════════════════════════════════════════
def deduplicate(candidates: list[CandidateCoin]) -> list[CandidateCoin]:
    """حذف تکراری بر اساس ann_url."""
    seen: set[str] = set()
    unique: list[CandidateCoin] = []
    for c in candidates:
        key = c.ann_url.lower().strip()
        if key and key not in seen:
            seen.add(key)
            unique.append(c)
    return unique


def run_full_pipeline() -> list[dict[str, Any]]:
    """اجرای کامل: fetch → sanitize → survive → classify → rank."""
    logger.info("=" * 70)
    logger.info("🚀 SCOUT + CLASSIFIER PIPELINE STARTED")
    logger.info("=" * 70)

    # مرحله ۱: جمع‌آوری
    all_raw: list[CandidateCoin] = []
    for fetcher in (
        fetch_from_github,
        fetch_from_coingecko,
        fetch_from_dexscreener,
        fetch_from_bitcointalk,
        fetch_from_sochain,
    ):
        try:
            all_raw.extend(fetcher())
        except Exception as e:
            logger.error(f"{fetcher.__name__} crashed: {e}")

    logger.info(f"\n📦 کل خام: {len(all_raw)}")

    # مرحله ۲: Survival Filter
    survivors: list[CandidateCoin] = []
    rejected = 0
    for c in all_raw:
        ok, reason = survival_filter(c)
        if ok:
            survivors.append(c)
        else:
            rejected += 1
    logger.info(f"🛡️  بعد از Survival Filter: {len(survivors)} (رد: {rejected})")

    # مرحله ۳: Deduplicate
    unique = deduplicate(survivors)
    logger.info(f"🔁 بعد از dedupe: {len(unique)}")

    # مرحله ۴: Algorithm Classifier Enrichment
    logger.info(f"\n🧠 شروع Algorithm Classifier (budget: {MAX_README_FETCH} README)...")
    readme_budget = [MAX_README_FETCH]  # list برای mutable reference
    enriched: list[CandidateCoin] = []
    for c in unique:
        enriched.append(enrich_with_classifier(c, readme_budget))

    classified_count = sum(1 for c in enriched if c.algorithm != "unknown")
    mineable_count = sum(1 for c in enriched if c.mineable_on_orangepi)
    logger.info(f"   شناسایی شده: {classified_count}/{len(enriched)}")
    logger.info(f"   قابل ماین روی Orange Pi/laptop: {mineable_count}")

    # مرحله ۵: Ranking
    for c in enriched:
        c.rank_score = compute_rank_score(c)
    enriched.sort(key=lambda x: x.rank_score, reverse=True)

    # بریدن به TOP_N
    top = enriched[:TOP_N_RESULTS]

    return [asdict(c) for c in top]


def print_results(candidates: list[dict[str, Any]]) -> None:
    """
    چاپ مرتب نتایج نهایی.
    از ASCII خالص استفاده می‌کنیم تا با terminal های Windows سازگار باشه.
    """
    sep = "=" * 80
    sep2 = "-" * 80

    print("\n" + sep)
    print(f" TOP {len(candidates)} RANKED CANDIDATES")
    print(sep)

    # جدول خلاصه
    print(f"\n{'#':<4}{'NAME':<35}{'ALGO':<14}{'MINEABLE':<11}{'SCORE':<8}{'SOURCE'}")
    print(sep2)
    for i, c in enumerate(candidates, 1):
        name = c["coin_name"][:33]
        algo = c["algorithm"][:12]
        mineable = "YES" if c["mineable_on_orangepi"] else "no"
        score = c["rank_score"]
        src = c["source"][:18]
        print(f"{i:<4}{name:<35}{algo:<14}{mineable:<11}{score:<8}{src}")

    # JSON کامل
    print("\n" + sep)
    print(" FULL JSON OUTPUT")
    print(sep)
    # ensure_ascii=True برای سازگاری با cp1252 ترمینال ویندوز
    print(json.dumps(candidates, indent=2, ensure_ascii=True))
    print("\n" + sep)
    print(f" DONE -- {len(candidates)} candidates ranked")
    print(sep + "\n")


# ════════════════════════════════════════════════════════════════════════════
# Entry Point
# ════════════════════════════════════════════════════════════════════════════
if __name__ == "__main__":
    results = run_full_pipeline()
    print_results(results)
