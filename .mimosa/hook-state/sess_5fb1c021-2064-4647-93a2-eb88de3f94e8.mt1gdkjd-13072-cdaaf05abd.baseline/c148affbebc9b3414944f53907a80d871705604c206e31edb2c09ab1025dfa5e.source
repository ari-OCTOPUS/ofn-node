# مترادف‌ها برای تشخیص بهتر
ALGORITHM_ALIASES: dict[str, str] = {
    "rx/0": "randomx", "rx-0": "randomx", "rx0": "randomx",
    "monero-pow": "randomx", "monero": "randomx",
    "yespowerr16": "yespower", "yespower-r16": "yespower",
    "cryptonightr": "cryptonight", "cryptonight-r": "cryptonight",
    "cn/r": "cryptonight", "cn": "cryptonight",
    "argon2d": "argon2", "argon2id": "argon2",
    "verus": "verushash", "verushash2": "verushash", "verushash2.2": "verushash",
    "gr": "ghostrider",
}


def classify_coin_algorithm(algorithm_hint: str) -> dict[str, Any]:
    """
    تشخیص الگوریتم از روی یه hint متنی.
    خروجی: dict با کلیدهای mineable_on_orangepi, asic_resistance, ...
    """
    if not algorithm_hint or algorithm_hint == "unknown":
        return {"matched": False, "algorithm": "unknown"}

    algo_lower = algorithm_hint.lower().strip()

    # alias check
    algo_lower = ALGORITHM_ALIASES.get(algo_lower, algo_lower)

    # direct match
    if algo_lower in ALGORITHM_DATABASE:
        result = ALGORITHM_DATABASE[algo_lower].copy()
        result["matched"] = True
        result["algorithm"] = algo_lower
        return result

    # partial/substring match
    for known_algo in ALGORITHM_DATABASE:
        if known_algo in algo_lower or algo_lower in known_algo:
            result = ALGORITHM_DATABASE[known_algo].copy()
            result["matched"] = True
            result["algorithm"] = known_algo
            result["match_type"] = "partial"
            return result

    return {"matched": False, "algorithm": algorithm_hint}


def detect_algorithm_in_text(text: str) -> tuple[str, float]:
    """
    جستجو در یه بلوک متن (مثل README) برای پیدا کردن الگوریتم.
    خروجی: (algorithm_name, confidence)
    confidence: 0.0 (پیدا نشد) → 1.0 (مطمئن)
    """
    if not text:
        return "unknown", 0.0

    text_lower = text.lower()

    # ترتیب اولویت: اول الگوریتم‌های specific، بعد عمومی
    priority_order = [
        "randomx", "yespower", "ghostrider", "verushash", "minotaurx",
        "argon2", "cryptonight", "kheavyhash", "ethash", "etchash",
        "blake3", "sha256", "scrypt",
    ]

    matches: list[tuple[str, int]] = []
    for algo in priority_order:
        # تعداد دفعات ظاهر شدن
        count = len(re.findall(r"\b" + re.escape(algo) + r"\b", text_lower))
        if count > 0:
            matches.append((algo, count))

    if not matches:
        # alias check
        for alias, real in ALGORITHM_ALIASES.items():
            if re.search(r"\b" + re.escape(alias) + r"\b", text_lower):
                return real, 0.6
        return "unknown", 0.0

    # الگوریتمی که بیشترین ظاهر شدن داشته
    matches.sort(key=lambda x: x[1], reverse=True)
    best_algo, count = matches[0]

    # confidence بر اساس تعداد ظاهر شدن
    if count >= 3:
        confidence = 0.9
    elif count == 2:
        confidence = 0.75
    else:
        confidence = 0.6

    return best_algo, confidence


def fetch_github_readme(repo_full_name: str) -> Optional[str]:
    """
    دریافت README یه repo از GitHub API.
    repo_full_name مثل "monero-project/monero"
    """
    if not GITHUB_TOKEN or GITHUB_TOKEN.startswith("PASTE_"):
        return None

    url = f"https://api.github.com/repos/{repo_full_name}/readme"
    headers = {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": "application/vnd.github+json",
    }
    try:
        r = requests.get(url, headers=headers, timeout=REQUEST_TIMEOUT)
        if r.status_code == 404:
            return None
        r.raise_for_status()
        data = r.json()
        content_b64 = data.get("content", "")
        if not content_b64:
            return None
        # README معمولاً base64 encode شده
        decoded = base64.b64decode(content_b64).decode("utf-8", errors="ignore")
        return decoded[:10000]  # محدود به ۱۰ کیلوبایت
    except (requests.RequestException, ValueError, base64.binascii.Error) as e:
        logger.debug(f"README fetch failed for {repo_full_name}: {e}")
        return None


def enrich_with_classifier(coin: CandidateCoin, readme_budget: list[int]) -> CandidateCoin:
    """
    Enrichment اصلی:
      1. اگه الگوریتم unknown باشه و source=github، README رو می‌خونیم
      2. classify_coin_algorithm روی نتیجه اجرا می‌کنیم
      3. mineable_on_orangepi و confidence رو update می‌کنیم
    """
    # اول روی الگوریتم فعلی classify می‌زنیم
    classification = classify_coin_algorithm(coin.algorithm)

    if classification["matched"]:
        coin.algorithm = classification["algorithm"]
        coin.mineable_on_orangepi = bool(classification.get("mineable_on_orangepi", False))
        coin.classifier_confidence = 1.0
        coin.extra["asic_resistance"] = classification.get("asic_resistance", "unknown")
        coin.extra["competitive_pressure"] = classification.get("competitive_pressure", "unknown")
        return coin

    # اگه unknown موند و GitHub source داره، README رو می‌خونیم
    if coin.algorithm == "unknown" and coin.source == "github" and readme_budget[0] > 0:
        # استخراج repo full name از URL
        # https://github.com/owner/repo → owner/repo
        match = re.match(r"https?://github\.com/([^/]+/[^/]+)", coin.ann_url)
        if match:
            repo_name = match.group(1)
            logger.info(f"  📖 خواندن README برای {repo_name} ...")
            readme_budget[0] -= 1
            time.sleep(0.5)  # احترام به rate limit

            readme = fetch_github_readme(repo_name)
            if readme:
                # description هم اضافه کن به متن جستجو
                search_text = readme + "\n" + str(coin.extra.get("description", ""))
                detected_algo, confidence = detect_algorithm_in_text(search_text)

                if detected_algo != "unknown":
                    classification = classify_coin_algorithm(detected_algo)
                    if classification["matched"]:
                        coin.algorithm = classification["algorithm"]
                        coin.mineable_on_orangepi = bool(classification.get("mineable_on_orangepi", False))
                        coin.classifier_confidence = confidence
                        coin.extra["asic_resistance"] = classification.get("asic_resistance", "unknown")
                        coin.extra["competitive_pressure"] = classification.get("competitive_pressure", "unknown")
                        coin.extra["classified_from"] = "readme"
                        return coin

    # اگه هیچی پیدا نشد
    coin.classifier_confidence = 0.0
    return coin


