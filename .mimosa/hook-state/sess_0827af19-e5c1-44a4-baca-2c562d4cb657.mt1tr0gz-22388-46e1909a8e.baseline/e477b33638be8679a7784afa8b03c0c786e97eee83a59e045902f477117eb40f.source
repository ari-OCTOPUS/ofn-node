"""
config.py — تنظیمات مرکزی و «قانون مبنا» به‌صورت کد.
چک‌لیست #۱ (سقف بودجه) و #۴ (دسترسی مقیّد) از همین‌جا اعمال می‌شوند.
"""
from __future__ import annotations
import os

# --- مدل ---
MODEL = "claude-sonnet-4-6"     # مدل پیش‌فرض ارزان/سریع برای MVP
MAX_TOKENS_PER_CALL = 1024

# --- قیمت تقریبی (USD به ازای هر ۱ میلیون توکن) برای cost-accounting ---
# این اعداد فقط برای محاسبه‌ی محلیِ هزینه‌اند؛ در صورت تغییر قیمت به‌روزشان کن.
PRICE_PER_MTOK_INPUT = 3.0
PRICE_PER_MTOK_OUTPUT = 15.0

# --- چک‌لیست #۱: سقف بودجه (هزینه به دلار) ---
GLOBAL_BUDGET_USD = 0.50          # سقف کل یک اجرا
PER_AGENT_BUDGET_USD = {
    "researcher": 0.20,
    "analyst": 0.20,
    "supervisor": 0.10,
    "panel": 0.15,                # چک‌لیست #۵: پنل چندداور
}

# --- چک‌لیست #۱: محدودیت تعداد فراخوانی (rate/step limit) ---
MAX_STEPS = 8                     # سقف کل گام‌های ارکستریتور
MAX_CALLS_PER_AGENT = 3           # سقف فراخوانی مدل برای هر ایجنت (به ازای هر داور هم)

# --- چک‌لیست #۵: بدون نقطه‌ی تصرف واحد → پنل چندداور ---
# تصمیمِ تأیید با رأی‌گیریِ چند داورِ مستقل با نگرش‌های متفاوت گرفته می‌شود؛
# هیچ داوری به‌تنهایی نمی‌تواند تأیید کند. اگر آرا به حد نصاب نرسد ولی نصفه‌نیمه باشد،
# به انسان ارجاع می‌شود (escalation، چک‌لیست #۶).
JUDGES = [("daavar-strict", "strict"),
          ("daavar-lenient", "lenient"),
          ("daavar-balanced", "balanced")]
PANEL_QUORUM = 2                  # حداقل تعداد رأیِ APPROVE برای تأیید

# --- چک‌لیست #۲/#۶: کدام اقدام‌ها «حساس»‌اند و تأیید انسانی لازم دارند ---
HITL_REQUIRED_FOR = {"finalize", "external_write"}

# --- چک‌لیست #۴: ابزارهای مجازِ هر ایجنت (least-privilege / scoped tools) ---
# هیچ ایجنتی به ابزاری خارج از این لیست دسترسی ندارد.
AGENT_ALLOWED_TOOLS = {
    "researcher": {"web_search_mock"},          # فقط جستجو
    "analyst": {"summarize"},                    # فقط تحلیل/خلاصه
    "supervisor": {"approve", "reject", "halt"}, # فقط کنترل
    "panel": set(),                              # داوران ابزاری ندارند
}

# --- مسیر لاگ ممیزی (چک‌لیست #۳) ---
AUDIT_LOG_PATH = os.path.join(os.path.dirname(__file__), "logs", "audit.jsonl")

# --- IGK (فاز ۰/۲): کرنلِ بیرونیِ اجبارکننده ---
USE_IGK = True
IGK_STATE_DIR = os.path.join(os.path.dirname(__file__), "logs", "igk_state")
STOP_FILE = os.path.join(os.path.dirname(__file__), "logs", "STOP")
# اگر True و خروجی با held-out لنگر نخورد، finalize متوقف می‌شود (canon-faithful).
GROUNDING_REQUIRED = os.environ.get("GROUNDING_REQUIRED", "0") == "1"   # Fix-A-done-right: production → GROUNDING_REQUIRED=1

# --- فاز ۳: خوداپدیتیِ پرامپت ---
PROMPTS_PATH = os.path.join(os.path.dirname(__file__), "prompts.json")
MAX_UPDATE_ROUNDS = 4          # سقف دورهای خوداپدیتی (جلوی حلقه‌ی بی‌پایان)
# واژه‌های ممنوع در پرامپت پیشنهادی (گاردریل امنیتی خوداپدیتی):
# سیستم نباید گول بخورد و محافظ‌های خودش را حذف/دور بزند.
FORBIDDEN_IN_PROMPT = [
    "ignore previous", "ignore all previous", "disregard",
    "بی‌توجه به دستور", "دستورهای قبلی را نادیده", "نظارت را دور بزن",
    "بدون تأیید", "kill-switch را غیرفعال", "halt را نادیده",
]

# --- G-26: حالت eval ---
# mock = بدون LLM واقعی → هر keepِ خوداپدیتی فقط provisional است (اثبات نیست).
# live = eval رفتاری روی held-out اجباری می‌شود (fail-closed).
EVAL_MODE = os.environ.get("EVAL_MODE", "mock")

# --- Milestones M1/M3/M8 ---
IGK_REQUIRED = True
SAFE_DEGRADE = True
STRESS_GATED_PROMOTION = os.environ.get("STRESS_GATED_PROMOTION", "0") == "1"  # production → =1
