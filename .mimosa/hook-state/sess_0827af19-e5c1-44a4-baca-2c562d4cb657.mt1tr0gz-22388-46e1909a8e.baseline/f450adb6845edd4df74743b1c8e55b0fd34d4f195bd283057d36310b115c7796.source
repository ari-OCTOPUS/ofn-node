"""
budget.py — مدیریتِ بودجه‌ی API برای AI-Lab (و کلِ مصرفِ LLM).

هزینه را تخمین می‌زند، در جدولِ ai_usage ثبت می‌کند، و قبل از هر کارِ گران
سقفِ روزانه/ماهانه را چک می‌کند. اگر بودجه تمام شد → حالتِ آفلاین/کم‌هزینه.

⚠️ قیمت‌ها تخمینی‌اند (USD به‌ازای هر ۱M توکن) و ممکن است تغییر کنند؛ قابلِ تنظیم.
شمارشِ توکن هم تقریبی است (≈۴ کاراکتر = ۱ توکن) — برای گاردریلِ بودجه کافی است.
"""

from __future__ import annotations

import datetime as _dt

# (input, output) دلار به‌ازای هر یک میلیون توکن — تقریبی.
# کلیدها زیررشته‌ای match می‌شوند؛ ترتیب مهم است (خاص‌تر اول).
PRICES = {
    "offline": (0.0, 0.0),
    "haiku": (0.80, 4.00),
    "sonnet": (3.00, 15.00),
    "gpt-4o-mini": (0.15, 0.60),
    "gpt-4o": (2.50, 10.00),
    "deepseek-reasoner": (0.55, 2.19),
    "deepseek": (0.27, 1.10),
}
_DEFAULT_PRICE = (1.0, 3.0)


def _price_for(model: str):
    m = (model or "").lower()
    for key, p in PRICES.items():
        if key in m:
            return p
    return _DEFAULT_PRICE


def estimate_tokens(text: str) -> int:
    return max(1, len(text or "") // 4)


def estimate_cost(model: str, in_tokens: int, out_tokens: int) -> float:
    pin, pout = _price_for(model)
    return in_tokens / 1_000_000 * pin + out_tokens / 1_000_000 * pout


class BudgetHalted(Exception):
    pass


class BudgetManager:
    def __init__(self, db, daily_usd: float = 1.0, monthly_usd: float = 20.0):
        self.db = db
        self.daily = float(daily_usd)
        self.monthly = float(monthly_usd)

    def record(self, model: str, in_tokens: int, out_tokens: int, command: str = "") -> float:
        cost = estimate_cost(model, in_tokens, out_tokens)
        if self.db is not None:
            try:
                self.db.record_ai_usage(model, in_tokens, out_tokens, round(cost, 6), command)
            except Exception:
                pass
        return cost

    def record_text(self, model: str, prompt: str, output: str, command: str = "") -> float:
        return self.record(model, estimate_tokens(prompt), estimate_tokens(output), command)

    def spent_today(self) -> float:
        d = _dt.date.today().isoformat()
        return self.db.ai_usage_sum(d) if self.db else 0.0

    def spent_month(self) -> float:
        first = _dt.date.today().replace(day=1).isoformat()
        return self.db.ai_usage_sum(first) if self.db else 0.0

    def can_spend(self) -> bool:
        return self.spent_today() < self.daily and self.spent_month() < self.monthly

    # --- M4 (G-06): آلارمِ پلکانی + hard-stop سراسری ---
    def alert_level(self) -> str | None:
        """نسبتِ مصرفِ ماهانه: None / "50%" / "80%" / "100%"."""
        if self.monthly <= 0:
            return None
        r = self.spent_month() / self.monthly
        if r >= 1.0: return "100%"
        if r >= 0.8: return "80%"
        if r >= 0.5: return "50%"
        return None

    def enforce(self, command: str = "") -> None:
        """قبل از هر کارِ گران صدا بزن. اگر سقفِ ماهانه پر شد → halt (fail-closed)."""
        if self.spent_month() >= self.monthly:
            raise BudgetHalted(f"سقفِ ماهانه (${self.monthly}) پر شد — halt خودکار [{command}]")

    def status(self) -> dict:
        return {
            "spent_today": round(self.spent_today(), 4), "daily_limit": self.daily,
            "spent_month": round(self.spent_month(), 4), "monthly_limit": self.monthly,
            "ok": self.can_spend(),
        }
