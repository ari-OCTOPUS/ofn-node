import urllib.request, urllib.error, json, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

env = {}
for line in open(os.path.join(HERE, ".env"), encoding="utf-8"):
    line = line.strip()
    if line and not line.startswith("#") and "=" in line:
        k, v = line.split("=", 1)
        env[k.strip()] = v.strip()
KEY = env.get("OPENAI_KEY", "")
BASE = env.get("OPENAI_BASE_URL", "https://api.sakana.ai/v1")
MODEL = env.get("OPENAI_MODEL", "fugu")

print("=== Sakana Fugu test ===")
print("model:", MODEL, "| key:", (KEY[:5] + "..." + KEY[-4:]) if len(KEY) > 10 else "MISSING")
print()

# --- 1) raw call: connectivity + auth ---
def raw():
    url = BASE.rstrip("/") + "/chat/completions"
    body = {"model": MODEL,
            "messages": [{"role": "user", "content": "Say hello in one word."}],
            "max_tokens": 300}
    req = urllib.request.Request(url, data=json.dumps(body).encode(),
        headers={"Authorization": "Bearer " + KEY, "Content-Type": "application/json"},
        method="POST")
    try:
        with urllib.request.urlopen(req, timeout=90) as r:
            d = json.loads(r.read())
            print("[1 raw] OK:", repr((d["choices"][0]["message"]["content"] or "")[:60]))
    except Exception as e:
        print("[1 raw] FAIL:", type(e).__name__, str(e)[:250])

# --- 2) langar's REAL brain path (with the reasoning fix) ---
def langar_path():
    try:
        from brain.providers import OpenAICompatBrainProvider
    except Exception as e:
        print("[2 langar] import failed (run via venv):", e)
        return
    prov = OpenAICompatBrainProvider(KEY, BASE, MODEL)
    sysp = ("تو دستیارِ خودشناسیِ LANGAR هستی. یک سؤالِ تأملیِ کوتاهِ امروز "
            "برای حوزهٔ داده‌شده بده. فقط یک سؤال، حداکثر دو خط.")
    ctx = {"domain": "body_hrv", "label": "بدن / HRV",
           "data": "خواب=4، مصرف=بله، تمرکزِ بالا"}
    try:
        ans = prov.ask(sysp, ctx)
        print("[2 langar] BRAIN ANSWER (Fugu):")
        print("   ", ans[:400])
    except Exception as e:
        print("[2 langar] FAILED:", type(e).__name__, str(e)[:300])

raw()
print()
langar_path()
print()
print("=== copy EVERYTHING above and send it to me ===")
