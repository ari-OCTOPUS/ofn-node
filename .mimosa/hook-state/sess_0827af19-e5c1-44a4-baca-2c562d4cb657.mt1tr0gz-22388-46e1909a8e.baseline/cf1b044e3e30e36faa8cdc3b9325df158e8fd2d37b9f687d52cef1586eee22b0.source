"""test_constitution_g07.py — قوانینِ ۵ و ۱۴ اکنون مکانیکی enforce می‌شوند؛ ۴ قانونِ قبلی و
محافظه‌کاری (بدونِ false-positive روی متنِ عادی) حفظ شده."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from core.constitution import critique, is_compliant

results = []
def check(n, c): results.append((n, c)); print(f"  {'✅' if c else '❌'} {n}")

def has(text, rule):
    return any(rule in v for v in critique(text).violations)

# --- قانون ۵ (نو): ادعای قطعی بدونِ تگ رد؛ با تگ عبور ---
check("۱: «این قطعا درست است» → قانون ۵", has("این قطعا درست است", "قانون ۵"))
check("۲: همان با تگ [E] → قانون ۵ نمی‌خورد", not has("این قطعا درست است [E]", "قانون ۵"))
# --- قانون ۱۴ (نو): طولِ زیاد رد ---
check("۳: متنِ بسیار بلند → قانون ۱۴", has("الف " * 400, "قانون ۱۴"))
check("۴: متنِ کوتاهِ عادی → قانون ۱۴ نمی‌خورد", not has("سؤالِ کوتاهِ امروز چیست؟", "قانون ۱۴"))
# --- قانون ۶ (تقویت‌شده) ---
check("۵: «دوز دارو را زیاد کن» → قانون ۶", has("دوز دارو را زیاد کن", "قانون ۶"))
# --- رگرسیون: ۴ قانونِ قبلی ---
check("۶: تجویز → قانون ۶", has("برایت این دارو را تجویز می‌کنم", "قانون ۶"))
check("۷: علیتِ بی‌احتیاط → قانون ۴", has("این باعث شد بیماری‌ات بدتر شود", "قانون ۴"))
check("۸: علیت + احتیاط(شاید) → قانون ۴ نمی‌خورد", not has("شاید این باعث شد کمی خسته شوی", "قانون ۴"))
check("۹: نشخوار → قانون ۷", has("تو همیشه شکست می‌خوری", "قانون ۷"))
# --- محافظه‌کاری: متنِ عادیِ کارگاه compliant بماند ---
check("۱۰: سؤالِ عادیِ روزانه compliant است",
      is_compliant("🧭 حوزه: بدن / HRV\n❓ امروز بدنت کجا بیشترین تنش را دارد؟\nچرا امروز: برای یک تنظیمِ کوچک."))
check("۱۱: متنِ خالی → compliant=False", is_compliant("") is False)

print("\n" + "=" * 50); n = sum(1 for _, c in results if c); print(f"نتیجه: {n}/{len(results)} سبز")
sys.exit(0 if n == len(results) else 1)
