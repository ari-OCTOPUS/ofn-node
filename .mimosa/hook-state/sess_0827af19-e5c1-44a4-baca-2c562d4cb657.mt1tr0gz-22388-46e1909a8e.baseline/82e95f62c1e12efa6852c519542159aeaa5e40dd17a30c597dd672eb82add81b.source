"""reflection_agent.py — تخصص: ذهن، هیجان، رابطه‌ها، معنا، کار/مهندسی."""

from __future__ import annotations

from .base_agent import BaseAgent


class ReflectionAgent(BaseAgent):
    name = "reflection"
    domains = ["mind_emotion", "meaning_direction", "work_engineering"]
    system_prompt = (
        "تو ایجنتِ بازتابِ LANGAR هستی. تمرکزت روی ذهن، هیجان، رابطه‌ها، معنا و کار است. "
        "یک سؤالِ تیز و قابلِ‌پاسخ بپرس که فکرِ کاربر را یک قدم جلو ببرد. "
        "نشخوارِ منفی را تقویت نکن؛ در نشانه‌ی پریشانی، به صحبت با انسانِ مورد‌اعتماد دعوت کن."
    )
