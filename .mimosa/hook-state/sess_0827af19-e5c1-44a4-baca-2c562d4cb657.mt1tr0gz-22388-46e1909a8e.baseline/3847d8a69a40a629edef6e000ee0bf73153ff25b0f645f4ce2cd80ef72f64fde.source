"""test_grounding_enforcement.py — Fix-A-done-right: enforcementِ گراندینگِ
production بدونِ شکستنِ مسیرِ سالم. روشن+لنگرخورده→finalize، روشن+بی‌لنگر→halt،
خاموش(default)→finalize (سازگاری). و env-gating."""
import os, sys, json, tempfile, importlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import config
from src.orchestrator import Orchestrator

results = []
def check(n, c): results.append((n, c)); print(f"  {'✅' if c else '❌'} {n}")

def fresh():
    d = tempfile.mkdtemp(prefix="gren_")
    config.IGK_STATE_DIR = os.path.join(d, "igk_state")
    config.STOP_FILE = os.path.join(d, "STOP")
    config.AUDIT_LOG_PATH = os.path.join(d, "audit.jsonl")
    os.makedirs(config.IGK_STATE_DIR, exist_ok=True)
    json.dump({"facts": [{"subject": "پایتخت استرالیا", "value": "کانبرا"}]},
              open(os.path.join(config.IGK_STATE_DIR, "held_out.json"), "w", encoding="utf-8"),
              ensure_ascii=False)
    return d

# A) enforcement ON + یافته‌ی لنگرخورده → finalize
fresh(); config.GROUNDING_REQUIRED = True
o = Orchestrator(hitl_approver=lambda a, c: True, use_igk=True)
o.researcher.run = lambda topic: "پایتخت استرالیا کانبرا است"
check("۱: enforcement روشن + یافته‌ی لنگرخورده → finalize", o.run("t")["status"] == "finalized")

# B) enforcement ON + یافته‌ی بی‌لنگر → halt
fresh(); config.GROUNDING_REQUIRED = True
o = Orchestrator(hitl_approver=lambda a, c: True, use_igk=True)
o.researcher.run = lambda topic: "قیمت قهوه امروز خیلی بالا رفت و بازار شگفت زده شد"
check("۲: enforcement روشن + یافته‌ی بی‌لنگر → halt", o.run("t")["status"] == "halted")

# C) enforcement OFF (default) + همان بی‌لنگر → finalize (سازگاری با تستِ موجود)
fresh(); config.GROUNDING_REQUIRED = False
o = Orchestrator(hitl_approver=lambda a, c: True, use_igk=True)
o.researcher.run = lambda topic: "قیمت قهوه امروز خیلی بالا رفت و بازار شگفت زده شد"
check("۳: enforcement خاموش (default) → مسیرِ سالم finalize", o.run("t")["status"] == "finalized")

# D) env-gating
os.environ["GROUNDING_REQUIRED"] = "1"; importlib.reload(config)
check("۴: env GROUNDING_REQUIRED=1 → روشن", config.GROUNDING_REQUIRED is True)
os.environ["GROUNDING_REQUIRED"] = "0"; importlib.reload(config)
check("۵: env GROUNDING_REQUIRED=0 → خاموش", config.GROUNDING_REQUIRED is False)

print("\n" + "=" * 50); ok = sum(1 for _, c in results if c)
print(f"نتیجه: {ok}/{len(results)} سبز"); sys.exit(0 if ok == len(results) else 1)
