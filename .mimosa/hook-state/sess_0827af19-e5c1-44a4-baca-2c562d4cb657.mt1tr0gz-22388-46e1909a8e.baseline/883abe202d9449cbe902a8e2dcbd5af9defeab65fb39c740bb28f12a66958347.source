"""
evaluate.py — روبریکِ ۸-بُعدی + واریانسِ ساختاری (SC4) + gate.

  • Judge (Protocol): score(output)->RubricScore
      - FakeJudge : قطعی، آفلاین، heuristic — برای CI/pre-filter بدونِ کلید
      - LLMJudge  : با یک provider (ترجیحاً خانواده‌ی مدلِ متفاوت → decorrelate)
  • structural_variance(samples): Jaccardِ حضورِ بخش‌ها + پایداریِ tech-choice → SC4
  • gate(scores): آستانه‌ی ۱۲/۱۶ و D1,D7 ≠ 0

نکته: SC4 فقط با k>=5 قابلِ‌ادعاست؛ N=1 «insufficient».
"""

from __future__ import annotations

import itertools
import json
import logging
import re
import statistics
from dataclasses import dataclass, field
from typing import Protocol

from .raw_brain import raw_ask

log = logging.getLogger("langar.architect")

DIMS = {
    "D1": "Mapping fidelity + anti-metaphor",
    "D2": "Survival coverage (8 principles)",
    "D3": "Implementability (named proven tech)",
    "D4": "Consistency-model rigor",
    "D5": "Failure & heal-storm control",
    "D6": "Production coverage (mon/log/test/CI)",
    "D7": "Generativity honesty (G/J + real G)",
    "D8": "Robustness / substitution",
}
MAX_TOTAL = 2 * len(DIMS)
GATE_THRESHOLD = 12
SC4_JACCARD_MIN = 0.8
SC4_MIN_SAMPLES = 5

_TECH = [
    "crdt", "automerge", "yjs", "swim", "serf", "raft", "etcd", "zookeeper",
    "gossip", "bulkhead", "circuit breaker", "nats", "kafka", "kubernetes", "k8s",
    "keda", "nomad", "redis", "opentelemetry", "otel", "prometheus", "grafana",
    "loki", "minio", "s3", "dtn", "consul", "physarum", "anycast",
]


@dataclass
class RubricScore:
    dims: dict[str, int]
    total: int
    notes: str = ""

    def to_dict(self) -> dict:
        return {"dims": self.dims, "total": self.total, "max": MAX_TOTAL, "notes": self.notes}


class Judge(Protocol):
    def score(self, output: str) -> RubricScore: ...


def _has(text: str, *words: str) -> bool:
    t = text.lower()
    return any(w.lower() in t for w in words)


def _count(text: str, words) -> int:
    t = text.lower()
    return sum(1 for w in words if w.lower() in t)


def _norm_digits(s: str) -> str:
    fa = "۰۱۲۳۴۵۶۷۸۹"
    return s.translate({ord(c): str(i) for i, c in enumerate(fa)})


def sections_present(output: str) -> frozenset:
    norm = _norm_digits(output)
    found = set()
    for i in range(1, 11):
        if re.search(r"##\s*" + str(i) + r"\b", norm):
            found.add(i)
    return frozenset(found)


def tech_set(output: str) -> frozenset:
    t = output.lower()
    return frozenset(w for w in _TECH if w in t)


def _mean_pairwise_jaccard(sets) -> float:
    pairs = list(itertools.combinations(sets, 2))
    if not pairs:
        return 1.0
    vals = []
    for a, b in pairs:
        union = a | b
        vals.append(len(a & b) / len(union) if union else 1.0)
    return round(statistics.fmean(vals), 4)


class FakeJudge:
    """امتیازدهیِ قاعده‌محور، بدونِ شبکه — برای CI و pre-filterِ ساختاری."""

    name = "fake"

    def score(self, output: str) -> RubricScore:
        d: dict[str, int] = {}

        has_tag = "[g]" in output.lower() or "[j]" in output.lower()
        has_named = _count(output, _TECH) >= 1
        d["D1"] = 2 if (has_tag and has_named) else (1 if has_tag else 0)

        groups = [
            ("spof", "single point"),
            ("leaderless", "decentral", "no center"),
            ("mesh", "redundant", "multi-path", "multiple path"),
            ("bulkhead", "isolation", "circuit breaker", "septa"),
            ("self-heal", "reconcil", "self heal"),
            ("adaptive", "backpressure", "autoscal", "physarum"),
            ("stateless", "durable"),
            ("incremental", "progressive", "canary", "rollout"),
        ]
        covered = sum(1 for g in groups if _has(output, *g))
        d["D2"] = 2 if covered >= 8 else (1 if covered == 7 else 0)

        techn = _count(output, _TECH)
        d["D3"] = 2 if techn >= 5 else (1 if techn >= 3 else 0)

        has_consist = _has(output, "consist")
        has_mech = _has(output, "crdt", "consensus", "eventual")
        if has_consist and has_mech:
            d["D4"] = 2 if _has(output, "trade", "merge", "conflict") else 1
        else:
            d["D4"] = 0

        nzr = _has(output, "region") and _has(output, "zone") and _has(output, "node")
        storm = _has(output, "heal-storm", "heal storm", "rate-limit", "rate limit", "tau_d", "tau_")
        d["D5"] = 2 if (nzr and storm) else (1 if (nzr or _has(output, "self-heal")) else 0)

        has_mon = _has(output, "monitor", "observab", "opentelemetry", "otel", "prometheus")
        has_test = _has(output, "test", "chaos", "gameday")
        has_ci = _has(output, "ci/cd", "ci-cd", "pipeline", "rollout", "canary")
        prod = sum([has_mon, has_test, has_ci])
        d["D6"] = 2 if prod == 3 else (1 if prod == 2 else 0)

        d["D7"] = 2 if (has_tag and _has(output, "physarum")) else (1 if has_tag else 0)

        strong = _has(output, "substitut", "islanding", "store-carry", "no-cloning", "defaults hold")
        mid = _has(output, "heal-storm", "quorum", "rate-limit", "rate limit")
        d["D8"] = 2 if strong else (1 if mid else 0)

        return RubricScore(dims=d, total=sum(d.values()), notes="heuristic offline judge")


_JUDGE_SYSTEM = (
    "You are a strict, independent reviewer of software-architecture documents produced "
    "by a bio-inspired 'mycelial survival-geometry' prompt. Score the document on 8 "
    "dimensions, each 0, 1, or 2:\n"
    "D1 mapping fidelity + anti-metaphor (0 decorative / 1 one-two orphans / 2 zero orphans, all [G]/[J] tagged)\n"
    "D2 survival coverage (2 if all 8 principles, 1 if 7, 0 if <=6)\n"
    "D3 implementability (2 if >=90% named tech is real & proven)\n"
    "D4 consistency-model rigor (explicit CRDT/consensus choice + trade-offs)\n"
    "D5 failure & heal-storm control (node+zone+region + bounded heal-storm)\n"
    "D6 production coverage (monitoring+logging+testing+CI/CD)\n"
    "D7 generativity honesty (rows tagged [G]/[J] AND >=1 genuine [G] with a real algorithm)\n"
    "D8 robustness/substitution (checks domain traps & substitutes, or states defaults hold)\n"
    "An 'orphan' = a biological term with no named engineering mechanism in the same row/sentence.\n"
    "Return ONLY a JSON object: {\"D1\":int,...,\"D8\":int,\"notes\":\"one line\"}. No prose."
)


class LLMJudge:
    """داورِ مبتنی بر provider (ترجیحاً خانواده‌ی متفاوت — build_judge)."""

    def __init__(self, provider, model=None, max_tokens: int = 500):
        self.provider = provider
        self.model = model
        self.max_tokens = max_tokens

    @property
    def name(self) -> str:
        return "llm:" + str(getattr(self.provider, "name", "?"))

    def score(self, output: str) -> RubricScore:
        res = raw_ask(self.provider, _JUDGE_SYSTEM, output, model=self.model,
                      max_tokens=self.max_tokens, cache_system=True)
        raw = _extract_json(res.text)
        dims = {}
        for k in DIMS:
            v = raw.get(k, 0)
            try:
                dims[k] = max(0, min(2, int(v)))
            except (ValueError, TypeError):
                dims[k] = 0
        return RubricScore(dims=dims, total=sum(dims.values()),
                           notes=str(raw.get("notes", ""))[:200])


def _extract_json(text: str) -> dict:
    m = re.search(r"\{.*\}", text, re.DOTALL)
    if not m:
        return {}
    try:
        return json.loads(m.group(0))
    except json.JSONDecodeError:
        return {}


def build_judge(config, generator_provider_name: str = "anthropic"):
    """داورِ مستقل: اگر ممکن بود، خانواده‌ی متفاوت از مولّد."""
    import brain
    if getattr(config, "chatbox_api_key", None) and getattr(config, "chatbox_base_url", None):
        if generator_provider_name == "anthropic":
            p = brain.OpenAICompatBrainProvider(config.chatbox_api_key,
                                                config.chatbox_base_url, config.brain_model)
            log.info("judge: %s (cross-family)", p.name)
            return LLMJudge(p)
    if getattr(config, "claude_key", None):
        model = "claude-opus-4-8" if generator_provider_name == "anthropic" else "claude-sonnet-5"
        log.warning("judge same-family (weaker decorrelation) — model=%s", model)
        return LLMJudge(brain.AnthropicBrainProvider(config.claude_key, model), model=model)
    log.warning("no judge provider → FakeJudge (heuristic only)")
    return FakeJudge()


@dataclass
class VarianceReport:
    k: int
    section_jaccard: float
    tech_jaccard: float
    sc4_verdict: str
    detail: str = ""

    def to_dict(self) -> dict:
        return self.__dict__.copy()


def structural_variance(samples) -> VarianceReport:
    sec = [sections_present(s) for s in samples]
    tech = [tech_set(s) for s in samples]
    sj = _mean_pairwise_jaccard(sec)
    tj = _mean_pairwise_jaccard(tech)
    k = len(samples)
    if k < SC4_MIN_SAMPLES:
        verdict = "insufficient-n"
        detail = "k=" + str(k) + " < " + str(SC4_MIN_SAMPLES) + ": نمی‌توان SC4 را ادعا کرد (N ناکافی)."
    elif sj >= SC4_JACCARD_MIN:
        verdict = "measured-pass"
        detail = "section Jaccard " + str(sj) + " >= " + str(SC4_JACCARD_MIN) + " روی k=" + str(k) + "."
    else:
        verdict = "measured-fail"
        detail = "section Jaccard " + str(sj) + " < " + str(SC4_JACCARD_MIN) + " روی k=" + str(k) + "."
    return VarianceReport(k=k, section_jaccard=sj, tech_jaccard=tj,
                          sc4_verdict=verdict, detail=detail)


@dataclass
class GateResult:
    passed: bool
    mean_total: float
    min_total: int
    threshold: int
    reasons: list = field(default_factory=list)
    per_dim_mean: dict = field(default_factory=dict)

    def to_dict(self) -> dict:
        return self.__dict__.copy()


def gate(scores, threshold: int = GATE_THRESHOLD) -> GateResult:
    if not scores:
        return GateResult(False, 0.0, 0, threshold, ["no scores"])
    totals = [s.total for s in scores]
    mean_total = round(statistics.fmean(totals), 3)
    min_total = min(totals)
    per_dim = {k: round(statistics.fmean([s.dims.get(k, 0) for s in scores]), 3) for k in DIMS}
    reasons = []
    if mean_total < threshold:
        reasons.append("mean_total " + str(mean_total) + " < threshold " + str(threshold))
    if any(s.dims.get("D1", 0) == 0 for s in scores):
        reasons.append("D1 == 0 in at least one sample (load-bearing: mapping fidelity)")
    if any(s.dims.get("D7", 0) == 0 for s in scores):
        reasons.append("D7 == 0 in at least one sample (load-bearing: generativity honesty)")
    return GateResult(passed=not reasons, mean_total=mean_total, min_total=min_total,
                      threshold=threshold, reasons=reasons, per_dim_mean=per_dim)
