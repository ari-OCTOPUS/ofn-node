# -*- coding: utf-8 -*-
"""تست‌های milestone: M1 fail-closed · M2 EffectorGate · M3 safe-degrade · M8 stress-gate."""
import os, sys, tempfile, shutil, importlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import config

results=[]
def check(n,c): results.append((n,bool(c))); print(f"  {'✅' if c else '❌'} {n}")

# ---------- M1 ----------
def t_m1():
    import importlib, src.orchestrator as O, igk.client as C
    importlib.reload(O)
    orig=C.KernelClient
    class Boom:
        def __init__(self,*a,**k): raise RuntimeError("kernel down (test)")
    C.KernelClient=Boom
    try:
        config.IGK_REQUIRED=True
        o=O.Orchestrator(hitl_approver=lambda a,c:True, use_igk=True)
        r=o.run("هر موضوع")
        check("M1: کرنلِ خراب + IGK_REQUIRED → halt (fail-closed، نه finalize)",
              r["status"]=="halted" and r.get("interrupted") is True)
    finally:
        C.KernelClient=orig

# ---------- M2 ----------
def t_m2():
    from igk.client import KernelClient, ActuationGate, PermitDenied
    from src.tools import ToolGateway
    d=tempfile.mkdtemp(); shutil.copy("igk/held_out.json", os.path.join(d,"held_out.json"))
    k=KernelClient(d); open(os.path.join(d,"STOP"),"w").close()   # STOP → fail-closed
    gw=ToolGateway(gate=ActuationGate(k,"researcher"))
    denied=False
    try: gw.call("researcher","web_search_mock",query="x")
    except PermitDenied: denied=True
    k.close()
    check("M2: با STOP، ابزار از EffectorGate رد می‌شود (fail-closed)", denied)

# ---------- M3 ----------
def t_m3():
    import importlib, src.llm as L
    config.SAFE_DEGRADE=True; importlib.reload(L)
    res=L.LLMClient()._mock("Researcher","x")
    check("M3: mock برچسبِ [DEGRADED] + degraded=True دارد",
          res.degraded is True and res.text.startswith("[DEGRADED]"))

# ---------- M8 ----------
def t_m8():
    import importlib, src.prompt_store as PS, self_update as SU
    config.STRESS_GATED_PROMOTION=True
    d=tempfile.mkdtemp(); config.PROMPTS_PATH=os.path.join(d,"p.json")
    importlib.reload(PS); importlib.reload(SU)
    SU.run("researcher", stress_ok=False)
    masked_ok = PS.PromptStore().active_version("researcher")==1
    d2=tempfile.mkdtemp(); config.PROMPTS_PATH=os.path.join(d2,"p2.json")
    importlib.reload(PS); importlib.reload(SU)
    SU.run("researcher", stress_ok=True)
    promoted = PS.PromptStore().active_version("researcher")>1
    check("M8: بدون استرس masked می‌ماند · با استرس promote می‌شود", masked_ok and promoted)
    config.STRESS_GATED_PROMOTION=False

for f in (t_m1,t_m2,t_m3,t_m8):
    try: f()
    except Exception:
        import traceback; traceback.print_exc(); results.append((f.__name__,False))

ok=sum(1 for _,c in results if c)
print(f"\nنتیجه: {ok}/{len(results)} سبز")
sys.exit(0 if ok==len(results) else 1)
