"""
providers.py — چک‌لیست #۵: تنوعِ provider (پرهیز از تک‌نقطه‌ی تصمیم).

یک رجیستری از backendها برمی‌گرداند. پنلِ داوران، داورها را به‌صورت round-robin
بین providerها پخش می‌کند تا تصمیم روی یک backend متمرکز نباشد.

- حالت LIVE: اگر کلید Anthropic باشد، provider واقعی. (افزودن OpenAI = یک ورودیِ دیگر اینجا
  و یک شاخه در llm.py — معماری آماده است.)
- حالت MOCK: چند provider مستقلِ ساختگی تا تنوعِ تصمیم قابل‌نمایش و قابل‌تست باشد.
"""
from __future__ import annotations

from src.llm import LLMClient


def make_providers(gate=None) -> list[tuple[str, LLMClient]]:
    base = LLMClient(gate=gate)
    if base.mock:
        # سه provider مستقل (هم‌اکنون همگی mock، ولی نمونه‌های جدا).
        return [("mock-A", base), ("mock-B", LLMClient(gate=gate)), ("mock-C", LLMClient(gate=gate))]
    # LIVE: فعلاً یک provider واقعی. برای تنوعِ واقعی، اینجا provider دوم را اضافه کن.
    return [("anthropic", base)]
