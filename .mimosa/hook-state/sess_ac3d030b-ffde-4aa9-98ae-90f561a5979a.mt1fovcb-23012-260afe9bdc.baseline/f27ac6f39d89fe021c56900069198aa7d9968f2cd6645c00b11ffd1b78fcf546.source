{
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(Remove-Item *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "Write(**/.git/**)",
      "Edit(**/.git/**)",
      "Write(**/_code/**)",
      "Edit(**/_code/**)",
      "Write(_Archive/**)",
      "Edit(_Archive/**)",
      "Edit(_Duplicates/**)",
      "Read(**/.env)",
      "Read(03 - Projects/Mining/Mining-1/Mining Q/monero wallet.txt)",
      "Read(03 - Projects/Lead-نقاشی/کاریابی/05_راهنمای_API_keys.md)",
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/*wallet*)",
      "Read(**/*seed*)",
      "Read(**/*key*)",
      "Read(**/*.pem)",
      "Read(**/*secret*)",
      "Read(03 - Projects/Accounting/data/**)",
      "Read(03 - Projects/Accounting/photos/**)",
      "Read(03 - Projects/Crypto - etoro/data/**)",
      "Read(03 - Projects/Crypto - etoro/photos/**)",
      "Read(03 - Projects/**/*.xlsx)",
      "Read(03 - Projects/**/*.csv)",
      "Read(**/حساب کتاب/**)",
      "Read(**/receipts/**)",
      "Read(**/Statements/**)",
      "Read(**/statements/**)",
      "Read(03 - Projects/Financial/**)",
      "Read(03 - Projects/AXON-MS/**)",
      "Read(08 - Partner (PII)/**)",
      "Read(07 - Knowledge/هیپنوتیزم  و خودآگاهی/Marathon/امواج مغزی/**)",
      "Read(07 - Knowledge/هیپنوتیزم  و خودآگاهی/Marathon/GenomeInsight Report — MyHeritage_raw_dna_data.csv.pdf)",
      "Read(07 - Knowledge/هیپنوتیزم  و خودآگاهی/فیوژن هیپنوتیزم/Neuro-HRV-Nof1/**)",
      "Read(_ops/state/OWNER-PROFILE.json)",
      "Read(**/*MyHeritage*)",
      "Read(**/*23andme*)",
      "Read(**/armin_dna*)",
      "Read(**/OWNER-PROFILE.json)",
      "Read(secrets-export/**)",
      "Write(secrets-export/**)",
      "Edit(secrets-export/**)",
      "Read(**/*-tokens.md)",
      "Read(TELEGRAM-SYSTEM-MAP/E-state-config-tokens.md)",
      "Write(_Duplicates/**)",
      "Write(agent-prompts/**)",
      "Edit(agent-prompts/**)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"F:/backup/.claude/hooks/pii_read_guard.py\"",
            "timeout": 10,
            "statusMessage": "PII/PHI read-guard"
          }
        ]
      }
    ]
  }
}
