def record_research_verdict(rid: int, verdict: str, note: str = "") -> None:
    """
    verdictِ نسخه‌بندی‌شده: تاریخچه در verdict_log تغییرناپذیر می‌ماند (append-only)،
    ولی «توصیه‌ی فعلی» در research.verdict به‌روز می‌شود. (برخلافِ insight که write-once است.)
    """
    with _conn() as conn:
        conn.execute(
            "INSERT INTO verdict_log(subject_type, subject_id, verdict, note) "
            "VALUES ('research', ?, ?, ?)", (rid, verdict, note))
        conn.execute("UPDATE research SET verdict = ? WHERE id = ?", (verdict, rid))


def verdict_history(subject_type: str, subject_id: int):
    with _conn() as conn:
        return conn.execute(
            "SELECT * FROM verdict_log WHERE subject_type = ? AND subject_id = ? ORDER BY id",
            (subject_type, subject_id)).fetchall()


