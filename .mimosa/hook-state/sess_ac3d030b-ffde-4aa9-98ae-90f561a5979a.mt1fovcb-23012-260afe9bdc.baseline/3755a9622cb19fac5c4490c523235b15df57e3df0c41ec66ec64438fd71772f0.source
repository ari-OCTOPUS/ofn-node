def record_ai_usage(model, in_tokens, out_tokens, cost, command="", provider="") -> None:
    with _conn() as conn:
        conn.execute(
            "INSERT INTO ai_usage(command, provider, model, input_tokens, output_tokens, "
            "estimated_cost_usd) VALUES (?, ?, ?, ?, ?, ?)",
            (command, provider, model, in_tokens, out_tokens, cost))


def ai_usage_sum(since_date: str) -> float:
    with _conn() as conn:
        row = conn.execute(
            "SELECT COALESCE(SUM(estimated_cost_usd), 0) s FROM ai_usage "
            "WHERE substr(ts,1,10) >= ?", (since_date,)).fetchone()
    return float(row["s"] or 0.0)


