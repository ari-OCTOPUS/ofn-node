def save_improvement_report(metrics: dict, suggestions: list, status: str = "pending") -> int:
    import json
    with _conn() as conn:
        cur = conn.execute(
            "INSERT INTO improvement_report(metrics_json, suggestions_json, status) "
            "VALUES (?, ?, ?)",
            (json.dumps(metrics, ensure_ascii=False),
             json.dumps(suggestions, ensure_ascii=False), status))
        return cur.lastrowid


def list_improvement_reports(status=None):
    with _conn() as conn:
        if status:
            return conn.execute("SELECT * FROM improvement_report WHERE status = ? ORDER BY id DESC",
                                (status,)).fetchall()
        return conn.execute("SELECT * FROM improvement_report ORDER BY id DESC").fetchall()


def set_improvement_status(report_id: int, status: str) -> bool:
    with _conn() as conn:
        cur = conn.execute("UPDATE improvement_report SET status = ? WHERE id = ?",
                           (status, report_id))
        return cur.rowcount > 0


