def get_goals() -> list:
    import json
    raw = get_config("goals")
    if not raw:
        return []
    try:
        return json.loads(raw)
    except (ValueError, TypeError):
        return []


def set_goals(goals: list) -> None:
    import json
    set_config("goals", json.dumps(goals, ensure_ascii=False))


def add_goal(text: str) -> list:
    goals = get_goals()
    goals.append({"text": text, "ts": _dt.date.today().isoformat()})
    set_goals(goals)
    return goals


def get_agent_weights() -> dict:
    with _conn() as conn:
        rows = conn.execute("SELECT domain, weight FROM agent_weights").fetchall()
    return {r["domain"]: r["weight"] for r in rows}


def bump_agent_weight(domain: str, delta: float, lo: float = 0.2, hi: float = 3.0) -> float:
    with _conn() as conn:
        row = conn.execute("SELECT weight FROM agent_weights WHERE domain = ?", (domain,)).fetchone()
        cur = row["weight"] if row else 1.0
        new = max(lo, min(hi, cur + delta))
        conn.execute(
            "INSERT INTO agent_weights(domain, weight, updated_at) VALUES (?, ?, datetime('now','localtime')) "
            "ON CONFLICT(domain) DO UPDATE SET weight = excluded.weight, updated_at = excluded.updated_at",
            (domain, new))
    return new
