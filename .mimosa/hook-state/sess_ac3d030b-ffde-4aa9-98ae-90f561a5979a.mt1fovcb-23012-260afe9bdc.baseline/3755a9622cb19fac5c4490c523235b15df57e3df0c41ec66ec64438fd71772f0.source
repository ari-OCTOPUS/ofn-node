def domain_counts() -> dict:
    """شمارشِ بازتاب‌ها به‌تفکیکِ حوزه — برای چرخشِ متوازنِ سؤال‌ها."""
    with _conn() as conn:
        rows = conn.execute(
            "SELECT domain, COUNT(*) c FROM reflection GROUP BY domain"
        ).fetchall()
