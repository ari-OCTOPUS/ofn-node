"""
db.py — لایه‌ی دیتابیس SQLite برای بات LANGAR
single-user · بدون hash-chain · verdict یک‌بارنویس (write-once)
schema با migrations.py نسخه‌بندی و به‌روزرسانی می‌شود (افزایشی، غیرمخرب).
"""

import datetime as _dt
import os
import sqlite3
import statistics
from contextlib import contextmanager
from pathlib import Path

import migrations

# مسیر دیتابیس: پیش‌فرض کنارِ همین فایل، یا قابلِ تنظیم با متغیرِ LANGAR_DB
# (روی سرور بهتر است یک مسیرِ ثابتِ مستقل از پوشه‌ی کد بدهی تا با آپدیتِ کد گم نشود)
DB_PATH = Path(os.environ.get("LANGAR_DB", Path(__file__).resolve().parent / "langar.db"))


class AlreadyJudged(Exception):
    """تلاش برای داوریِ دوباره روی بینشی که قبلاً داوری شده (verdict برگشت‌ناپذیر)."""

    def __init__(self, current: str):
        self.current = current
        super().__init__(f"already judged: {current}")


SCHEMA = """
CREATE TABLE IF NOT EXISTS log (
    id    INTEGER PRIMARY KEY AUTOINCREMENT,
    ts    TEXT    NOT NULL DEFAULT (datetime('now', 'localtime')),
    rmssd REAL,
    sleep INTEGER,   -- 1..5
    used  INTEGER,   -- 0 = نه / 1 = بله
    loc   TEXT,      -- home / work / other
    note  TEXT
);

CREATE TABLE IF NOT EXISTS insight (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    ts      TEXT    NOT NULL DEFAULT (datetime('now', 'localtime')),
    content TEXT,
    tag     TEXT,   -- E / S / P
    recheck TEXT,   -- YYYY-MM-DD
    verdict TEXT    DEFAULT 'pending'  -- pending / confirmed / refuted
);

CREATE TABLE IF NOT EXISTS reflection (
    id       INTEGER PRIMARY KEY AUTOINCREMENT,
    ts       TEXT    NOT NULL DEFAULT (datetime('now', 'localtime')),
    domain   TEXT,   -- body / mind / relations / work / meaning / habits / free
    question TEXT,   -- سؤالِ مغز (اگر آزاد بود، خالی)
    answer   TEXT    -- پاسخِ کاربر
);

CREATE TABLE IF NOT EXISTS config (
    key TEXT PRIMARY KEY,
    val TEXT
);

INSERT OR IGNORE INTO config(key, val) VALUES ('halted', '0');
"""


@contextmanager
def _conn():
    """یک connection با row factory و commit/rollback خودکار."""
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def init_db() -> None:
    """ساخت جدول‌ها + اجرای migrationها. idempotent است."""
    with _conn() as conn:
        # WAL: نوشتن مقاوم در برابر قطعِ ناگهانی/کرش — داده‌ی ثبت‌شده گم نمی‌شود
        conn.execute("PRAGMA journal_mode = WAL;")
        conn.execute("PRAGMA synchronous = NORMAL;")
        conn.executescript(SCHEMA)
        migrations.run_migrations(conn)


def schema_version() -> str | None:
    return get_config("schema_version")


# ----------------------------------------------------------------------
# config / kill-switch
# ----------------------------------------------------------------------

def get_config(key: str, default: str | None = None) -> str | None:
    with _conn() as conn:
        row = conn.execute("SELECT val FROM config WHERE key = ?", (key,)).fetchone()
        return row["val"] if row else default


def set_config(key: str, val: str) -> None:
    with _conn() as conn:
        conn.execute(
            "INSERT INTO config(key, val) VALUES (?, ?) "
            "ON CONFLICT(key) DO UPDATE SET val = excluded.val",
            (key, val),
        )


def is_halted() -> bool:
    return get_config("halted", "0") == "1"


# ----------------------------------------------------------------------
# log
# ----------------------------------------------------------------------

def add_log(
    rmssd, sleep, used, loc, note,
    *,
    rmssd_quality=None,
    rmssd_source=None,
    measurement_duration_sec=None,
    measurement_posture=None,
) -> int:
    with _conn() as conn:
        cur = conn.execute(
            "INSERT INTO log("
            "rmssd, sleep, used, loc, note, "
            "rmssd_quality, rmssd_source, measurement_duration_sec, measurement_posture"
            ") VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (rmssd, sleep, used, loc, note,
             rmssd_quality, rmssd_source, measurement_duration_sec, measurement_posture),
        )
        return cur.lastrowid


def last_log():
    with _conn() as conn:
        return conn.execute(
            "SELECT * FROM log ORDER BY id DESC LIMIT 1"
        ).fetchone()


def recent_logs(n: int = 7):
    """آخرین n رکورد، مرتب از قدیم به جدید."""
    with _conn() as conn:
        rows = conn.execute(
            "SELECT * FROM log ORDER BY id DESC LIMIT ?", (n,)
        ).fetchall()
    return list(reversed(rows))


def logs_on(date_str: str):
    """رکوردهای log در یک روزِ مشخص (YYYY-MM-DD)."""
    with _conn() as conn:
        return conn.execute(
            "SELECT * FROM log WHERE substr(ts,1,10) = ? ORDER BY id", (date_str,)
        ).fetchall()


def log_streak() -> int:
    """تعدادِ روزهای متوالیِ ثبتِ log که به امروز (یا دیروز) ختم می‌شوند."""
    with _conn() as conn:
        rows = conn.execute(
            "SELECT DISTINCT substr(ts,1,10) d FROM log"
        ).fetchall()
    dates = {r["d"] for r in rows}
    if not dates:
        return 0
    today = _dt.date.today()
    start = today if today.isoformat() in dates else today - _dt.timedelta(days=1)
    if start.isoformat() not in dates:
        return 0
    streak = 0
    d = start
    while d.isoformat() in dates:
        streak += 1
        d -= _dt.timedelta(days=1)
    return streak


# ----------------------------------------------------------------------
# daily_state — وضعیتِ سبکِ روزانه (mood/energy/stress/…)، قابلِ ویرایش
# ----------------------------------------------------------------------

_DS_FIELDS = {
    "mood", "energy", "stress", "soreness", "exercise", "caffeine_time",
    "screen_late", "social", "deep_work_min", "meditation_min",
    "wake_time", "bedtime", "weight", "tags",
}


def upsert_daily_state(date_str: str, **fields) -> None:
    """یک ردیفِ روز را ایجاد/به‌روز می‌کند. فقط فیلدهای داده‌شده تغییر می‌کنند."""
    clean = {k: v for k, v in fields.items() if k in _DS_FIELDS and v is not None}
    with _conn() as conn:
        conn.execute("INSERT OR IGNORE INTO daily_state(date) VALUES (?)", (date_str,))
        if clean:
            sets = ", ".join(f"{k} = ?" for k in clean)
            conn.execute(
                f"UPDATE daily_state SET {sets}, "
                "updated_at = datetime('now','localtime') WHERE date = ?",
                (*clean.values(), date_str),
            )


def get_daily_state(date_str: str):
    with _conn() as conn:
        return conn.execute(
            "SELECT * FROM daily_state WHERE date = ?", (date_str,)
        ).fetchone()


def all_daily_state():
    with _conn() as conn:
        return conn.execute("SELECT * FROM daily_state ORDER BY date").fetchall()


# ----------------------------------------------------------------------
# insight
# ----------------------------------------------------------------------

def add_insight(content, tag, recheck) -> int:
    with _conn() as conn:
        cur = conn.execute(
            "INSERT INTO insight(content, tag, recheck) VALUES (?, ?, ?)",
            (content, tag, recheck),
        )
        return cur.lastrowid


def insights_due(date_str: str):
    """بینش‌هایی که recheck = امروز و هنوز pending هستند."""
    with _conn() as conn:
        return conn.execute(
            "SELECT * FROM insight WHERE recheck = ? AND verdict = 'pending' "
            "ORDER BY id",
            (date_str,),
        ).fetchall()


def record_verdict(insight_id: int, verdict: str) -> None:
    """
    داوریِ انسانیِ برگشت‌ناپذیر (write-once).
    اگر بینش قبلاً داوری شده باشد، AlreadyJudged پرتاب می‌شود — بازنویسی ممنوع.
    تمام بررسی و نوشتن در یک تراکنش انجام می‌شود تا race نخورد.
    """
    if verdict not in {"confirmed", "refuted"}:
        raise ValueError("verdict نامعتبر")
    with _conn() as conn:
        row = conn.execute(
            "SELECT verdict FROM insight WHERE id = ?", (insight_id,)
        ).fetchone()
        if row is None:
            raise ValueError("insight پیدا نشد")
        if row["verdict"] != "pending":
            raise AlreadyJudged(row["verdict"])
        # شرط verdict = 'pending' در خودِ UPDATE هم تکرار می‌شود (محافظِ دوم)
        conn.execute(
            "UPDATE insight SET verdict = ? WHERE id = ? AND verdict = 'pending'",
            (verdict, insight_id),
        )


def insight_stats() -> dict:
    """آمارِ بینش‌ها: شمارشِ تگ، نرخِ تأیید، overdueها."""
    today = _dt.date.today().isoformat()
    with _conn() as conn:
        rows = conn.execute("SELECT tag, verdict, recheck FROM insight").fetchall()
    stats = {
        "total": len(rows),
        "by_tag": {"E": 0, "S": 0, "P": 0},
        "confirmed": 0,
        "refuted": 0,
        "pending": 0,
        "overdue": 0,
    }
    for r in rows:
        if r["tag"] in stats["by_tag"]:
            stats["by_tag"][r["tag"]] += 1
        if r["verdict"] == "confirmed":
            stats["confirmed"] += 1
        elif r["verdict"] == "refuted":
            stats["refuted"] += 1
        else:
            stats["pending"] += 1
            if r["recheck"] and r["recheck"] < today:
                stats["overdue"] += 1
    judged = stats["confirmed"] + stats["refuted"]
    stats["confirm_rate"] = (stats["confirmed"] / judged) if judged else None
    return stats


def all_logs():
    """همه‌ی رکوردهای log برای /export."""
    with _conn() as conn:
        return conn.execute("SELECT * FROM log ORDER BY id").fetchall()


def all_insights():
    """همه‌ی بینش‌ها برای /export."""
