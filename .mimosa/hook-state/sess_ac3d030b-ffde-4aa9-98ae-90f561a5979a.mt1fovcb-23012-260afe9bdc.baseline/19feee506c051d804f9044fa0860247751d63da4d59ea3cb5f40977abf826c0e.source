"""
spine -- a minimal, offline, provable event-bus + end-to-end pipeline that
composes typed seam adapters (see gates.py) mirroring the real fusion-mvp /
AI-sume / genome-system subsystems, per the river:

    INPUT -> PERCEIVE -> ROUTE(tier) -> GATE(kill*budget*permit) ->
    BRAIN.ask -> GROUND(held-out) -> GUARD(policy*panel) ->
    RECORD(ledger append + hash-chain) -> OWNER-GATE -> OUTPUT

This is a reference skeleton: every seam is backed by a small deterministic
Fake* today (see gates.py) so the whole river is provable offline; swap any
Fake* for a real adapter later without touching pipeline.py, because the
Fakes and the eventual real adapters both only need to satisfy the same
structural Protocol (duck typing -- no inheritance required).

Nothing in this package imports or modifies any file outside itself.
"""
from __future__ import annotations

from .events import Event
from .ledger import Ledger
from .pipeline import STATUS_FINALIZED, STATUS_HALTED, Spine

