"""test_architect_budget.py — architect حالا مصرفِ واقعیِ توکن را (اختیاری) به ledger ثبت می‌کند."""
import os, sys, tempfile
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
os.environ.setdefault("LANGAR_DB", os.path.join(tempfile.mkdtemp(prefix="ab_"), "t.db"))
from architect.runner import ArchitectBrain

results = []
def check(n, c): results.append((n, c)); print(f"  {'✅' if c else '❌'} {n}")

class _Res:
    def __init__(self, text, i=120, o=800, c=0):
        self.text = text; self.input_tokens = i; self.output_tokens = o
        self.cached_input_tokens = c; self.model = "fake"; self.provider = "fake"
class FakeProvider:
    name = "fake"
    def ask_raw(self, system, user, *, model=None, max_tokens=4096, cache_system=True):
        return _Res("## 1. Summary\nنمونه")
class FakeBudget:
    def __init__(self): self.recorded = []
    def record(self, model, i, o, cmd=""): self.recorded.append((model, i, o, cmd)); return 0.0

b = FakeBudget()
ArchitectBrain(FakeProvider(), strong_model="claude-sonnet-5", budget=b).design("d", "s", "c", k=3)
check("۱: architect مصرف را به ledger ثبت کرد (command=architect)", len(b.recorded) == 1 and b.recorded[0][3] == "architect")
check("۲: با شمارشِ واقعیِ توکن (۳×۱۲۰ ورودی، ۳×۸۰۰ خروجی)", b.recorded[0][1] == 360 and b.recorded[0][2] == 2400)
check("۳: مدلِ درست (strong) ثبت شد", b.recorded[0][0] == "claude-sonnet-5")
run2 = ArchitectBrain(FakeProvider()).design("d", "s", "c", k=1)
check("۴: سازگاریِ عقب‌رو — بدونِ budget بدونِ خطا", len(run2.samples) == 1)

print("\n" + "=" * 50); n = sum(1 for _, c in results if c); print(f"نتیجه: {n}/{len(results)} سبز")
sys.exit(0 if n == len(results) else 1)
