# -*- coding: utf-8 -*-
"""
check_keys.py -- بررسی سریع وضعیت تمام API keyها
اجرا: python check_keys.py
"""
import os
import sys
import requests
from dotenv import load_dotenv

# Windows console UTF-8
if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

load_dotenv(override=True)

OK_  = "[OK] "
ERR_ = "[!!] "
NOK_ = "[--] "

def check(name: str, value: str, test_fn=None):
    if not value or value == "FREE":
        if value == "FREE":
            pass   # will be tested below
        else:
            print(f"  {NOK_}{name:<24} NOT SET")
            return False
    short = (value[:14] + "...") if len(value) > 14 else value
    if test_fn:
        try:
            ok, msg = test_fn(value)
            icon = OK_ if ok else ERR_
            print(f"  {icon}{name:<24} {msg}  ({short})")
            return ok
        except Exception as e:
            print(f"  {ERR_}{name:<24} Exception: {str(e)[:50]}")
            return False
    else:
        print(f"  {OK_}{name:<24} Set  ({short})")
        return True

# ── Testers ──────────────────────────────────────────────────────────────────

def test_anthropic(key):
    try:
        import anthropic
        client = anthropic.Anthropic(api_key=key)
        client.messages.create(
            model="claude-haiku-4-5",
            max_tokens=10,
            messages=[{"role": "user", "content": "ping"}],
        )
        return True, "LIVE - Claude ready"
    except Exception as e:
        err = str(e)
        if "401" in err or "auth" in err.lower():
            return False, "Wrong API key"
        if "credit" in err.lower() or "billing" in err.lower():
            return False, "No credits - add billing at console.anthropic.com"
        return False, err[:55]

def test_cryptoquant(key):
    r = requests.get(
        "https://api.cryptoquant.com/v1/btc/exchange-flows/netflow",
        headers={"Authorization": f"Bearer {key}"},
        params={"window": "day", "limit": 1},
        timeout=15,
    )
    return (True, "LIVE") if r.ok else (False, f"HTTP {r.status_code}")

def test_coinalyze(key):
    r = requests.get(
        "https://api.coinalyze.net/v1/open-interest-history",
        params={"symbols": "BTCUSDT_PERP.A", "interval": "daily", "api_key": key},
        timeout=15,
    )
    return (True, "LIVE") if r.ok else (False, f"HTTP {r.status_code}")

def test_lunarcrush(key):
    r = requests.get(
        "https://lunarcrush.com/api4/public/coins/btc/v1",
        headers={"Authorization": f"Bearer {key}"},
        timeout=15,
    )
    return (True, "LIVE") if r.ok else (False, f"HTTP {r.status_code}")

def test_telegram(token):
    r = requests.get(f"https://api.telegram.org/bot{token}/getMe", timeout=10)
    if r.ok:
        name = r.json().get("result", {}).get("username", "?")
        return True, f"LIVE - @{name}"
    return False, f"HTTP {r.status_code}"

def test_binance(_=None):
    r = requests.get("https://api.binance.com/api/v3/ping", timeout=10)
    return (True, "LIVE - free data") if r.ok else (False, f"HTTP {r.status_code}")

# ── Main ──────────────────────────────────────────────────────────────────────

print()
print("=" * 58)
print("  QuantumAlpha -- API Key Diagnostic")
print("=" * 58)

print("\n[FREE - no key needed]")
check("Binance",            "FREE",                       test_binance)

print("\n[AI - REQUIRED for decisions]")
check("ANTHROPIC_API_KEY",  os.getenv("ANTHROPIC_API_KEY",""), test_anthropic)

print("\n[On-chain & Derivatives - boosts alpha score]")
check("CRYPTOQUANT_API",    os.getenv("CRYPTOQUANT_API",""),   test_cryptoquant)
check("COINALYZE_API",      os.getenv("COINALYZE_API",""),     test_coinalyze)
check("LUNARCRUSH_API",     os.getenv("LUNARCRUSH_API",""),    test_lunarcrush)

print("\n[Notifications]")
check("TELEGRAM_TOKEN",     os.getenv("TELEGRAM_TOKEN",""),    test_telegram)
check("DISCORD_WEBHOOK",    os.getenv("DISCORD_WEBHOOK",""))

print("\n[Exchanges - only needed when DRY_RUN=false]")
check("BYBIT_API_KEY",      os.getenv("BYBIT_API_KEY",""))
check("OKX_API_KEY",        os.getenv("OKX_API_KEY",""))

print()
print("=" * 58)
print()
