+def admit_transplant(*, state_dir: str, contract_id: str, approve: bool,
+                     receipt_store=None) -> dict:
+    """Owner-gate leaf: record the owner's tap on an ADMITTED reproduction as the
+    generational birth (approve → TRANSPLANTED) or a decline (DENIED). This records
+    the owner's decision ONLY; it NEVER applies the patch itself — the owner performs
+    the merge by hand (merge_or_deploy FORBIDDEN, governance.py:62). Call this from
+    the RFC-card merge/deny handler, never automatically."""
+    try:
+        import c6_state_machine as _sm
+    except Exception as e:  # noqa: BLE001
+        return {"ok": False, "reason": f"import-failed:{type(e).__name__}"}
+    cur = _sm._last_state(state_dir, _sm.repro_id(contract_id))  # noqa: SLF001
+    if cur != "ADMITTED":
+        return {"ok": False, "reason": f"not transplantable from {cur!r}"}
+    to = "TRANSPLANTED" if approve else "DENIED"
+    res = _sm.transition(state_dir=state_dir, contract_id=contract_id,
+                         to_state=to, result={"verdict": "owner-tap"},
+                         receipt_store=receipt_store)
+    if res.get("ok"):
+        opslib.alert([f"c6 reproduction {to} (owner-gated): {contract_id}"])
+    return {"ok": bool(res.get("ok")), "to": to, "reason": res.get("reason")}
+
