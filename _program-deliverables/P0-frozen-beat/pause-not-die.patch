+    def _halt_reason(self) -> str | None:
+        """چرا این ضربان باید **مکث** کند (نه بمیرد)، یا None اگر آزاد است.
+        شاملِ STOP-ORGANISM و opslib.halted() (که خودش HALT-ALL/architect-STOP/
+        STOP-METABOLIC را می‌پوشاند). fail-SAFE: هر خطای خواندنِ پرچم = مکث
+        (هرگز ضربانِ کور زیرِ haltِ نامعلوم؛ هرگز مرگِ thread). فقط می‌خوانَد —
+        هیچ markerِ STOP/FREEZE اینجا نوشته یا پاک نمی‌شود."""
+        try:
+            if opslib.STOP_ORGANISM.exists():
+                return "STOP-ORGANISM"
+            r = opslib.halted()
+            if r:
+                return r
+        except Exception:  # noqa: BLE001 — خواندنِ پرچم نباید thread را بکشد؛ محتاطانه مکث
+            return "halt-check-error (fail-safe pause)"
+        return None
+
