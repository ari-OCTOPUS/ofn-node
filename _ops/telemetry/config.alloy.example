# Example Alloy receiver for Octopus shadow metrics (OTLP → backend).
# Secrets ONLY via env — never commit Authorization values.
#
#   GRAFANA_OTLP_METRICS_ENDPOINT  — set on Alloy host
#   GRAFANA_OTLP_AUTH_HEADER       — set on Alloy host (not in Python runtime)
#
# Python agents export only to http://127.0.0.1:4318/v1/metrics

otelcol.receiver.otlp "octopus" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.octopus.input]
  }
}

otelcol.processor.batch "octopus" {
  output {
    metrics = [otelcol.exporter.otlphttp.metrics_backend.input]
  }
}

otelcol.exporter.otlphttp "metrics_backend" {
  client {
    endpoint = env("GRAFANA_OTLP_METRICS_ENDPOINT")
    headers = {
      "Authorization" = env("GRAFANA_OTLP_AUTH_HEADER"),
    }
  }
}
