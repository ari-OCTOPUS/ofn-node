{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified-control.snapshot.v1",
  "type": "object",
  "required": ["schema", "created_epoch", "self_model", "directions", "cortex", "heart", "innervation", "goal_cycle", "blockers", "fully_integrated"],
  "properties": {
    "schema": {"const": "unified-control.snapshot.v1"},
    "created_epoch": {"type": "number"},
    "directions": {"type": "array", "items": {"type": "string"}},
    "self_model": {"$ref": "#/$defs/component"},
    "cortex": {"$ref": "#/$defs/component"},
    "heart": {"allOf": [{"$ref": "#/$defs/component"}], "type": "object"},
    "innervation": {"type": "object"},
    "goal_cycle": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "fully_integrated": {"type": "boolean"}
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["authority"],
      "properties": {
        "authority": {"enum": ["AUTHORITATIVE", "ADVISORY_SHADOW", "STALE", "MISSING", "BLOCKED"]},
        "age_s": {"type": ["number", "null"]},
        "data": {"type": "object"}
      }
    }
  }
}
