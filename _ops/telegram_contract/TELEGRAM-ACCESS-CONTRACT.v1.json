    },
    "legs_forum_group": {
      "bot": "outer",
      "token_env": "TG_CENTER_BOT_TOKEN",
      "poller": "telegram_center.center",
      "role": "legs-only",
      "allowed_topics": [
        "lead",
        "ziman",
        "mining",
        "crypto",
        "accounting",
        "studio_pf",
        "knowledge",
        "cartographer"
      ],
      "allowed_behavior": [
        "read_leg_status",
        "create_leg_scoped_mission",
        "request_leg_pause_resume_card",
        "record_owner_provided_leg_outcome"
      ],
      "forbidden_behavior": [
        "core_chat",
        "system_power",
        "global_approval",
        "world_discovery_chat",
        "doctor_chat",
        "budget_control",
        "flag_control",
        "cross_leg_action",
        "unknown-topic-fallback-to-core"
      ],
      "general_topic": "deny-and-redirect",
      "unknown_topic": "deny-and-redirect"
    }
  },
  "stream_targets": {
    "chat": "owner_outer_dm",
    "doctor-intent": "owner_outer_dm",
    "doctor-diff": "owner_outer_dm",
    "world-discovery": "owner_outer_dm",
    "self-goal": "owner_outer_dm",
    "action-draft": "owner_outer_dm",
    "doctor-daily": "owner_inner_dm",
    "critical-alerts": "owner_inner_dm",
    "organ-digest": "owner_inner_dm",
    "money-pulse": "owner_inner_dm",
    "approvals-organism": "owner_inner_dm",
    "lead": "legs_forum_group:lead",
    "ziman": "legs_forum_group:ziman",
    "mining": "legs_forum_group:mining",
    "crypto": "legs_forum_group:crypto",
    "accounting": "legs_forum_group:accounting",
    "studio_pf": "legs_forum_group:studio_pf",
    "knowledge": "legs_forum_group:knowledge",
    "cartographer": "legs_forum_group:cartographer"
