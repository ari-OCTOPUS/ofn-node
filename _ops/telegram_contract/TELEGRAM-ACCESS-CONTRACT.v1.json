  "safe_defaults": {
    "unknown_stream": "HOLD_AND_ALERT",
    "unknown_group_command": "DENY_AND_REDIRECT",
    "unknown_dm_intent": "CLARIFY_OR_READ_ONLY_ANSWER",
    "missing_callback_handler": "BLOCK_CARD_EMISSION",
