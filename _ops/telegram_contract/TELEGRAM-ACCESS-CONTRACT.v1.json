  "owner_model": "two-bots-three-surfaces",
  "surfaces": {
    "owner_outer_dm": {
      "bot": "outer",
      "token_env": "TG_CENTER_BOT_TOKEN",
      "poller": "telegram_center.center",
      "role": "primary-owner-interface",
      "accepts": [
        "free_chat",
        "questions",
        "missions",
        "self_goal_status",
        "world_discovery",
        "action_drafts",
        "reports",
        "owner_votes"
