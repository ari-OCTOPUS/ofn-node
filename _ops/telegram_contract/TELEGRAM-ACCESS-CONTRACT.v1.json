        "spend",
        "deploy",
        "merge",
        "restart_organism",
        "arm_flag",
        "secret_access"
      ]
    },
    "owner_inner_dm": {
      "bot": "inner",
      "token_env": "TELEGRAM_BOT_TOKEN",
      "poller": "budget.approval_channel",
      "role": "organism-status-and-approval",
      "accepts": [
        "health",
        "critical_alert",
        "organ_digest",
        "money_pulse_propose_only",
        "approval_card",
        "execution_receipt"
      ],
