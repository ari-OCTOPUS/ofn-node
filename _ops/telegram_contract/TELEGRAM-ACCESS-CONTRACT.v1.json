  "invariants": [
    "one_poller_per_token",
    "no_new_poller_for_routing",
    "group_is_legs_only",
    "outer_dm_is_primary_conversation",
    "inner_dm_is_status_and_approval",
    "unknown_group_input_cannot_reach_core",
    "every_emitted_callback_is_handled_by_emitting_bot",
    "capability_registration_does_not_grant_execution",
    "memory_is_not_authorization",
    "send_receipt_required_for_sent_claim",
    "runtime_evidence_required_for_live_claim"
