{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "octopus/action-verdict.v1",
  "title": "Action Verdict",
  "description": "حکمِ ارزیابِ مستقل روی یک عمل. عمداً جدا از رسید: رسید می‌گوید «چه شد»، حکم می‌گوید «آیا هدف را جابه‌جا کرد». EXECUTED هرگز به‌تنهایی COMPLETE نیست.",
  "type": "object",
  "required": ["schema","action_id","verdict","reason"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "action-verdict.v1"},
    "action_id": {"type": "string"},
    "prereg_id": {"type": "string"},
    "verdict": {"enum": ["COMPLETE","PARTIAL","FAILED","BLOCKED","NOT_SCORABLE"]},
    "reason": {"type": "string", "minLength": 1},
    "metric_before": {"type": ["number","null"]},
    "metric_after": {"type": ["number","null"]},
    "evidence": {"type": "array"},
    "scorable": {"type": "boolean", "description": "بدونِ metric یا falsifier ⇒ false ⇒ هرگز COMPLETE"}
  }
}
