{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "octopus/action-receipt.v1",
  "title": "Action Receipt",
  "description": "چه واقعاً شد. رسیدی که ننشیند، عملی است که اثباتش وجود ندارد — و وضعیتِ EXECUTED به FAILED پایین می‌آید.",
  "type": "object",
  "required": ["schema","action_id","idempotency_key","status","classification","started_at","finished_at","external_effects","cost"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "action-receipt.v1"},
    "action_id": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "status": {"enum": ["EXECUTED","BLOCKED","REJECTED","FAILED","NOOP","CONFLICT"]},
    "classification": {"enum": ["A0","A1","A2","A3","A4","A5","A6"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "steps_completed": {"type": "array"},
    "artifacts": {"type": "array"},
    "external_effects": {"type": "array", "maxItems": 0, "description": "در این دور همیشه خالی — ناوردیِ تست‌شده"},
    "cost": {"type": "number", "minimum": 0, "maximum": 0, "description": "در این دور همیشه صفر — ناوردیِ تست‌شده"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "rollback_available": {"type": "boolean"},
    "evidence": {"type": "array"},
    "errors": {"type": "array"}
  }
}
