{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "octopus/action-request.v1",
  "title": "Action Request",
  "description": "درخواستِ عمل. مولد می‌نویسد؛ پل قضاوت می‌کند. هیچ میدانی مجوز نیست — نه source_component، نه intent، نه هیچ متنِ آزادی.",
  "type": "object",
  "required": ["schema","action_id","prereg_id","source_component","intent","action_type","target","expected_effect","allowed_scope","external_effect","estimated_cost","rollback","falsifier"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "action-request.v1"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{4,80}$"},
    "goal_id": {"type": "string"},
    "prereg_id": {"type": "string", "minLength": 1, "description": "بدونِ پیش‌ثبتِ معتبر هیچ عملی اجرا نمی‌شود"},
    "source_component": {"type": "string", "description": "فقط برای ممیزی — صفر privilege"},
    "requested_at": {"type": "string"},
    "intent": {"type": "string", "minLength": 1, "description": "متنِ آزاد؛ ممکن است از وبِ عمومی آمده باشد. فقط می‌تواند کلاس را بالا ببرد."},
    "action_type": {"type": "string", "description": "ناشناخته ⇒ A6"},
    "target": {"type": "string"},
    "expected_effect": {"type": "string", "minLength": 1},
    "metric": {
      "type": "object",
      "required": ["path","key","baseline"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "baseline": {"type": "number"},
        "target": {"type": "object"}
      }
    },
    "allowed_scope": {"type": "array", "items": {"type": "string"}, "description": "خالی = هیچ محدوده‌ای اعلام نشده ⇒ رد (نه «همه‌جا»)"},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "external_effect": {"type": "boolean", "description": "نه-true-نه-false ⇒ اعلام‌نشده ⇒ A4"},
    "estimated_cost": {"type": "number", "minimum": 0, "description": "بزرگ‌تر از صفر ⇒ A5"},
    "privacy_class": {"type": "string"},
    "deadline": {"type": "string"},
    "rollback": {"type": "string", "minLength": 1},
    "falsifier": {"type": "string", "minLength": 1, "description": "بدونِ آن عمل اجرا می‌شود ولی هرگز COMPLETE نمی‌گیرد"},
    "evidence_required": {"type": "array", "items": {"type": "string"}},
    "payload": {"description": "محتوای artifact برای A1"}
  }
}
