{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "octopus/action-plan.v1",
  "title": "Action Plan",
  "description": "حکمِ پل. classification فقط بالا می‌رود؛ decision از جدولِ سیاست می‌آید و کلاسِ ناشناخته REJECT است.",
  "type": "object",
  "required": ["schema","action_id","classification","decision","reason"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "action-plan.v1"},
    "action_id": {"type": "string"},
    "classification": {"enum": ["A0","A1","A2","A3","A4","A5","A6"]},
    "decision": {"enum": ["ALLOW","OWNER_GATE","BLOCK","REJECT"]},
    "steps": {"type": "array"},
    "preconditions": {"type": "array"},
    "scope_receipt": {"type": "object"},
    "owner_gate": {"type": "object"},
    "rollback_plan": {"type": "object"},
    "idempotency_key": {"type": "string"},
    "expires_at": {"type": "string"},
    "reason": {"type": "string", "minLength": 1, "description": "تصمیمِ بی‌دلیل قابلِ ممیزی نیست"}
  }
}
