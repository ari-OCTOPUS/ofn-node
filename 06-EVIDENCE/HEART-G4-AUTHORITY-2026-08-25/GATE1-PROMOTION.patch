+#!/usr/bin/env python3
+"""heart/kernel.py — هستهٔ خالص: ارزیابی → حالت → period advisory → بیداری مغز.
+
+بدون network/shell/import اکتور — کاملاً تست‌پذیر. periodِ خروجی advisory است؛
+تنها منبع period زنده همچنان pulse_arbiter با anchor ثابت G4 است (اینجا فقط
+پیشنهاد و ثبت). بیداری مغز رویدادمحور است، نه هر beat.
+"""
+from __future__ import annotations
+
+import state_machine as fsm
+
+WARMUP_MIN_BEATS = 3
+BRAIN_WAKE_EVERY_N = 24          # ~40min در period ~96s
+RED_WRITE_FAILURES = 5
+JOURNAL_FAILURES = 20            # چهار برابرِ red — COMA دیرتر از SAFE
+
+
+def assess(observations: list[dict], *, current_mode: str, beat: int,
+           green_streak: int = 0, prev_wake_beat: int = -10 ** 9,
+           kill: bool = False) -> dict:
+    """ورودی: خروجی sensors.collect + وضعیت FSM. خروجی تصمیم این beat."""
+    by = {o["metric"]: o for o in observations}
+    halted = by.get("organism.halted", {}).get("value")
+    write_fails = int(by.get("disk.write_failures_1h", {}).get("value") or 0)
+    n_missing = sum(1 for o in observations if o["quality"] == "MISSING")
+    n_stale = sum(1 for o in observations if o["quality"] == "STALE")
+    stress = by.get("vitals.stress", {}).get("value")
+    period = by.get("pulse.effective_period_s", {}).get("value")
+
+    kill_flag = bool(kill or halted)
+    journal_failure = write_fails >= JOURNAL_FAILURES
+    red = (write_fails >= RED_WRITE_FAILURES)
+    degraded_inputs = (n_missing + n_stale) >= 2
+    warmup_ready = beat >= WARMUP_MIN_BEATS and n_missing <= 1
+
+    mode, reasons = fsm.assess_transition(
+        current_mode, kill=kill_flag, journal_failure=journal_failure, red=red,
+        degraded_inputs=degraded_inputs, green_streak=green_streak,
+        warmup_ready=warmup_ready)
+
+    # بیداری مغز: تغییر حالت، استرس بالا، یا کادنس — هرگز زیر SAFE/COMA/DORMANT
+    wake_reasons: list[str] = []
+    if mode != current_mode:
+        wake_reasons.append(f"mode {current_mode}->{mode}")
+    if isinstance(stress, (int, float)) and stress >= 0.6:
+        wake_reasons.append(f"stress={stress}")
+    if (mode in ("RUNNING", "DEGRADED")
+            and (beat - prev_wake_beat) >= BRAIN_WAKE_EVERY_N):
+        wake_reasons.append(f"periodic (every {BRAIN_WAKE_EVERY_N})")
+    wake_brain = bool(wake_reasons) and mode in ("RUNNING", "DEGRADED", "WARMUP")
+
+    streak = green_streak + 1 if mode in ("RUNNING",) and not degraded_inputs else 0
+    return {
+        "beat": beat, "mode": mode, "mode_prev": current_mode,
+        "reasons": reasons, "green_streak": streak,
+        "period_advisory_s": period,
+        "wake_brain": wake_brain, "wake_reasons": wake_reasons,
+        "red": red, "degraded_inputs": degraded_inputs,
+        "n_missing": n_missing, "n_stale": n_stale,
+        "write_failures_1h": write_fails,
+    }
