{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/authority-transition.v1.json",
  "title": "octopus.authority-transition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transition_id",
    "from_wave",
    "to_wave",
    "technical_readiness",
    "owner_authority",
    "dry_run",
    "rollback_plan",
    "max_actions",
    "max_duration_s",
    "forbidden_actions",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "octopus.authority-transition.v1"
    },
    "transition_id": {
      "type": "string"
    },
    "from_wave": {
      "type": "string"
    },
    "to_wave": {
      "type": "string"
    },
    "technical_readiness": {
      "type": "object",
      "required": [
        "verifier_ready",
        "ledger_ok",
        "tests_green",
        "envelope_ok",
        "checkpoint_ok",
        "rollback_ready"
      ],
      "properties": {
        "verifier_ready": {
          "type": "boolean"
        },
        "ledger_ok": {
          "type": "boolean"
        },
        "tests_green": {
          "type": "boolean"
        },
        "envelope_ok": {
          "type": "boolean"
        },
        "checkpoint_ok": {
          "type": "boolean"
        },
        "rollback_ready": {
          "type": "boolean"
        }
      }
    },
    "owner_authority": {
      "type": "object",
      "required": [
        "authorization_id",
        "signature_verified",
        "scope_match",
        "not_expired"
      ],
      "properties": {
        "authorization_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature_verified": {
          "type": "boolean"
        },
        "scope_match": {
          "type": "boolean"
        },
        "not_expired": {
          "type": "boolean"
        }
      }
    },
    "dry_run": {
      "type": "boolean"
    },
    "rollback_plan": {
      "type": "string"
    },
    "max_actions": {
      "type": "integer"
    },
    "max_duration_s": {
      "type": "integer"
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "KEEP_WAVE0_LOCKED",
        "READY_FOR_OWNER_REVIEW",
        "READY_FOR_BOUNDED_TRANSITION",
        "TRANSITION_COMPLETED",
        "ROLLED_BACK",
        "STOPPED_SAFE",
        "DENIED"
      ]
    }
  }
}
