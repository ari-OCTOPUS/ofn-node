2026-09-03T05:58:59Z
[Unit]
Description=OCTOPUS backup
After=network-online.target

[Service]
Type=oneshot
User=ari
EnvironmentFile=/home/ari/.config/ofn/secrets.env
Environment=OCTOPUS_WIRE_LEAD_OUTBOUND=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/ari/ofn/ofn/agents
ExecStart=bash /home/ari/ofn/tools/backup_ofn.sh && python3 /home/ari/ofn/ofn/agents/rotate_logs.py
