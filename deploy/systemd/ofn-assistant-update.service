# /etc/systemd/system/ofn-assistant-update.service
[Unit]
Description=OFN daily Saba assistant RAG refresh
Documentation=file:///home/ari/ofn/README.md
Wants=network-online.target
After=network-online.target ofn-backup.service

[Service]
Type=oneshot
User=ari
Group=ari
WorkingDirectory=/home/ari/ofn
EnvironmentFile=-/home/ari/.config/ofn/node.env
EnvironmentFile=-/home/ari/.config/ofn/secrets.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m ofn.assistant_update
TimeoutStartSec=300s
