[Unit]
StartLimitIntervalSec=0
Description=OCTOPUS event consumer: cards (EVENT-DRIVEN-OCTOPUS 2026-09-18)
After=network-online.target

[Service]
Type=oneshot
User=ari
Environment=OCTOPUS_EVENTS_ROOT=/home/ari/ofn/state/events
Environment=OCTOPUS_GATE_TRIGGER=nats:card_resolved
EnvironmentFile=-/home/ari/.config/ofn/secrets.env
ExecStart=/home/ari/ofn/tools/octopus_event_gate.sh cards /home/ari/ofn/state/events/inbox/card_resolved -- /bin/bash -c "python3 /home/ari/ofn/state/revenue-drive/revenue_state.py; python3 /home/ari/ofn/state/revenue-drive/money_executor.py; python3 /home/ari/ofn/state/revenue-drive/owner_ask.py; python3 /home/ari/ofn/state/revenue-drive/reply_runner.py"
TimeoutStartSec=900
Nice=5
