[Unit]
StartLimitIntervalSec=0
Description=OCTOPUS event consumer: send (EVENT-DRIVEN-OCTOPUS 2026-09-18)
After=network-online.target

[Service]
Type=oneshot
User=ari
Environment=OCTOPUS_EVENTS_ROOT=/home/ari/ofn/state/events
Environment=OCTOPUS_GATE_TRIGGER=events:send
EnvironmentFile=-/home/ari/.config/ofn/secrets.env
ExecStart=/home/ari/ofn/tools/octopus_event_gate.sh send /home/ari/ofn/state/events/inbox/draft_ready,/home/ari/ofn/state/events/inbox/lead_enriched -- /bin/bash -c "python3 /home/ari/ofn/state/revenue-drive/money_executor.py; python3 /home/ari/ofn/state/revenue-drive/send_queue.py; python3 /home/ari/ofn/state/revenue-drive/revenue_state.py"
TimeoutStartSec=900
Nice=5
