{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coin Hunter Bot - Tier 3 Verdict Schema",
  "description": "Strict output structure for Claude Opus orchestrator verdicts. Tier 3 outputs MUST validate against this schema.",
  "type": "object",
  "required": [
    "coin_id",
    "coin_name",
    "analysis_timestamp",
    "verdict",
    "technical_fundamentals",
    "code_quality",
    "economic_structure",
    "onchain_forensics",
    "market_microstructure",
    "community_social",
    "comparable_coins",
    "accumulation_strategy",
    "meta_feedback"
  ],
  "properties": {
    "coin_id": {
      "type": "string",
      "description": "Unique identifier from CoinGecko or chain-native"
    },
    "coin_name": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tier2_dossier_reference": {
      "type": "string",
      "description": "Path or hash of the Tier 2 dossier this verdict is built on"
    },
    "verdict": {
      "type": "object",
      "required": [
        "decision",
        "confidence",
        "summary_en",
        "summary_fa",
        "primary_reasoning_en",
        "primary_reasoning_fa"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["STRONG_ACCUMULATE", "CAUTIOUS_ACCUMULATE", "MONITOR", "REJECT"]
        },
        "confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "confidence_numeric": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary_en": {
          "type": "string",
          "maxLength": 500,
          "description": "2-3 sentence English summary"
        },
        "summary_fa": {
          "type": "string",
          "maxLength": 500,
          "description": "خلاصه ۲-۳ جمله‌ای فارسی"
        },
        "primary_reasoning_en": {
          "type": "string",
          "description": "The single most important factor driving the verdict"
        },
        "primary_reasoning_fa": {
          "type": "string"
        },
        "hard_filters_passed": {
          "type": "boolean"
        },
        "red_flags_triggered": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "technical_fundamentals": {
      "type": "object",
      "required": ["confidence", "findings"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "mining_algorithm": {"type": "string"},
        "algorithm_novelty": {"enum": ["ESTABLISHED", "VARIANT", "NOVEL"]},
        "block_time_seconds": {"type": ["number", "null"]},
        "block_reward_current": {"type": ["number", "null"]},
        "total_supply": {"type": ["number", "null"]},
        "circulating_supply": {"type": ["number", "null"]},
        "difficulty_adjustment_mechanism": {"type": ["string", "null"]},
        "network_hashrate_current": {"type": ["string", "null"]},
        "hashrate_trend_30d": {"enum": ["INCREASING", "STABLE", "DECREASING", "VOLATILE", "UNKNOWN"]},
        "quantum_resistance": {"enum": ["PRESENT", "ABSENT", "CLAIMED_UNVERIFIED", "UNKNOWN"]},
        "findings": {"type": "string"}
      }
    },
    "code_quality": {
      "type": "object",
      "required": ["confidence", "findings"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "repo_urls": {"type": "array", "items": {"type": "string"}},
        "license": {"type": ["string", "null"]},
        "total_commits": {"type": ["integer", "null"]},
        "commits_last_30d": {"type": ["integer", "null"]},
        "meaningful_contributors_count": {"type": ["integer", "null"]},
        "code_provenance": {"enum": ["ORIGINAL", "SUBSTANTIVE_FORK", "COSMETIC_FORK", "COPY_PASTE_REBRAND", "UNKNOWN"]},
        "lead_dev_assessment": {"type": "string"},
        "findings": {"type": "string"}
      }
    },
    "economic_structure": {
      "type": "object",
      "required": ["confidence", "findings"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "distribution_model": {"enum": ["FAIR_LAUNCH", "PREMINE", "ICO", "IDO", "IEO", "AIRDROP", "HYBRID", "UNKNOWN"]},
        "premine_percent_of_supply": {"type": ["number", "null"]},
        "premine_destination_wallets": {"type": "array", "items": {"type": "string"}},
        "founder_dev_allocation_percent": {"type": ["number", "null"]},
        "inflation_rate_annual": {"type": ["number", "null"]},
        "halving_or_emission_curve": {"type": ["string", "null"]},
        "stated_vs_onchain_discrepancy": {"type": ["string", "null"]},
        "findings": {"type": "string"}
      }
    },
    "onchain_forensics": {
      "type": "object",
      "required": ["confidence", "findings"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "top_10_holders_percent": {"type": ["number", "null"]},
        "top_50_holders_percent": {"type": ["number", "null"]},
        "top_100_holders_percent": {"type": ["number", "null"]},
        "concentration_trend_30d": {"enum": ["INCREASING", "STABLE", "DECREASING", "UNKNOWN"]},
        "wallet_clustering_detected": {"type": ["boolean", "null"]},
        "exchange_wallets_identified": {"type": ["integer", "null"]},
        "mining_pool_concentration_top3_percent": {"type": ["number", "null"]},
        "premine_wallet_outflow_detected": {"type": ["boolean", "null"]},
        "suspicious_patterns": {"type": "array", "items": {"type": "string"}},
        "findings": {"type": "string"}
      }
    },
    "mining_economics": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "avg_miner_daily_profit_usd_per_device": {"type": ["number", "null"]},
        "operator_daily_profit_usd_per_orange_pi": {"type": ["number", "null"]},
        "edge_zone": {
          "type": "boolean",
          "description": "TRUE if unprofitable for average miner but profitable for operator at $0.05/kWh"
        },
        "edge_zone_explanation": {"type": "string"},
        "estimated_daily_yield_full_fleet": {
          "type": "object",
          "properties": {
            "coin_amount": {"type": ["number", "null"]},
            "usd_value_at_current_price": {"type": ["number", "null"]}
          }
        }
      }
    },
    "market_microstructure": {
      "type": "object",
      "required": ["confidence", "findings"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "exchanges_listed": {"type": "array", "items": {"type": "string"}},
        "primary_pair": {"type": ["string", "null"]},
        "volume_24h_usd": {"type": ["number", "null"]},
        "volume_trend_7d": {"enum": ["INCREASING", "STABLE", "DECREASING", "VOLATILE", "UNKNOWN"]},
        "estimated_slippage_1k_usd": {"type": ["number", "null"]},
        "estimated_slippage_10k_usd": {"type": ["number", "null"]},
        "wash_trading_indicators": {"type": ["string", "null"]},
        "pump_dump_signature_detected": {"type": ["boolean", "null"]},
        "findings": {"type": "string"}
      }
    },
    "community_social": {
      "type": "object",
      "required": ["confidence", "findings"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "discord_members": {"type": ["integer", "null"]},
        "telegram_members": {"type": ["integer", "null"]},
        "twitter_followers": {"type": ["integer", "null"]},
        "topic_distribution": {
          "type": "object",
          "properties": {
            "technical_percent": {"type": ["number", "null"]},
            "mining_setup_percent": {"type": ["number", "null"]},
            "price_speculation_percent": {"type": ["number", "null"]},
            "hype_percent": {"type": ["number", "null"]}
          }
        },
        "dev_engagement_quality": {"enum": ["TECHNICAL", "MIXED", "HYPE_ONLY", "ABSENT", "UNKNOWN"]},
        "shill_detection": {"type": ["string", "null"]},
        "findings": {"type": "string"}
      }
    },
    "comparable_coins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "similarity_basis": {"type": "string"},
          "outcome": {"enum": ["ALIVE_GROWING", "ALIVE_STAGNANT", "DEAD", "PUMP_DUMP", "PIVOTED", "UNKNOWN"]},
          "key_differences": {"type": "string"},
          "base_rate_implication": {"type": "string"}
        }
      }
    },
    "accumulation_strategy": {
      "type": "object",
      "properties": {
        "position_size_percent_of_capital": {"type": ["number", "null"]},
        "kelly_inputs": {
          "type": "object",
          "properties": {
            "estimated_win_probability": {"type": ["number", "null"]},
            "estimated_payoff_multiple": {"type": ["number", "null"]},
            "kelly_fraction": {"type": ["number", "null"]},
            "fractional_kelly_applied": {"type": ["number", "null"]}
          }
        },
        "acquisition_method": {"enum": ["MINING_ONLY", "MINING_PLUS_SMALL_BUYS", "MINING_PLUS_DCA", "NOT_APPLICABLE"]},
        "time_horizon_until_reevaluation_days": {"type": ["integer", "null"]},
        "kill_switches_en": {"type": "array", "items": {"type": "string"}},
        "kill_switches_fa": {"type": "array", "items": {"type": "string"}},
        "orange_pi_allocation_count": {"type": ["integer", "null"]},
        "expected_daily_yield_at_allocation": {"type": ["string", "null"]},
        "edge_utilization_note": {"type": "string"}
      }
    },
    "meta_feedback": {
      "type": "object",
      "required": ["confidence_in_verdict", "evidence_quality"],
      "properties": {
        "confidence_in_verdict": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_quality": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "surprised_by_anything": {"type": "string"},
        "prompt_improvement_suggestion": {"type": ["string", "null"]},
        "circular_reasoning_check_passed": {"type": "boolean"},
        "counter_narratives_generated_count": {"type": "integer"}
      }
    }
  }
}
