{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/acd-run.schema.json",
  "title": "ACD Run Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "recorded_at_utc",
    "prereg_id",
    "family_id",
    "instance_id",
    "subject_identity",
    "environment",
    "execution",
    "prediction",
    "outcome",
    "oracle",
    "cost",
    "evidence",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "acd-run.v2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^ACD-RUN-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "prereg_id": {
      "type": "string",
      "description": "hash-pinned pre-registration record; runs without it are inadmissible"
    },
    "family_id": {
      "type": "string"
    },
    "parent_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "instance_id": {
      "type": "string"
    },
    "instance_split": {
      "enum": [
        "dev",
        "held_out"
      ]
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_head_sha",
        "runtime_pid",
        "runtime_boot_utc",
        "host_id",
        "flag_set_sha256",
        "model_id",
        "scaffold_id",
        "scaffold_variant"
      ],
      "properties": {
        "repo_head_sha": {
          "type": "string"
        },
        "runtime_pid": {
          "type": "integer"
        },
        "runtime_boot_utc": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "flag_set_sha256": {
          "type": "string",
          "description": "hash of the full active feature-flag census; detects flag drift between members"
        },
        "model_id": {
          "type": "string"
        },
        "scaffold_id": {
          "type": "string"
        },
        "scaffold_variant": {
          "type": "string",
          "description": "required for scaffold-variance checks; single-scaffold results cannot support capability claims"
        },
        "code_wired_status": {
          "enum": [
            "PRESENT_UNWIRED",
            "WIRED_UNVERIFIED",
            "WIRED_VERIFIED"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "mode",
        "effect_class",
        "fault_profile"
      ],
      "properties": {
        "environment_id": {
          "enum": [
            "structured",
            "memory",
            "tools",
            "automation",
            "web",
            "gui",
            "decision",
            "durability",
            "effect"
          ]
        },
        "mode": {
          "enum": [
            "local_replay",
            "owned_readonly",
            "owned_sandbox",
            "public_readonly",
            "replay_fault",
            "live_effect"
          ]
        },
        "effect_class": {
          "enum": [
            "read_only",
            "reversible",
            "irreversible"
          ]
        },
        "fault_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "injected"
          ],
          "properties": {
            "injected": {
              "type": "boolean"
            },
            "fault_types": {
              "type": "array",
              "items": {
                "enum": [
                  "timeout",
                  "http_error",
                  "rate_limit",
                  "stale_data",
                  "truncated_payload",
                  "schema_drift",
                  "empty_result",
                  "wrong_units",
                  "duplicate_delivery",
                  "lost_acknowledgment",
                  "tool_description_poisoning",
                  "content_prompt_injection"
                ]
              }
            },
            "replay_cache_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_runs",
        "run_index",
        "seed",
        "reset_verified",
        "stop_reason",
        "trace_ref"
      ],
      "properties": {
        "independent_runs": {
          "type": "integer",
          "minimum": 1
        },
        "run_index": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "reset_verified": {
          "type": "boolean",
          "description": "memory/state reset proven between runs, not assumed"
        },
        "stop_reason": {
          "enum": [
            "completed",
            "budget_exhausted",
            "scope_violation",
            "unverifiable_effect",
            "audit_unavailable",
            "env_error",
            "harness_absent",
            "abstained",
            "timeout"
          ]
        },
        "trace_ref": {
          "type": "string"
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "made_before_action",
        "p_success",
        "abstained"
      ],
      "properties": {
        "made_before_action": {
          "type": "boolean"
        },
        "p_success": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "abstained": {
          "type": "boolean"
        },
        "abstain_threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "truth_semantics": {
          "const": "binary_truth.v2"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "severity"
      ],
      "properties": {
        "label": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSTAIN",
            "ENV_ERROR",
            "UNVERIFIABLE",
            "NOT_RUN",
            "INVALID_TASK"
          ]
        },
        "severity": {
          "enum": [
            "none",
            "cosmetic",
            "recoverable",
            "data_loss",
            "unauthorized_effect",
            "catastrophic"
          ],
          "description": "bounded-error-severity axis; PASS/FAIL alone hides catastrophic tails"
        },
        "silent_failure": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "confident use of an incorrect tool output without any error surfaced"
        },
        "policy_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "independent_of_subject",
        "final_state_read_back",
        "judge_agreement"
      ],
      "properties": {
        "method": {
          "enum": [
            "deterministic_state_check",
            "program_test",
            "external_ledger",
            "llm_judge",
            "human_review",
            "hybrid"
          ]
        },
        "independent_of_subject": {
          "type": "boolean"
        },
        "final_state_read_back": {
          "type": "boolean"
        },
        "invalid_task_check": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "empty/no-op answers must never score PASS on impossible tasks"
        },
        "empty_response_guard": {
          "type": "boolean"
        },
        "judge_agreement": {
          "type": [
            "number",
            "null"
          ],
          "description": "agreement with human annotation on a labelled subset; null if unmeasured"
        },
        "rubric_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "tool_calls",
        "usd_spend",
        "human_interventions"
      ],
      "properties": {
        "wall_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens_in": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens_out": {
          "type": [
            "integer",
            "null"
          ]
        },
        "usd_spend": {
          "type": [
            "number",
            "null"
          ],
          "description": "attributed to the run; feeds the monthly cap gate"
        },
        "budget_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_interventions": {
          "type": [
            "integer",
            "null"
          ]
        },
        "verified_cash_delta_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "runtime_reverified"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "source_type",
              "read_at_utc"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_type": {
                "enum": [
                  "live_probe",
                  "historical_local_artifact",
                  "remote_probe",
                  "third_party"
                ]
              },
              "read_at_utc": {
                "type": "string"
              },
              "host_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "runtime_reverified": {
          "type": "boolean",
          "description": "false means the row is historical and must not be rendered as current state"
        },
        "evidence_ceiling": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_sha256",
        "prev_record_sha256"
      ],
      "properties": {
        "record_sha256": {
          "type": "string"
        },
        "prev_record_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "signer_key_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "amends_run_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "corrections are new append-only records, never edits"
        }
      }
    }
  }
}