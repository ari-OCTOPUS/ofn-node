[Unit]
Description=OCTOPUS evaluator (node 114) - 13-class structured evaluation, feedback-loop consumer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/octopus-worker
ExecStart=/usr/bin/python3 /opt/octopus-worker/evaluator.py
Restart=on-failure
RestartSec=10
CPUQuota=50%
MemoryMax=300M

[Install]
WantedBy=multi-user.target
