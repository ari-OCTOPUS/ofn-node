#!/bin/sh
printf "HOST=%s\n"        "$(hostname)"
printf "MODEL=%s\n"       "$(tr -d "\0" < /proc/device-tree/model)"
printf "CORES=%s\n"       "$(nproc)"
printf "MEM_MB=%s\n"      "$(awk "/MemTotal/{print int(\$2/1024)}" /proc/meminfo)"
printf "DISK_TOTAL_GB=%s\n" "$(df -BG / | awk "NR==2{gsub(/G/,\"\",\$2); print \$2}")"
printf "DISK_FREE_GB=%s\n"  "$(df -BG / | awk "NR==2{gsub(/G/,\"\",\$4); print \$4}")"
printf "KERNEL=%s\n"      "$(uname -r)"
printf "OS_CODENAME=%s\n" "$(. /etc/os-release; echo \$VERSION_CODENAME)"
printf "TEMP_C=%s\n"      "$(awk "{printf \"%.1f\", \$1/1000}" /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo NA)"
printf "MAC=%s\n"         "$(ip -o link show eth0 | awk "{print \$17}")"
printf "SD_PRESENT=%s\n"  "$(lsblk -no NAME | grep -c mmcblk1 || true)"
printf "UPTIME_S=%s\n"    "$(cut -d. -f1 /proc/uptime)"
printf "RUNNING_SERVICES=%s\n" "$(systemctl list-units --type=service --state=running --no-pager 2>/dev/null | grep -c .service)"
