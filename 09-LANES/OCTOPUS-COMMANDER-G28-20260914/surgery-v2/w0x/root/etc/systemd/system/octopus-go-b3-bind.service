[Unit]
Description=OCTOPUS GO-B3 owner-confirm binder (GO-W24; separate from money owner_reply)
[Service]
Type=oneshot
User=ari
Group=ari
EnvironmentFile=-/home/ari/.config/ofn/secrets.env
Environment=GO_B3_BIND_STATE=/home/ari/ofn/state/owner_dialogue
WorkingDirectory=/home/ari/ofn/ofn/agents
ExecStart=/usr/bin/python3 /home/ari/ofn/ofn/agents/go_b3_owner_bind.py poll
ProtectHome=read-only
ReadWritePaths=/home/ari/ofn/state/owner_dialogue /home/ari/ofn/ofn/agents
PrivateTmp=true
UMask=0077
