[Unit]
Description=OCTOPUS ops-agent (non-TCB autonomous operations; Class B witness-gated; lane AUTONOMOUS-OPS-BUNDLE-20260913)
[Service]
Type=oneshot
User=ari
Group=ari
Environment=OPS_ROOT=/home/ari/ofn/state/ops-agent
WorkingDirectory=/home/ari/ofn/state/ops-agent
ExecStart=/usr/bin/python3 /home/ari/ofn/state/ops-agent/ops_agent.py
CPUQuota=20%
MemoryMax=150M
TasksMax=15
TimeoutStartSec=120
ProtectHome=read-only
ReadWritePaths=/home/ari/ofn/state/ops-agent /home/ari/ofn/state /tmp
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
UMask=0077
