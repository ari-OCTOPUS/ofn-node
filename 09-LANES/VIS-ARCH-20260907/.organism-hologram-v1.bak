/* ================= 6. جزیره‌های سخت‌افزار ================= */
function plinth(x,z,r,h,color,glowColor){
  var g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
  var base=new THREE.Mesh(new THREE.CylinderGeometry(r,r*1.12,h,26),
    mat({color:0x11203a,shininess:70,specular:0x224466}));
  base.position.y=h/2;g.add(base);
  var rim=new THREE.Mesh(new THREE.TorusGeometry(r*1.02,0.05,8,44),
    mat({color:glowColor,emissive:glowColor,emissiveIntensity:0.8,transparent:true,opacity:0.6}));
  rim.rotation.x=Math.PI/2;rim.position.y=h*0.92;g.add(rim);
  if(color)g.add((function(){var s=glowSprite(color,r*2.6,0.22);s.position.y=h+1;return s;})());
  return g;
}

