<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="color-scheme" content="dark">
<title>🐙 ارگانیسم اختاپوس — هولوگرام زنده v1</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --cyan:#22d3ee; --purple:#a855f7; --gold:#fcd34d; --red:#ef4444; --green:#22c55e;
    --ok:#22c55e; --tele:#38bdf8; --stale:#eab308; --wire:#94a3b8; --dead:#64748b;
    --bg:#02030e; --panel:rgba(6,12,26,.72); --line:rgba(103,232,249,.16);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);
    font-family:'Vazirmatn',Tahoma,'Segoe UI',sans-serif;color:#dbeafe;
    -webkit-user-select:none;user-select:none;touch-action:none}
  #c{position:fixed;inset:0;display:block;cursor:grab}
  #c.drag{cursor:grabbing}

  /* ---------- HUD ---------- */
  .hud{position:fixed;z-index:10;pointer-events:none}
  .hud .box{pointer-events:auto}

  #title{top:14px;right:16px;text-align:right;max-width:340px}
  #title h1{font-size:17px;font-weight:900;letter-spacing:.3px;color:#e0f2fe;
    text-shadow:0 0 18px rgba(34,211,238,.45)}
  #title h1 .oct{filter:drop-shadow(0 0 8px rgba(34,211,238,.8))}
  #title p{font-size:11px;color:#7dd3fc;opacity:.85;margin-top:2px}

  #stats{top:14px;left:16px;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;padding:10px 12px;font-size:11.5px;line-height:1.9;
    direction:ltr;text-align:left;backdrop-filter:blur(8px);min-width:198px}
  #stats b{color:#67e8f9;font-weight:700}
  #stats .k{color:#7c8db5;font-size:10px}
  #stats .flash{animation:flash .5s ease-out}
  @keyframes flash{0%{color:#fff;text-shadow:0 0 12px #22d3ee}100%{}}

  #palettes{top:86px;right:16px;display:flex;flex-direction:column;gap:6px}
  .pchip{pointer-events:auto;cursor:pointer;background:var(--panel);border:1px solid rgba(103,232,249,.35);
    border-radius:10px;padding:6px 12px;font-size:12.5px;font-weight:700;font-family:inherit;color:#cffafe;
    display:flex;align-items:center;gap:7px;transition:.18s;backdrop-filter:blur(6px);
    text-shadow:0 0 10px rgba(34,211,238,.55)}
  .pchip i{width:10px;height:10px;border-radius:50%;display:inline-block;box-shadow:0 0 8px currentColor}
  .pchip:hover{transform:translateX(-3px);border-color:rgba(103,232,249,.5)}
  .pchip.on{border-color:var(--cyan);color:#fff;box-shadow:0 0 14px rgba(34,211,238,.35)}

  #modes{bottom:16px;right:50%;transform:translateX(50%);display:flex;gap:7px;flex-wrap:wrap;justify-content:center;max-width:96vw}
  .mchip{pointer-events:auto;cursor:pointer;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;padding:8px 14px;font-size:13px;font-weight:700;font-family:inherit;
    color:#cffafe;transition:.18s;backdrop-filter:blur(8px);display:flex;gap:6px;align-items:center;
    text-shadow:0 0 10px rgba(34,211,238,.4)}
  .mchip small{font-weight:400;font-size:9.5px;color:#6b7fa7}
  .mchip:hover{border-color:rgba(103,232,249,.55);color:#fff;transform:translateY(-2px)}
  .mchip.on{border-color:var(--cyan);color:#fff;background:rgba(8,47,73,.85);
    box-shadow:0 0 18px rgba(34,211,238,.4)}

  #speed{bottom:16px;right:16px;display:flex;gap:5px}
  .schip{pointer-events:auto;cursor:pointer;background:var(--panel);border:1px solid var(--line);
    border-radius:8px;padding:4px 9px;font-size:11px;color:#a5f3fc;font-family:inherit;transition:.15s}
  .schip.on,.schip:hover{border-color:var(--cyan);color:#fff}

  #legend{bottom:16px;left:16px;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;padding:8px 11px;font-size:10.5px;line-height:2;backdrop-filter:blur(6px)}
  #legend .d{display:inline-block;width:9px;height:9px;border-radius:50%;margin-left:5px;vertical-align:-1px}
  #legend .w{display:inline-block;width:9px;height:9px;margin-left:5px;vertical-align:-1px;
    background:transparent;border:1.5px solid var(--wire);border-radius:2px}

  #stage{top:64px;right:50%;transform:translateX(50%);text-align:center;opacity:0;transition:opacity .4s}
  #stage .s1{font-size:15px;font-weight:900;color:#fff;text-shadow:0 0 16px currentColor}
  #stage .s2{font-size:10.5px;color:#7dd3fc;margin-top:1px}

  #toast{bottom:74px;right:50%;transform:translateX(50%);background:rgba(69,10,10,.88);
    border:1px solid rgba(239,68,68,.6);border-radius:12px;padding:9px 18px;font-size:13px;
    font-weight:700;color:#fecaca;opacity:0;transition:opacity .3s;text-align:center}
  #toast.ok{background:rgba(6,40,23,.88);border-color:rgba(34,197,94,.55);color:#bbf7d0}

  #tip{position:fixed;z-index:20;pointer-events:none;background:rgba(4,10,22,.92);
    border:1px solid rgba(103,232,249,.35);border-radius:12px;padding:9px 12px;max-width:270px;
    font-size:11.5px;line-height:1.75;opacity:0;transition:opacity .12s;backdrop-filter:blur(8px);
    box-shadow:0 6px 30px rgba(0,0,0,.55)}
  #tip .t{font-weight:900;font-size:13px;color:#fff}
  #tip .en{color:#7dd3fc;font-size:10px;direction:ltr;text-align:right}
  #tip .st{display:inline-block;padding:0 7px;border-radius:6px;font-size:9.5px;font-weight:700;margin-top:2px}
  #tip .d{color:#bae6fd;margin-top:3px}
  #tip .x{color:#8fa3c8;font-size:10.5px;margin-top:2px}

  #hint{top:50%;right:50%;transform:translate(50%,-50%);text-align:center;font-size:13px;
    color:#a5f3fc;background:var(--panel);border:1px solid var(--line);border-radius:14px;
    padding:14px 22px;line-height:2;transition:opacity 1s;backdrop-filter:blur(6px)}

  #foot{bottom:2px;right:50%;transform:translateX(50%);font-size:9px;color:#4d5f82;white-space:nowrap}

  /* 3D labels */
  .lbl{position:fixed;z-index:5;pointer-events:none;font-size:11px;font-weight:700;color:#cfe9ff;
    text-shadow:0 0 8px rgba(2,3,14,.95);transform:translate(50%,-50%);white-space:nowrap;
    transition:opacity .35s;opacity:0}
  .lbl small{display:block;font-weight:400;font-size:9px;color:#6f86ad;text-align:center;direction:ltr}
  .lbl.node{color:#a5f3fc;font-size:12.5px}
  .lbl.island{font-size:10.5px}
  .lbl.stage{color:#fde68a;font-size:10px;background:rgba(4,10,22,.55);padding:1px 7px;border-radius:7px}
  .lbl.show{opacity:1}

  #boot{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:14px;background:var(--bg);transition:opacity .8s;font-size:15px;color:#67e8f9}
  #boot .oct{font-size:44px;animation:pulse 1.6s infinite}
  #boot .err{color:#fca5a5;font-size:13px;max-width:420px;text-align:center;line-height:2}
  @keyframes pulse{0%,100%{opacity:.55;transform:scale(1)}50%{opacity:1;transform:scale(1.12)}}
  @media (max-width:640px){
    #stats{display:none} #title p{display:none} #legend{display:none}
    .mchip{padding:6px 9px;font-size:11px} .mchip small{display:none}
  }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div class="hud" id="title">
  <h1><span class="oct">🐙</span> ارگانیسم OCTOPUS</h1>
  <p>هولوگرام زنده · چهار گره · سه قلب و یک جای خالی</p>
</div>

<div class="hud" id="stats" dir="ltr"></div>

<div class="hud" id="palettes">
  <div class="pchip on" data-pal="calm"><i style="background:#22d3ee"></i>آرام</div>
  <div class="pchip" data-pal="ignite"><i style="background:#fb923c"></i>اشتعال</div>
  <div class="pchip" data-pal="bloom"><i style="background:#e879f9"></i>شکفت</div>
  <div class="pchip" data-pal="dream"><i style="background:#818cf8"></i>خواب</div>
</div>

<div class="hud" id="modes">
  <div class="mchip on" data-mode="body">کل بدن <small>1</small></div>
  <div class="mchip" data-mode="head">سر و مغزها <small>2</small></div>
  <div class="mchip" data-mode="hearts">قلب‌ها <small>3</small></div>
  <div class="mchip" data-mode="arms">هشت بازو <small>4</small></div>
  <div class="mchip" data-mode="flow">سوار جریان شو <small>5</small></div>
  <div class="mchip" data-mode="gov">حکومت و مالک <small>6</small></div>
</div>

<div class="hud" id="speed">
  <div class="schip" data-sp="1">×1</div>
  <div class="schip" data-sp="2">×2</div>
  <div class="schip on" data-sp="4">×4</div>
  <div class="schip" data-sp="8">×8</div>
  <div class="schip" id="pause">⏸</div>
</div>

<div class="hud" id="legend">
  <div><span class="d" style="background:var(--ok)"></span> زنده — علیّت واقعی</div>
  <div><span class="d" style="background:var(--tele)"></span> تله‌متری / مشورتی</div>
  <div><span class="d" style="background:var(--stale)"></span> کهنه / دروغ صادق</div>
  <div><span class="w"></span> وایرفریم = غایب · مفهوم · خواب</div>
</div>

<div class="hud" id="stage"><div class="s1"></div><div class="s2"></div></div>
<div class="hud" id="toast"></div>
<div class="hud" id="hint">کشیدن = چرخش · اسکرول = زوم · روی هر عضو برو و کلیک کن<br>کلیدهای ۱ تا ۶ = نماها · Space = توقف</div>
<div class="hud" id="foot">اعداد = عکس‌فوریِ مستند 2026-09-07 · حرکت = شبیه‌سازی با نسبت‌های زمانی واقعی (سه قلب 42s/81s/126s)</div>

<div id="tip"></div>
<div id="boot"><div class="oct">🐙</div><div id="bootmsg">در حال بارگیری موتور سه‌بعدی…</div></div>

<script>
/* eslint-disable */
(function(){
'use strict';

/* ================= 1. boot: three.js از CDN با زنجیرهٔ جایگزین ================= */
var CDNS=[
  'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
  'https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js',
  'https://unpkg.com/three@0.128.0/build/three.min.js'
];
(function load(i){
  if(i>=CDNS.length){
    document.getElementById('bootmsg').innerHTML=
      '<span class="err">موتور سه‌بعدی بارگیری نشد.<br>اینترنت لازم است (three.js از CDN می‌آید).<br>مسیرها: cdnjs → jsdelivr → unpkg</span>';
    return;
  }
  var s=document.createElement('script');
  s.src=CDNS[i];
  s.onload=function(){ if(window.THREE){ main(); } else { load(i+1); } };
  s.onerror=function(){ load(i+1); };
  document.head.appendChild(s);
})(0);

/* ================= 2. ثابت‌های حقیقت (همه از اسناد ولت، 2026-09-07) ================= */
var DATA={
  beatBase:64582,          // ORGANISM-STATE.json
  seqBase:196462,          // audit.jsonl روی 138
  heartPeriods:[42.4,81,126], // cardiac / rhythm / control_law (HEARTS-TIME.md)
  arbiterPeriod:120,       // اجماع قلب‌ها
  wakeLatencyMin:105,      // تأخیر end-to-end
  standingGo:'3/8',        // شمارندهٔ خودضربان
  calibErr:0.25, orphans:2583, orphanHeal:8,
  budget:'A$45/ماه', runway:'67d', level:'L2',
  selves:[ // learner, earner, guardian, creator, organism
    {en:'learner', fa:'دانش‌آموز', v:0.6},
    {en:'earner',  fa:'درآمدزا',  v:0.0},
    {en:'guardian',fa:'نگهبان',   v:0.675},
    {en:'creator', fa:'خالق',     v:1.0},
    {en:'organism',fa:'ارگانیسم', v:0.585}
  ]
};
var COL={cyan:0x22d3ee,sky:0x38bdf8,purple:0xa855f7,amber:0xf59e0b,owner:0xef4444,
  gold:0xfcd34d,green:0x22c55e,stale:0x84cc16,wire:0x94a3b8,dim:0x3b4a63,ink:0x0a1220};
var PALS={
  calm:  {fog:0x02030e,heart:0x22d3ee,arm:0x38bdf8,glow:0x67e8f9,plank:0x5b6b85},
  ignite:{fog:0x0a0503,heart:0xfb923c,arm:0xf59e0b,glow:0xfdba74,plank:0x7c5a44},
  bloom: {fog:0x0b0210,heart:0xe879f9,arm:0xc084fc,glow:0xf5d0fe,plank:0x6d4a7c},
  dream: {fog:0x010208,heart:0x818cf8,arm:0x60a5fa,glow:0xa5b4fc,plank:0x44507c}
};
var STCOL={LIVE_CAUSAL:'#22c55e',LIVE_ADVISORY:'#38bdf8',LIVE_TELEMETRY:'#38bdf8',
  STALE:'#eab308',NOT_FOUND:'#64748b',CONCEPT_ONLY:'#64748b',SHADOW:'#64748b',
  BLOCKED:'#ef4444',SKELETON:'#64748b',OWNER:'#ef4444',GATE:'#fcd34d'};

/* ================= 3. main ================= */
function main(){
document.getElementById('boot').style.opacity='0';
setTimeout(function(){var b=document.getElementById('boot');if(b)b.remove();},900);

var canvas=document.getElementById('c');
var renderer=new THREE.WebGLRenderer({canvas:canvas,antialias:true});
renderer.outputEncoding=THREE.sRGBEncoding;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.18;
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
var scene=new THREE.Scene();
var camera=new THREE.PerspectiveCamera(55,1,0.1,400);

function resize(){
  var w=window.innerWidth,h=window.innerHeight;
  renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();
}
window.addEventListener('resize',resize);resize();

/* ---------- state ---------- */
var simTime=0,timeScale=4,paused=false,MODE='body',PAL='calm';
var clock=new THREE.Clock();

scene.fog=new THREE.FogExp2(PALS.calm.fog,0.008);
scene.background=new THREE.Color(PALS.calm.fog);

/* ---------- lights ---------- */
scene.add(new THREE.AmbientLight(0x8899bb,0.62));
scene.add(new THREE.HemisphereLight(0x33507a,0x0a0f1e,0.55));
var dl=new THREE.DirectionalLight(0xaabbff,0.45);dl.position.set(20,40,15);scene.add(dl);
var heartLight=new THREE.PointLight(COL.cyan,1.1,26);heartLight.position.set(0,6,0);scene.add(heartLight);
var brainLight=new THREE.PointLight(COL.amber,0.9,20);brainLight.position.set(13,6,-6);scene.add(brainLight);
var ownerLight=new THREE.PointLight(COL.owner,1.4,50);ownerLight.position.set(0,30,-14);scene.add(ownerLight);

/* ---------- helpers ---------- */
function mat(o){return new THREE.MeshPhongMaterial(Object.assign({shininess:40,transparent:true,opacity:1},o));}
function wireMat(c,op){return mat({color:c||COL.wire,wireframe:true,opacity:op==null?0.45:op});}
function glowTex(){
  var c=document.createElement('canvas');c.width=c.height=128;
  var g=c.getContext('2d');var r=g.createRadialGradient(64,64,2,64,64,64);
  r.addColorStop(0,'rgba(255,255,255,1)');r.addColorStop(.25,'rgba(255,255,255,.55)');
  r.addColorStop(.6,'rgba(255,255,255,.12)');r.addColorStop(1,'rgba(255,255,255,0)');
  g.fillStyle=r;g.fillRect(0,0,128,128);
  return new THREE.CanvasTexture(c);
}
var GLOW=glowTex();
function glowSprite(color,scale,op){
  var m=new THREE.SpriteMaterial({map:GLOW,color:color,transparent:true,
    opacity:op==null?0.65:op,depthWrite:false,blending:THREE.AdditiveBlending});
  var s=new THREE.Sprite(m);s.scale.setScalar(scale||2);return s;
}
function emojiSprite(txt,scale){
  var c=document.createElement('canvas');c.width=c.height=128;
  var g=c.getContext('2d');g.font='88px "Segoe UI Emoji","Noto Color Emoji",Arial';
  g.textAlign='center';g.textBaseline='middle';g.fillText(txt,64,70);
  var m=new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthWrite:false});
  var s=new THREE.Sprite(m);s.scale.setScalar(scale||1.4);return s;
}

/* ---------- organs registry (hover/click tooltip) ---------- */
var RAY_TARGETS=[];
var HIT_MAT=new THREE.MeshBasicMaterial({colorWrite:false,depthWrite:false});
function organ(parent,pos,r,info){
  var p=new THREE.Mesh(new THREE.SphereGeometry(r,8,8),HIT_MAT);
  if(pos)p.position.copy(pos);parent.add(p);
  p.userData.info=info;RAY_TARGETS.push(p);
  info._proxy=p;return p;
}

/* ---------- labels (HTML، فارسی) ---------- */
var LABELS=[];
function label(text,sub,cls,obj,dy){
  var el=document.createElement('div');el.className='lbl '+(cls||'');
  el.innerHTML=text+(sub?'<small>'+sub+'</small>':'');
  document.body.appendChild(el);
  LABELS.push({el:el,obj:obj,dy:dy||0});
  return LABELS.length-1;
}
var V3=new THREE.Vector3();
function updateLabels(){
  for(var i=0;i<LABELS.length;i++){
    var L=LABELS[i];
    V3.setFromMatrixPosition(L.obj.matrixWorld);V3.y+=L.dy;
    V3.project(camera);
    if(V3.z>1||V3.z<-1){L.el.classList.remove('show');continue;}
    var x=(V3.x*0.5+0.5)*window.innerWidth, y=(-V3.y*0.5+0.5)*window.innerHeight;
    if(x<-60||x>window.innerWidth+60||y<-40||y>window.innerHeight+40){L.el.classList.remove('show');continue;}
    L.el.style.left=x+'px';L.el.style.top=y+'px';
    L.el.classList.toggle('show',!!L.el.dataset.show);
  }
}
function showLabels(mode){
  for(var i=0;i<LABELS.length;i++){
    var L=LABELS[i],m=L.el.dataset.modes||'all';
    L.el.dataset.show=(m==='all'||m.indexOf(mode)>=0)?'1':'';
  }
}

/* ================= 4. زمین، ستاره‌ها، پلانکتون ================= */
var ground=new THREE.Mesh(new THREE.CircleGeometry(44,72),
  mat({color:0x0d1626,shininess:80,specular:0x24406b}));
ground.rotation.x=-Math.PI/2;ground.position.y=-0.02;scene.add(ground);
(function grid(){
  var g=new THREE.BufferGeometry(),v=[];
  for(var r=6;r<=42;r+=6){
    var n=90;for(var i=0;i<n;i++){
      var a1=i/n*Math.PI*2,a2=(i+1)/n*Math.PI*2;
      v.push(Math.cos(a1)*r,0.02,Math.sin(a1)*r,Math.cos(a2)*r,0.02,Math.sin(a2)*r);
    }
  }
  for(var s=0;s<12;s++){var a=s/12*Math.PI*2;
    v.push(Math.cos(a)*4,0.02,Math.sin(a)*4,Math.cos(a)*42,0.02,Math.sin(a)*42);}
  g.setAttribute('position',new THREE.Float32BufferAttribute(v,3));
  scene.add(new THREE.LineSegments(g,new THREE.LineBasicMaterial({color:0x1d3a5c,transparent:true,opacity:0.5})));
})();
(function stars(){
  var n=900,g=new THREE.BufferGeometry(),v=[];
  for(var i=0;i<n;i++){
    var r=95+Math.random()*60,t=Math.random()*Math.PI*2,p=Math.acos(2*Math.random()-1);
    v.push(r*Math.sin(p)*Math.cos(t),r*Math.cos(p)*0.6+15,r*Math.sin(p)*Math.sin(t));
  }
  g.setAttribute('position',new THREE.Float32BufferAttribute(v,3));
  var m=new THREE.PointsMaterial({color:0x9db8dd,size:0.55,transparent:true,opacity:0.8,sizeAttenuation:true});
  scene.add(new THREE.Points(g,m));
})();
var plankton;(function(){
  var n=240,g=new THREE.BufferGeometry(),v=[];
  for(var i=0;i<n;i++){
    var r=8+Math.random()*24,t=Math.random()*Math.PI*2;
    v.push(Math.cos(t)*r,1+Math.random()*13,Math.sin(t)*r);
  }
  g.setAttribute('position',new THREE.Float32BufferAttribute(v,3));
  plankton=new THREE.Points(g,new THREE.PointsMaterial({color:PALS.calm.plank,size:0.28,
    transparent:true,opacity:0.7,blending:THREE.AdditiveBlending,depthWrite:false}));
  scene.add(plankton);
})();

/* ================= 5. بدن اختاپوس ================= */
var body=new THREE.Group();body.position.set(0,6,0);scene.add(body);

/* 5.1 سر شیشه‌ای */
var head=new THREE.Group();head.position.set(0,2.4,0);body.add(head);
var skull=new THREE.Mesh(new THREE.SphereGeometry(3,48,32),
  mat({color:0x9adcf5,transparent:true,opacity:0.13,shininess:120,specular:0x99e9ff,
    emissive:0x0a3550,emissiveIntensity:0.25,side:THREE.DoubleSide}));
head.add(skull);
var skullRim=new THREE.Mesh(new THREE.SphereGeometry(3.02,36,24),wireMat(0x2b6f8f,0.16));
head.add(skullRim);
head.add(glowSprite(0x22d3ee,9,0.16));

/* cortex */
