    '<span class="k">GO</span> <b>'+DATA.standingGo+'</b> تا 09-14<br>'+
    '<span class="k">calib</span> <b>err '+DATA.calibErr+'</b> · يتیم <b>'+DATA.orphans.toLocaleString('en')+'</b><br>'+
    '<span class="k">'+DATA.level+'</span> · <b>'+DATA.budget+'</b> · runway <b>'+DATA.runway+'</b><br>'+
    '<span class="k">زمان</span> <b id="ts">×'+timeScale+'</b>'+(paused?' <b style="color:#fca5a5">⏸</b>':'');
}
renderStats();
var toastEl=document.getElementById('toast'),toastT=null;
function toast(msg,ok){
  toastEl.textContent=msg;toastEl.classList.toggle('ok',!!ok);toastEl.style.opacity='1';
  if(toastT)clearTimeout(toastT);
  toastT=setTimeout(function(){toastEl.style.opacity='0';},ok?3200:4600);
}
var stageEl=document.getElementById('stage');
function showStage(i){
  var S=STAGES[i];
  stageEl.querySelector('.s1').textContent='⟐ '+S.fa;
  stageEl.querySelector('.s2').textContent=S.d;
  stageEl.style.opacity=MODE==='flow'?'1':'0';
  stageEl.querySelector('.s1').style.color='#'+S.c.toString(16).padStart(6,'0');
}

/* ================= 10. دوربین و کنترل ================= */
var cam={target:new THREE.Vector3(0,6.5,0),radius:27,theta:0,phi:1.15};
var flyA=null;
function camState(){return {tx:cam.target.x,ty:cam.target.y,tz:cam.target.z,r:cam.radius,th:cam.theta,ph:cam.phi};}
function flyTo(st,dur){flyA={t0:performance.now(),dur:dur||1400,from:camState(),to:st};}
function applyCam(){
  var sp=Math.sin(cam.phi),x=cam.target.x+cam.radius*sp*Math.sin(cam.theta),
      y=cam.target.y+cam.radius*Math.cos(cam.phi),
      z=cam.target.z+cam.radius*sp*Math.cos(cam.theta);
  camera.position.set(x,y,z);camera.lookAt(cam.target);
}
var PRESETS={
  body:{tx:0,ty:6.5,tz:0,r:27,th:0,ph:1.15},
  head:{tx:0,ty:8.6,tz:0,r:8.5,th:0.5,ph:1.25},
  hearts:{tx:0,ty:5.4,tz:0,r:7.5,th:-0.4,ph:1.35},
  arms:{tx:0,ty:3,tz:0,r:58,th:0.3,ph:0.9},
  gov:{tx:0,ty:14,tz:-10,r:34,th:0.15,ph:1.25}
};
function setMode(m){
  MODE=m;
  var chips=document.querySelectorAll('.mchip');
  for(var i=0;i<chips.length;i++)chips[i].classList.toggle('on',chips[i].dataset.mode===m);
  showLabels(m);
  if(m==='flow'){
    toast('سوار بستهٔ بیدارباش شدی — دوربین دنبال نور می‌رود',true);
  } else if(PRESETS[m]){flyTo(PRESETS[m],1500);}
}
document.querySelectorAll('.mchip').forEach(function(ch){
  ch.addEventListener('click',function(){setMode(ch.dataset.mode);});
});

/* pointer */
var dragging=false,px=0,py=0,pinchD=0,pointers={};
canvas.addEventListener('pointerdown',function(e){
  pointers[e.pointerId]={x:e.clientX,y:e.clientY};
  dragging=true;px=e.clientX;py=e.clientY;flyA=null;
  canvas.classList.add('drag');canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointermove',function(e){
  if(pointers[e.pointerId])pointers[e.pointerId]={x:e.clientX,y:e.clientY};
  var ks=Object.keys(pointers);
  if(dragging&&ks.length===2){
    var a=pointers[ks[0]],b=pointers[ks[1]];
    var d=Math.hypot(a.x-b.x,a.y-b.y);
    if(pinchD>0){cam.radius=THREE.MathUtils.clamp(cam.radius*pinchD/d,4,90);}
    pinchD=d;onHover(e);return;
  }
  if(dragging&&ks.length===1){
    cam.theta-=(e.clientX-px)*0.005;
    cam.phi=THREE.MathUtils.clamp(cam.phi-(e.clientY-py)*0.005,0.15,1.52);
    px=e.clientX;py=e.clientY;
  }
  onHover(e);
});
function endP(e){delete pointers[e.pointerId];var ks=Object.keys(pointers);
  if(ks.length===0){dragging=false;canvas.classList.remove('drag');}
  pinchD=0;}
canvas.addEventListener('pointerup',endP);
canvas.addEventListener('pointercancel',endP);
canvas.addEventListener('wheel',function(e){
  e.preventDefault();
  cam.radius=THREE.MathUtils.clamp(cam.radius*(1+Math.sign(e.deltaY)*0.09),4,90);
},{passive:false});

/* hover + click + tooltip */
var ray=new THREE.Raycaster(),mouse=new THREE.Vector2(-9,-9),hoverInfo=null,pinned=null;
var tipEl=document.getElementById('tip');
function onHover(e){
  mouse.x=(e.clientX/window.innerWidth)*2-1;
  mouse.y=-(e.clientY/window.innerHeight)*2+1;
  if(!pinned)tipEl.style.left=(e.clientX+16)+'px',tipEl.style.top=(e.clientY+14)+'px';
}
function pick(){
  ray.setFromCamera(mouse,camera);
  var hits=ray.intersectObjects(RAY_TARGETS,false);
  return hits.length?hits[0].object.userData.info:null;
}
function tipFor(info){
  var c=STCOL[info.st]||'#94a3b8';
  tipEl.innerHTML='<div class="t">'+info.t+'</div><div class="en">'+info.s+'</div>'+
    '<div class="st" style="color:'+c+';border:1px solid '+c+'55;background:'+c+'18">'+info.st+'</div>'+
    '<div class="d">'+info.d+'</div>'+(info.x?'<div class="x">'+info.x+'</div>':'');
  tipEl.style.opacity='1';
}
canvas.addEventListener('click',function(e){
  mouse.x=(e.clientX/window.innerWidth)*2-1;
  mouse.y=-(e.clientY/window.innerHeight)*2+1;
  var info=pick();
  if(info){
    pinned=info;
    var wp=new THREE.Vector3();info._proxy.getWorldPosition(wp);
    flyTo({tx:wp.x,ty:wp.y,tz:wp.z,r:Math.max(5,cam.radius*0.55),th:cam.theta,ph:1.1},900);
    tipFor(info);
  } else {pinned=null;tipEl.style.opacity='0';}
});

/* palette + speed + keys */
document.querySelectorAll('.pchip').forEach(function(ch){
  ch.addEventListener('click',function(){applyPal(ch.dataset.pal);});
});
document.querySelectorAll('.schip[data-sp]').forEach(function(ch){
  ch.addEventListener('click',function(){setSpeed(parseInt(ch.dataset.sp,10));});
});
document.getElementById('pause').addEventListener('click',togglePause);
function setSpeed(v){
  timeScale=v;renderStats();
  document.querySelectorAll('.schip[data-sp]').forEach(function(c){
    c.classList.toggle('on',parseInt(c.dataset.sp,10)===v);});
}
function togglePause(){paused=!paused;renderStats();
  document.getElementById('pause').textContent=paused?'▶':'⏸';
  toast(paused?'زمان ایستاد':'زمان جریان یافت',true);}
window.addEventListener('keydown',function(e){
  var k=e.key;
  if(k>='1'&&k<='6'){setMode(['body','head','hearts','arms','flow','gov'][parseInt(k,10)-1]);}
  else if(k===' '){e.preventDefault();togglePause();}
  else if(k==='+'||k==='='){setSpeed(Math.min(8,timeScale*2));}
  else if(k==='-'){setSpeed(Math.max(1,timeScale/2));}
});

/* palette application */
var RECOLOR=[]; /* {m:material, slot:'heart'|'arm'|'glow'|'plank'} */
function applyPal(name){
  PAL=name;var p=PALS[name];
  scene.fog.color.setHex(p.fog);scene.background.setHex(p.fog);
  RECOLOR.forEach(function(r){
    if(r.slot==='heart'){r.m.color.setHex(p.heart);
      if(r.m.emissive&&r.isHeartValue)r.m.emissive.setHex(p.heart);}
    else if(r.slot==='arm'&&!r.isFixed)r.m.color.setHex(p.arm);
    else if(r.slot==='glow')r.m.color.setHex(p.glow);
    else if(r.slot==='plank')r.m.color.setHex(p.plank);
  });
  document.querySelectorAll('.pchip').forEach(function(c){
    c.classList.toggle('on',c.dataset.pal===name);});
}

/* ================= 11. حلقهٔ انیمیشن ================= */
var gateFlash=0,heartDim=1;
function animate(){
  requestAnimationFrame(animate);
  var dt=Math.min(clock.getDelta(),0.05);
  var sdt=paused?0:dt*timeScale;
  simTime+=sdt;

  /* تنفس کل بدن */
  var breath=1+0.008*Math.sin(simTime*0.35);
  body.scale.setScalar(breath);

  /* قلب‌ها — نسبت‌های واقعی 42.4/81/126 */
  for(var hI=0;hI<hearts.length;hI++){
    var H=hearts[hI];
    if(H.def.k==='cash'){
      var gp=0.5+0.5*Math.sin(simTime*0.5+H.phase);
      H.ghost.material.opacity=0.08+0.12*gp;
    }else{
      var per=DATA.heartPeriods[{value:0,body:2,mind:1}[H.def.k]];
      var ph=simTime/per*Math.PI*2+H.phase;
      var sy=Math.max(0,Math.sin(ph));
      var amp=(H.def.k==='mind'?0.10:0.17)*heartDim;
      var s=1+amp*Math.pow(sy,3);
      H.g.scale.setScalar(s);
      if(H.glow)H.glow.material.opacity=(H.def.k==='mind'?0.22:0.5)*s*heartDim;
    }
  }
  /* lease بین قلب‌های زنده */
  var li2=Math.floor(simTime/DATA.arbiterPeriod)%3;
  var lh=hearts[li2].g.position;
  lease.position.lerp(lh,0.04);
  lease.rotation.y+=dt*1.2;lease.rotation.x+=dt*0.5;
  /* حلقه‌های تنه */
  for(var rI=0;rI<rings.length;rI++){rings[rI].rotation.z+=dt*(0.12+rI*0.07)*(rI%2?-1:1);}
  /* قفل‌ها */
  locksGroup.rotation.y+=dt*0.1;
  /* قفل‌ها/چرخ سر */
  cortex.rotation.y+=dt*0.4;llama.rotation.y-=dt*0.3;
  selfGroup.rotation.y+=dt*0.12;
  skullRim.rotation.y-=dt*0.05;
  /* دود 180 */
  for(var sI=0;sI<smoke.length;sI++){
    var sm2=smoke[sI];sm2.position.y+=sdt*0.25;
    if(sm2.position.y>5.4)sm2.position.y=2.3;
    sm2.material.opacity=0.1+0.08*Math.sin(simTime+sm2.position.y);
  }
  /* پورت‌های لپ‌تاپ */
  for(var pI=0;pI<ports.length;pI++){
    var on=Math.sin(simTime*1.5+pI*1.1)>0?1:0.25;
    ports[pI].material.emissiveIntensity=on;
  }
  /* چشم 182 پلک می‌زند */
  eye.material.opacity=0.3+0.2*Math.max(0,Math.sin(simTime*0.2));
  /* پلانکتون */
  plankton.rotation.y+=dt*0.012;
  /* بلور */
  crystal.rotation.y+=dt*0.7;crystal.rotation.x+=dt*0.25;
  /* يتیم‌ها به‌آرامی به بلور مکیده می‌شوند */
  orphans.rotation.y-=sdt*0.10;orphans.rotation.x=Math.sin(simTime*0.1)*0.1;
  var op=orphans.geometry.attributes.position;
  for(var oi=0;oi<op.count;oi++){
    var ox=op.getX(oi),oz=op.getZ(oi);
    var rad=Math.hypot(ox+9.6,oz+4);
    rad=Math.max(0.5,rad-sdt*0.012);
    var ang2=Math.atan2(oz+4,ox+9.6);
    op.setX(oi,-9.6+Math.cos(ang2)*rad);
    op.setZ(oi,-4+Math.sin(ang2)*rad);
    op.setY(oi,2.7+Math.sin(simTime*0.8+oi)*1.1*Math.min(1,(rad-0.5)/2));
  }
  op.needsUpdate=true;

  /* ---- بستهٔ wake ---- */
  var p=(simTime%CYCLE)/CYCLE;
  var pos=spineCurve.getPointAt(p);
  packet.position.copy(pos);
  var stI=stageAt(p);
  if(stI!==lastStageIdx){
    lastStageIdx=stI;showStage(stI);
    if(stI===6){
      if(cycleIndex%7===6){
        gateFlash=-1;haltPulse=1;heartDim=0.45;
        toast('⏸ HALT — calibration_error ≥ 0.5 · دروازه بسته؛ سیکل بعدی پس از اصلاح');
      }else{
        gateFlash=1;
        toast('✅ ضربان بعدی ضربیده شد — mint با calib_tail',true);
      }
    }
    if(stI===0){cycleIndex++;}
  }
  var S=STAGES[stI];
  packCore.material.color.setHex(S.c);packGlow.material.color.setHex(S.c);
  packLight.color.setHex(S.c);
  /* دنباله */
  var tq=spineCurve.getPointAt(Math.max(0,p-0.012));
  trail[0].position.copy(pos);trail[0].material.color.setHex(S.c);
  for(var tI=trail.length-1;tI>0;tI--){
    trail[tI].position.lerp(trail[tI-1].position,0.55);
  }
  /* بازوها هنگام مرحلهٔ مغز جان می‌گیرند */
  var armGlow=(stI===3)?1:0.25;
  for(var aI=0;aI<arms.length;aI++){
    var A2=arms[aI];
    var shim=0.75+0.25*Math.sin(simTime*1.3+aI*1.7);
    A2.tube.material.emissiveIntensity=(A2.def.act*armGlow*0.9+0.2)*shim;
    if(A2.ico)A2.ico.material.emissiveIntensity=(A2.def.act*armGlow+0.25)*shim;
    for(var s3=0;s3<A2.suckers.length;s3++){
      A2.suckers[s3].scale.setScalar(1+0.25*Math.sin(simTime*2+s3)*A2.def.act);
    }
  }
  /* دروازه */
  if(gateFlash!==0){
    var gI=gateFlash>0?1:-1;
    gate.material.emissive.setHex(gI>0?COL.green:COL.owner);
    gate.material.emissiveIntensity=1.6;
    gateFlash+= -Math.sign(gateFlash)*dt*0.8;
    if(Math.abs(gateFlash)<0.05){gateFlash=0;gate.material.emissive.setHex(COL.gold);}
  } else {
    gate.material.emissiveIntensity=0.8+0.3*Math.sin(simTime*2);
    gate.rotation.z+=dt*0.6;
  }
  if(haltPulse>0){haltPulse-=dt*0.12;if(haltPulse<=0){heartDim=1;}}
  /* نور قلب */
  heartLight.intensity=0.9+0.4*Math.sin(simTime*0.8);

  /* HUD شمارنده‌ها */
  beatAcc+=dt;if(beatAcc>7.5){beatAcc=0;beatN++;renderStats();}
  seqAcc+=dt;if(seqAcc>seqNext){seqAcc=0;seqNext=2+Math.random()*4;seqN++;renderStats();}

  /* دوربین */
  if(MODE==='flow'&&!flyA){
    var look=pos.clone();var tan=spineCurve.getTangentAt(p);
    var cp=pos.clone().sub(tan.clone().multiplyScalar(4.5));cp.y+=2.2;
    cam.target.lerp(look,0.06);
    camera.position.lerp(cp,0.06);camera.lookAt(cam.target);
  } else if(flyA){
    var k2=Math.min(1,(performance.now()-flyA.t0)/flyA.dur);
    var e2=k2<0.5?4*k2*k2*k2:1-Math.pow(-2*k2+2,3)/2;
    var F=flyA.from,T=flyA.to;
    cam.target.set(F.tx+(T.tx-F.tx)*e2,F.ty+(T.ty-F.ty)*e2,F.tz+(T.tz-F.tz)*e2);
    cam.radius=F.r+(T.r-F.r)*e2;cam.theta=F.th+(T.th-F.th)*e2;cam.phi=F.ph+(T.ph-F.ph)*e2;
    if(k2>=1)flyA=null;
    applyCam();
  } else { applyCam(); }

  /* tooltip */
  var info=pinned||pick();
  if(info){tipFor(info);}else{tipEl.style.opacity='0';}

  updateLabels();
  renderer.render(scene,camera);
}

/* ثبت متریال‌های قابل تغییر پالت */
hearts.forEach(function(H){
  if(H.def.k!=='cash'&&H.def.k!=='mind'){
    RECOLOR.push({m:H.g.material,slot:'heart',isHeartValue:H.def.k==='value'});
    if(H.glow)RECOLOR.push({m:H.glow.material,slot:'heart'});
  }
});
arms.forEach(function(A){
  if(!A.def.wire&&A.def.act>=0.4)RECOLOR.push({m:A.tube.material,slot:'arm',isFixed:A.def.en!=='ziman'&&A.def.en!=='painting'});
});
RECOLOR.push({m:plankton.material,slot:'plank'});

showLabels('body');
setTimeout(function(){document.getElementById('hint').style.opacity='0';},6500);
animate();
}
})();
</script>
</body>
</html>
