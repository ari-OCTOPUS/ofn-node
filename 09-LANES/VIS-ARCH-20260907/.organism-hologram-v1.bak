organ(crystal,new THREE.Vector3(0,0,0),1.5,{t:'بلور تسویه — verify/settle',s:'first settles 2026-09-06',
  d:'حکم شاهد + نتیجه در یک رکورد = ستل. اولین ستل‌های تاریخِ موجود (قبلش 0 از 7550).',st:'LIVE_CAUSAL',
  x:'err 0.25 · 2156 نتیجهٔ unresolved · 2583 يتیم، شفا ۸/روز'});

/* ذرات يتیم */
var orphans;(function(){
  var n=130,g=new THREE.BufferGeometry(),v=[];
  for(var i=0;i<n;i++){
    var r=1.2+Math.random()*2.6,t=Math.random()*Math.PI*2;
    v.push(Math.cos(t)*r,2.7+(Math.random()-0.5)*2.4,-4+Math.sin(t)*r);
  }
  g.setAttribute('position',new THREE.Float32BufferAttribute(v,3));
  orphans=new THREE.Points(g,new THREE.PointsMaterial({color:0xfcd34d,size:0.16,
    transparent:true,opacity:0.75,blending:THREE.AdditiveBlending,depthWrite:false}));
  scene.add(orphans);
})();

