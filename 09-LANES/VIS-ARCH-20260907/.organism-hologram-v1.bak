var ARM_DEFS=[
  {fa:'نقاشی',en:'painting',ang:20,c:COL.amber,act:1,st:'LIVE_CAUSORY',
   d:'فعال‌ترین: imap + تایمر نقل‌قول. قیف ۶-مرحله‌ای تا پرداخت کامل.',x:'~A$104k نقل‌قول · 8 سرنخ',e:'🎨'},
  {fa:'زیمان',en:'ziman',ang:65,c:COL.cyan,act:0.5,st:'LIVE_ADVISORY',
   d:'Shopify زنده، ۴۰ محصول، بانک/ABN وصل. گلوگاه: ترافیک صفر.',x:'قفسه آماده، خیابان خالی',e:'🎁'},
  {fa:'استودیو',en:'studio/OF',ang:110,c:COL.owner,act:0,st:'BLOCKED',
   d:'تا امضای رضایت‌نامهٔ حقوقی مهندسی ممنوع.',x:'BLOCKED_LEGAL',e:'🎬'},
  {fa:'حسابداری',en:'accounting',ang:155,c:COL.green,act:0.4,st:'LIVE_TELEMETRY',
   d:'زنده اما فقط متادیتا — هیچ عدد مالی خوانده نمی‌شود.',x:'content-free',e:'🧾'},
  {fa:'ماینینگ',en:'mining',ang:200,c:0,wire:1,st:'SKELETON',
   d:'اسکلت: ۰ گره، ۰ سکه، فقط تحلیل.',x:'P0 skeleton',e:'⛏️'},
  {fa:'کریپتو',en:'crypto',ang:245,c:0,wire:1,st:'STALE',
   d:'خواب ~۶۵ روزه.',x:'eToro shadow',e:'📈'},
  {fa:'پروژه-F',en:'project-F',ang:290,c:0,wire:1,st:'NOT_FOUND',
   d:'پشت دروازه؛ محتوا آزاد نشده.',x:'gated',e:'🤐'},
  {fa:'نقشه‌کش',en:'cartographer',ang:335,c:COL.stale,act:0.15,st:'STALE',
   d:'نقشهٔ ولت را می‌کشد؛ نقشهٔ فعلی ۱۷+ روزه، 1163 فایل drift.',x:'read-only floor',e:'🗺️'}
];
var arms=[];
ARM_DEFS.forEach(function(A){
  var a=A.ang*Math.PI/180,R=23;
  var end=new THREE.Vector3(Math.cos(a)*R,0.8,Math.sin(a)*R);
  var start=new THREE.Vector3(0,-0.4,0);
  var mid=start.clone().lerp(end,0.5);mid.y=2.6+Math.sin(a)*1.2;mid.multiplyScalar(1.05);
  var curve=new THREE.QuadraticBezierCurve3(start,mid,end);
  var tubeMat=A.wire?wireMat(COL.dim,0.4)
    :mat({color:A.c,emissive:A.c,emissiveIntensity:0.5+A.act*0.7,transparent:true,opacity:0.8+A.act*0.2});
  var tube=new THREE.Mesh(new THREE.TubeGeometry(curve,60,0.17+0.13*A.act,8),tubeMat);
  body.add(tube);
  var suckers=[];
  for(var s2=2;s2<12;s2++){
    var t=s2/12;
    var su=new THREE.Mesh(new THREE.SphereGeometry(0.075+0.05*t,8,6),
      mat({color:A.wire?COL.dim:A.c,emissive:A.wire?0:A.c,emissiveIntensity:A.act*0.7}));
    su.position.copy(curve.getPoint(t));su.position.y+=0.16;body.add(su);suckers.push(su);
  }
  /* جزیرک کسب‌وکار */
  var isl=new THREE.Group();isl.position.copy(end);scene.add(isl);
  var ped=new THREE.Mesh(new THREE.CylinderGeometry(0.9,1.05,0.5,16),
    mat({color:0x101d33,emissive:A.wire?0x050a14:(A.c),emissiveIntensity:A.wire?0.45:0.35+A.act*0.45}));
  ped.position.y=0.25;isl.add(ped);
  var ico=emojiSprite(A.e,1.85);ico.position.y=1.7;isl.add(ico);
  var ic=new THREE.Mesh(new THREE.OctahedronGeometry(0.42,0),
    A.wire?wireMat(COL.dim,0.5):mat({color:A.c,emissive:A.c,emissiveIntensity:0.5+A.act*1.2,flatShading:true}));
  ic.position.y=1.7;isl.add(ic);
  if(A.act>0.3)isl.add(glowSprite(A.c,2.6,0.2+A.act*0.3));
  label(A.fa,'arm · '+A.en,'island',isl,2.6);
  organ(isl,new THREE.Vector3(0,1.2,0),1.6,{t:'بازوی '+A.fa,s:A.en,d:A.d,st:A.st==='LIVE_CAUSORY'?'LIVE_CAUSAL':A.st,x:A.x});
  arms.push({def:A,tube:tube,suckers:suckers,island:isl,curve:curve,ico:ic});
});

/* ================= 8. ستون فقرات بیدارباش (منحنی جریان) ================= */
var spinePts=[
  new THREE.Vector3(0,31,-14),      /* A مالک */
  new THREE.Vector3(-11.5,8.5,-7.2),/* B دروازه */
  new THREE.Vector3(-13,3.6,-7),    /* C 138 */
  new THREE.Vector3(-4,1.6,-3),     /* گذر */
  new THREE.Vector3(11,2.2,-4.5),   /* نزدیک 180 */
  new THREE.Vector3(13,5.2,-6),     /* E مغز */
  new THREE.Vector3(2,2.4,2.6),     /* G بازگشت */
  new THREE.Vector3(-9.6,2.7,-4)    /* H بلور */
];
var spineCurve=new THREE.CatmullRomCurve3(spinePts,true,'catmullrom',0.35);
var spineTube=new THREE.Mesh(new THREE.TubeGeometry(spineCurve,240,0.035,6,true),
  mat({color:0x22d3ee,emissive:0x22d3ee,emissiveIntensity:0.65,transparent:true,opacity:0.55}));
scene.add(spineTube);
function uOfPoint(p){
  var best=0,bd=1e9;
  for(var i=0;i<=400;i++){
    var u=i/400,q=spineCurve.getPointAt(u),d=q.distanceToSquared(p);
    if(d<bd){bd=d;best=u;}
  }
  return best;
}
var uGate=uOfPoint(spinePts[1]),u138=uOfPoint(spinePts[2]),uBrainIn=uOfPoint(spinePts[4]),
    uBrainOut=uOfPoint(spinePts[5]),uBack=uOfPoint(spinePts[6]),uCrystal=uOfPoint(spinePts[7]);
var STAGES=[
  {f:0,        t:uGate,    fa:'امضای مالک',      d:'کپسول GO قرمز از آسمان',c:COL.owner},
  {f:uGate,    t:u138,     fa:'بیدارباش',        d:'scheduler ۱۵دقیقه‌ای + بستهٔ GO',c:COL.cyan},
  {f:u138,     t:uBrainIn, fa:'انتقال به مغز',   d:'رگ بین‌بردی 138 → 180',c:COL.sky},
  {f:uBrainIn, t:uBrainOut,fa:'مغز و پیش‌نویس',  d:'llama → PROPOSAL_READY / BLOCKED_HONEST',c:COL.amber},
  {f:uBrainOut,t:uBack,    fa:'بازگشت و آینه',   d:'CONSUMED → mirror به 138',c:COL.green},
  {f:uBack,    t:uCrystal, fa:'تسویهٔ شاهد',     d:'حکم + نتیجه در یک رکورد',c:COL.gold},
  {f:uCrystal, t:1.0001,   fa:'کالیبراسیون → دروازه',d:'mint یا HALT؛ سیکل بعدی',c:COL.purple}
];
var packet=new THREE.Group();scene.add(packet);
var packCore=new THREE.Mesh(new THREE.SphereGeometry(0.3,14,10),
  mat({color:0xffffff,emissive:0xffffff,emissiveIntensity:1.4}));
packet.add(packCore);
var packGlow=glowSprite(COL.cyan,4.0,0.9);packet.add(packGlow);
var packLight=new THREE.PointLight(COL.cyan,1.5,14);packet.add(packLight);
var trail=[];for(var ti=0;ti<16;ti++){
  var tr=glowSprite(COL.cyan,1.7,0.5*(1-ti/16));scene.add(tr);trail.push(tr);
}
var CYCLE=120; /* ثانیهٔ شبیه‌سازی برای یک سیکل کامل */
var cycleIndex=0,lastStageIdx=-1,haltPulse=0;
function stageAt(p){
  for(var i=0;i<STAGES.length;i++){if(p>=STAGES[i].f&&p<STAGES[i].t)return i;}
  return STAGES.length-1;
}

/* ================= 9. HUD ================= */
var statsEl=document.getElementById('stats');
var beatN=DATA.beatBase,seqN=DATA.seqBase;
