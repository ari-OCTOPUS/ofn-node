# کپی کن به .env و مقادیر واقعی را بگذار. .env فقط key=value است.
# هیچ کدِ پایتونی، گیومه‌ی اضافی، یا کاما در .env نگذار. هرگز commit نکن.

# ── اجباری ──
BOT_TOKEN=123456:ABC-توکن-از-BotFather
OWNER_ID=123456789

# ── مغز / LLM (اختیاری؛ خالی = آفلاین) ──
BRAIN_PROVIDER=auto
CLAUDE_KEY=
OPENAI_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
BRAIN_SELF_REFLECT=false

# ── پژوهشگر / جست‌وجوی وب (اختیاری؛ خالی = آفلاین) ──
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
SERPAPI_KEY=

# ── زمان‌بندی ──
LANGAR_PING_HOUR=8

# ── منابعِ اختیاریِ WorldModel ──
# LANGAR_GIT_REPO=C:\path\to\repo

# ── مسیرهای پایدار (روی سرور توصیه می‌شود) ──
# LANGAR_DB=/home/ubuntu/langar-data/langar.db
# LANGAR_STATE=/home/ubuntu/langar-data/langar_state.pickle
