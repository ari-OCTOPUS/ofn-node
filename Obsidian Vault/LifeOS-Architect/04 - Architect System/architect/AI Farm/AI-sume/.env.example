# ============================================================================
# LANGAR Unified — .env  (کپی کن به .env کنارِ docker-compose.unified.yml)
# فقط key=value. هیچ کدِ پایتون/گیومه/کامای اضافه. هرگز commit نکن.
# هر دو سرویسِ bot و api از همین فایل می‌خوانند (env_file: .env).
# ============================================================================

# ── Telegram (اجباری) ──
BOT_TOKEN=توکنِ_بات_از_BotFather
OWNER_ID=آیدیِ_عددیِ_تلگرامِ_تو

# ── Postgres (برای api/db؛ هر سه باید با هم بخوانند) ──
POSTGRES_USER=langar
POSTGRES_PASSWORD=یک_رمزِ_قوی
POSTGRES_DB=langar
DATABASE_URL=postgresql://langar:یک_رمزِ_قوی@db:5432/langar

# ── Brain / LLM (اختیاری؛ خالی = آفلاین) ──
BRAIN_PROVIDER=auto
CLAUDE_KEY=
OPENAI_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Web search (اختیاری؛ خالی = آفلاین) ──
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
SERPAPI_KEY=

# ── AI-Lab / بودجه ──
AILAB_DAILY_BUDGET_USD=1
AILAB_MONTHLY_BUDGET_USD=30

# ── زمان‌بندی ──
LANGAR_PING_HOUR=8

# نکته: LANGAR_PRO_URL را اینجا نگذار؛ compose خودش http://api:8000 را به bot می‌دهد.
