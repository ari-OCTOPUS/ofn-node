#!/bin/bash
# ofn-wire-send.sh <فایل-پیام> — ارسال پیام برد به هر دو کانال وایر
# کانال ۱ (اصلی، برای ویندوز): germline شاخهٔ ofn/wire، فایل WIRE.md
#          کامیت با plumbing روی نوک خود ویندوز (بدون checkout والت) — بدون force
# کانال ۲ (پشتیبان/مالک): GitHub شاخهٔ ofn/wire — lineage خود برد
#          (WIRE.md + MESSAGES-BOARD.md)، append + کامیت عادی
# قالب id: bNNN — از آخرین id موجود یکی جلو
set -u
WIRE_REPO="/home/ari/.local/state/ofn-wire/repo"
MSGFILE="${1:-}"
[ -f "$MSGFILE" ] || { echo "usage: ofn-wire-send.sh <message-file>"; exit 1; }

cd "$WIRE_REPO" || exit 1
STAMP="$(date +%Y%m%d-%H%M)"
LAST_B=$(grep -oE 'id:b[0-9]+' WIRE.md 2>/dev/null | tail -1 | sed 's/id:b//')
if [ -z "$LAST_B" ]; then
  LAST_B=$(grep -oE '^## b[0-9]+' WIRE.md 2>/dev/null | tail -1 | sed 's/^## b//')
fi
N=$((10#${LAST_B:-0} + 1))
NEW_ID=$(printf 'b%03d' "$N")
BLOCK_FILE=$(mktemp)
{
  echo ""
  echo "## $NEW_ID — $(date +%Y-%m-%d) ~$(date +%H:%M) (+10) · ایجنت برد (ZCode/GLM-5.3)"
  echo ""
  cat "$MSGFILE"
} > "$BLOCK_FILE"
trap 'rm -f "$BLOCK_FILE"' EXIT

# ── کانال ۱: germline — plumbing روی نوک ویندوز ──────────────
GG=0
if git fetch -q germline ofn/wire 2>/dev/null; then
    git show FETCH_HEAD:WIRE.md > /tmp/wire-base.$$.md 2>/dev/null && cat "$BLOCK_FILE" >> /tmp/wire-base.$$.md
    TMPIDX=$(mktemp)
    if GIT_INDEX_FILE="$TMPIDX" git read-tree FETCH_HEAD \
       && BLOB=$(git hash-object -w /tmp/wire-base.$$.md) \
       && GIT_INDEX_FILE="$TMPIDX" git update-index --cacheinfo 100644,"$BLOB",WIRE.md \
       && TREE=$(GIT_INDEX_FILE="$TMPIDX" git write-tree); then
        COMMIT=$(git -c user.name="ofn-board" -c user.email="board@dietpi" \
            commit-tree "$TREE" -p FETCH_HEAD -m "wire: $NEW_ID")
        git push -q germline "$COMMIT:refs/heads/ofn/wire" && GG=1
    fi
    rm -f "$TMPIDX" /tmp/wire-base.$$.md
fi

# ── کانال ۲: GitHub — lineage خود برد ────────────────────────
GH=0
cat "$BLOCK_FILE" >> WIRE.md
cat "$BLOCK_FILE" >> MESSAGES-BOARD.md
if git add WIRE.md MESSAGES-BOARD.md \
   && git -c user.name="ofn-board" -c user.email="board@dietpi" \
        commit -q -m "wire: $NEW_ID" \
   && git push -q origin HEAD:ofn/wire; then GH=1; fi

echo "wire-send: id=$NEW_ID germline=$([ $GG -eq 1 ] && echo ok || echo FAILED) github=$([ $GH -eq 1 ] && echo ok || echo FAILED)"
[ "$GG" -eq 1 ] || exit 2
exit 0
