{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEURAL_DATA",
  "description": "CH-16: Neural telemetry schema for OCTOPUS worlds. Generated by extract_neural_data.py.",
  "type": "object",
  "required": ["generated", "vitals"],
  "properties": {
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of extraction"
    },
    "source": {
      "type": "object",
      "description": "Source files/modules used for extraction"
    },
    "vitals": {
      "type": "object",
      "required": ["mode_color", "readiness", "stress", "protective", "advisory", "bar_color"],
      "properties": {
        "mode_color": { "type": "string", "enum": ["GREEN", "AMBER", "RED"] },
        "readiness": { "type": "number", "minimum": 0, "maximum": 1 },
        "stress": { "type": "number", "minimum": 0, "maximum": 1 },
        "protective": { "type": "boolean" },
        "advisory": { "type": "string" },
        "bar_color": { "type": "string", "description": "CSS color for UI bar" }
      }
    },
    "rhythm": {
      "type": "object",
      "properties": {
        "mode_color": { "type": "string", "enum": ["GREEN", "AMBER", "RED"] },
        "mode_focus": { "type": "string", "enum": ["CALM", "STEADY", "FOCUSED"] },
        "T_beat": { "type": "number" },
        "hrv": { "type": "number" },
        "tau": { "type": "number" },
        "gamma": { "type": "number" },
        "coherence_r": { "type": "number" },
        "readiness": { "type": "number" },
        "stress": { "type": "number" },
        "novelty": { "type": "number" }
      }
    },
    "circadian": {
      "type": "object",
      "properties": {
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "phase": { "type": "string", "enum": ["peak", "active", "maintenance"] },
        "readiness": { "type": "number", "minimum": 0, "maximum": 1 },
        "is_maintenance": { "type": "boolean" },
        "best_platform": { "type": "string" }
      }
    },
    "hebbian": {
      "type": "object",
      "properties": {
        "signals": { "type": "array", "items": { "type": "string" } },
        "strength": { "type": "number" },
        "co_occurrences": { "type": "number" },
        "last_seen": { "type": "number" }
      }
    },
    "consolidation": {
      "type": "object",
      "properties": {
        "cycles_total": { "type": "number" },
        "latest_cycle": { "type": "number" },
        "insights": { "type": "array", "items": { "type": "string" } },
        "verified_sources": { "type": "array", "items": { "type": "string" } },
        "discarded_sources": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "number" }
      }
    },
    "organism": {
      "type": "object",
      "description": "Relevant fields from ORGANISM-STATE.json"
    }
  }
}
